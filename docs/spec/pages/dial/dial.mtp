; a dot on a circle, and a slider that turns it
(scene s
  (real a 0.6 (>= 0) (<= 6.28))
  (circle rim (r 1) (fill none) (stroke #'gray'))
  (circle dot (pos [(cos a) (sin a)]) (r 0.1) (fill #'crimson')))

(canvas v (x -1.3) (y -1.3) (width 2.6) (height 2.6) s)
(slider turn (move a (from 0) (to 6.28) (duration 0)) (label 'angle'))
(readout now $'{a:.2f}')
