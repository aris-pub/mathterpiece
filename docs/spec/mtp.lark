// The grammar of mtp, in Lark's notation. It is read with parser="lalr" and
// lexer="contextual". The spec renders it (the directive mtp-grammar, docs/_ext/mtp_sphinx.py),
// and tests/test_grammar.py checks it against the parser, mathterpiece/parse.py.
//
// Each section starts with a line "//: name". The spec renders each section once, in the place
// where it describes that section.

//: file
start: _BOM? _BLANK? (form _BLANK?)*

//: bom-token
_BOM: /\ufeff/

//: sequences
form: "(" _BLANK? (items | head_items)? RPAR
seq: _BLANK? items?
items: chunk (_BLANK items?)?
head_items: head_chunk (_BLANK items?)?
chunk: plain (form chunk?)?
     | paren chunk?
head_chunk: head (form chunk?)?
node: paren | plain
paren: form
     | FREE paren -> free
plain: list | word | string | doc | interpolated
     | FREE plain -> free

//: lists
list: "[" seq "]" list_index*
list_index: "[" _BLANK? node _BLANK? "]"
index: "[" _BLANK? items "]"

//: words
word: first ("|" first)* | name_string
first: NAME tail? | number | boolean | operator
tail: (index ("." PARTS)?)+
name_string: name_text ("." PARTS | list_index)*

//: heads
head: HEAD | first ("|" first)* "|" HEAD

//: literals
number: INT | RATIO | REAL | IMAG | COMPLEX
boolean: TRUE | FALSE
!operator: "+" | "-" | "*" | "/" | "^" | "<" | "<=" | ">" | ">=" | "=" | "!=" | "."

//: strings
string: STRING | TEX
doc: DOC STRING
interpolated: DOLLAR_QUOTE (TEXT | field)* QUOTE
name_text: HASH_QUOTE TEXT? field (TEXT | field)* QUOTE
field: "{" _BLANK? node _BLANK? FORMAT? "}"

//: blank-tokens
_BLANK: (/[ \t\n\r]/ | COMMENT)+
COMMENT: ";" /[^\n]/*

//: closing-token
RPAR: ")" NOT_PART
NOT_PART: /(?![.\[])/

//: name-tokens
NAME: PARTS
PARTS: PART ("." PART)*
PART: LETTER (LETTER | DIGIT | "-")* "?"?
LETTER: /[A-Za-z]/
DIGIT: /[0-9]/

//: head-token
HEAD.1: PARTS "_"

//: keyword-tokens
TRUE: "true"
FALSE: "false"

//: number-tokens
INT.2: SIGN? DIGITS
REAL.3: SIGN? ((DIGITS "." DIGITS? | "." DIGITS) EXPONENT? | DIGITS EXPONENT)
RATIO.4: SIGN? DIGITS "/" NONZERO
IMAG.5: SIGN? UREAL "i"
COMPLEX.6: SIGN? UREAL SIGN UREAL "i"
UREAL: (DIGITS "." DIGITS? | "." DIGITS | DIGITS) EXPONENT?
EXPONENT: /[eE]/ SIGN? DIGITS
NONZERO: /[0-9]*[1-9][0-9]*/
DIGITS: /[0-9]+/
SIGN: /[+-]/

//: string-tokens
STRING: "'" (/[^'\\]/ | ESCAPE)* "'"
ESCAPE: /\\['\\n]/
TEX.1: "tex'" (/[^'\\]/ | /\\[\s\S]/)* "'"

//: prefix-tokens
DOC.1: "doc@"
FREE.1: "free@"

//: interpolation-tokens
DOLLAR_QUOTE: "$'"
HASH_QUOTE: "#'"
QUOTE: "'"
TEXT: (/[^'\\{}]/ | ESCAPE | "{{" | "}}")+
FORMAT: ":" /[^{}']*/
