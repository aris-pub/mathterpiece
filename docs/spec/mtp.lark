// The reader grammar of mtp, in Lark's notation. It is read with parser="lalr" and
// lexer="contextual". The spec renders it (the directive mtp-grammar, docs/_ext/mtp_sphinx.py),
// and tests/test_grammar.py checks it against the reader, mathterpiece/parse.py.
//
// Each section starts with a line "//: name". The spec renders each section once, in the place
// where it describes that section.

//: file
start: _BLANK? (form{word} _BLANK?)*

//: sequences
form{w}: "(" seq{w} RPAR
seq{w}: _BLANK? items{w}?
items{w}: chunk{w} (_BLANK items{w}?)?
chunk{w}: plain{w} (form{w} chunk{w}?)?
        | paren{w} chunk{w}?
node{w}: paren{w} | plain{w}
paren{w}: form{w}
        | FREE paren{w} -> free
plain{w}: list{w} | w | string | doc | interpolated
        | FREE plain{w} -> free

//: lists
list{w}: "[" seq{w} "]" list_index{w}*
list_index{w}: "[" _BLANK? node{w} _BLANK? "]"
index{w}: "[" _BLANK? items{w} "]"

//: words
word: first ("|" operand)* | name_string
first: NAME tail? | number | boolean | operator
operand: OPERAND tail? | number | boolean | operator
tail: (index{word} ("." PARTS)?)+
name_string: name_text ("." PARTS | list_index{word})*

//: brace-words
bword: bfirst ("|" boperand)* | bname_string
bfirst: BNAME btail? | number | boolean | operator
boperand: BOPERAND btail? | number | boolean | operator
btail: (index{bword} ("." BPARTS)?)+
bname_string: name_text ("." BPARTS | list_index{bword})*

//: literals
number: INT | RATIO | REAL | IMAG | COMPLEX
boolean: TRUE | FALSE
!operator: "+" | "-" | "*" | "/" | "^" | "<" | "<=" | ">" | ">=" | "=" | "!=" | "."

//: strings
string: STRING | TEX
doc: DOC STRING
interpolated: DOLLAR_QUOTE (TEXT | field)* QUOTE
name_text: HASH_QUOTE TEXT? field (TEXT | field)* QUOTE
field: "{" _BLANK? node{bword} _BLANK? FORMAT? "}"

//: blank-tokens
_BLANK: (/\s/ | COMMENT)+
COMMENT: ";" /[^\n]/*

//: closing-token
RPAR: ")" NOT_PART
NOT_PART: /(?![.\[])/

//: name-tokens
NAME: NOT_TEX NOT_LONE_UNDERSCORE PARTS
OPERAND: NOT_LONE_UNDERSCORE PARTS
PARTS: PART ("." PART)*
PART: PART_START PART_CHAR* "_"? | "_"
PART_START: NOT_PART_START PART_CHAR
PART_CHAR: /[^\s()\[\]{}"|;.\/$^@#_]/
NOT_PART_START: /(?![\d+\-*<>='])/
NOT_TEX: /(?!tex')/
NOT_LONE_UNDERSCORE: /(?!_(?![.\[]))/

//: brace-name-tokens
BNAME: NOT_TEX NOT_LONE_UNDERSCORE BPARTS
BOPERAND: NOT_LONE_UNDERSCORE BPARTS
BPARTS: BPART ("." BPART)*
BPART: BPART_START BPART_CHAR* "_"? | "_"
BPART_START: NOT_PART_START BPART_CHAR
BPART_CHAR: /[^\s()\[\]{}"|;.\/$^@#_:]/

//: keyword-tokens
TRUE: "true"
FALSE: "false"

//: number-tokens
INT.2: SIGN? DIGITS
REAL.3: SIGN? ((DIGITS "." DIGITS? | "." DIGITS) EXPONENT? | DIGITS EXPONENT)
RATIO.4: SIGN? DIGITS "/" NONZERO
IMAG.5: SIGN? UREAL "i"
COMPLEX.6: SIGN? UREAL SIGN UREAL "i"
UREAL: (DIGITS "." DIGITS? | "." DIGITS | DIGITS) EXPONENT?
EXPONENT: /[eE]/ SIGN? DIGITS
NONZERO: /\d*[^\D0]\d*/
DIGITS: /\d+/
SIGN: /[+-]/

//: string-tokens
STRING: "'" (/[^'\\]/ | ESCAPE)* "'"
ESCAPE: /\\['\\n]/
TEX.1: "tex'" (/[^'\\]/ | /\\[\s\S]/)* "'"

//: prefix-tokens
DOC.1: "doc@"
FREE.1: "free@"

//: interpolation-tokens
DOLLAR_QUOTE: "$'"
HASH_QUOTE: "#'"
QUOTE: "'"
TEXT: (/[^'\\{}]/ | ESCAPE | "{{" | "}}")+
FORMAT: ":" /[^{}']*/
