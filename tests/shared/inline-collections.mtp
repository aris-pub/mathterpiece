; A collection may be written in place: a map, a sort or a reverse, not only a name.
; expect total 6
; expect largest 3
; expect first-big 2
; expect big 2
; expect any-big true
; write g[0].r 5
; expect total 10
; expect largest 5
(scene s (group g (circle _ (r 1)) (circle _ (r 2)) (circle _ (r 3))))
(real total (sum (map g (fn m m.r))))
(real largest (reduce (sort (map g (fn m m.r)) (fn v v)) 0 (fn ((real best) (real v)) (max best v))))
(real first-big (let ((rs (map (sort g (fn m m.r)) (fn n n.r)))) rs[1]))
(int big (count (reverse (map g (fn m m.r))) (fn v (> v 1))))
(bool any-big (any (map (map g (fn m m.r)) (fn v (> v 2)))))
