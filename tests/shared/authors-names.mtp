; An author's function replaces a library function of the same name.
; expect r 20
; expect a 9
; expect d 8
; expect y 14
; expect z 16
(func reverse (real x) (* x 10))
(func sort (real x) (* x 3))
(func sum (real x) (* x 4))
(func any (real x) (* x 7))
(func all (real x) (* x 8))
(real k 2)
(scene s)
(button b (animation (k (transition (to 2) (duration 0)))))
(real r (reverse k))
(real a (sort 3))
(real d (sum k))
(real y (any k))
(real z (all k))
