; A state reads as a bool anywhere: in a value, a readout, a canvas's when. A state may read a
; self toggle, and then only views and controls may read it.
; expect v false
; expect r "small"
; expect r2 "hidden"
; write k 2
; expect v true
; expect r "big"
; write show true
; expect r2 "shown"
(real 'k' 0)
(scene 's' (circle 'c' (r k)))
(button 'b' (animation (k (transition (to 0) (duration 0)))))
(toggle 'show' self)
(state 'big' (> k 1))
(state 'on' (= show true))
(bool 'v' big)
(readout 'r' (if big 'big' 'small'))
(readout 'r2' (if on 'shown' 'hidden'))
(canvas 'view' (view-x -3) (view-y -3) (view-width 6) (view-height 6) (when big c))
