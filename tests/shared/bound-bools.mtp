; A bound bool reads anywhere a bool is expected: in a variable, a readout, a canvas's when, and
; one may read a bool a toggle writes.
; expect v false
; expect r "small"
; expect r2 "hidden"
; write k 2
; expect v true
; expect r "big"
; write shown true
; expect r2 "shown"
(real k 0 (>= 0))
(scene s (circle c (r k)))
(button b (animation (move k (to 0) (duration 0))))
(bool shown false)
(toggle show shown)
(bool big (> k 1))
(bool on (= shown true))
(bool v big)
(readout r (if big 'big' 'small'))
(readout r2 (if on 'shown' 'hidden'))
(canvas view (x -3) (y -3) (width 6) (height 6) (when big c))
