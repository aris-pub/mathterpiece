; A bound bool reads anywhere a bool is expected: in a variable, a readout, a canvas's when. A
; bool that reads a toggle has page access, so only components and globals may read it.
; expect v false
; expect r "small"
; expect r2 "hidden"
; write k 2
; expect v true
; expect r "big"
; write show true
; expect r2 "shown"
(real k 0 (>= 0))
(scene s (circle c (r k)))
(button b (animation (move k (to 0) (duration 0))))
(toggle show none)
(bool big (> k 1))
(bool on (= show.value true))
(bool v big)
(readout r (if big 'big' 'small'))
(readout r2 (if on 'shown' 'hidden'))
(canvas view (x -3) (y -3) (width 6) (height 6) (when big c))
