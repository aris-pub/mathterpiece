; mtp-asl: infinity is above every number; a result that is infinite while drawing is none.
; There is no constant for it (mtp-ydd4.7.33), but an animation that loops forever lasts forever.
; expect below true
; expect above true
; expect sum null
; expect word "infty"
; write x 1e300
; expect below true
; expect x 1e150
(real x 3)
(animation forever (loop) (move x (to 4) (duration 1)))
(real big forever.duration (const))
(bool below (< x big))
(bool above (> big x))
(real|none sum (+ x big))
(string word 'infty')
