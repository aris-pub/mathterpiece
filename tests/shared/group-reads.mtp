; A group's attribute spreads over its members, for anything a member's attribute can be: a
; stored attribute, a motif parameter, or a position. A rect's position is its center.
; expect radii 3
; expect ks 30
; expect xs 4
; expect centers-x 4
; expect biggest 2
; expect smallest 1
; expect far 4
; write dots[1].k 5
; expect ks 15
(motif dot (real k 0 (>= 0)) (circle c (r k)))
(scene s
  (group circles (circle _ (r 1)) (circle _ (pos [4 0]) (r 2)))
  (group dots (dot _ (k 10)) (dot _ (k 20)))
  (group boxes (rect _ (x 0) (width 2) (height 2)) (rect _ (x 4) (width 4) (height 2))))
(button b (animation (transit _ dots[1].k (to 20) (duration 0))))
(real radii (sum circles.r))
(real ks (sum dots.k))
(real xs (let ((s (reduce circles.pos [0 0] (fn ((point acc) (point p)) (+ acc p))))) s.x))
(real centers-x (sum boxes.x))
(real biggest (max circles.r))
(real smallest (min circles.r 5))
(real far (max (dist [0 0] circles[1].pos) circles.r))
