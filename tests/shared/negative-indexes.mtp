; Negative indexes count from the end: a let's list, sorted members, a list made in a function
; over a group parameter, and a point.
; expect v1 3
; expect v2 3
; expect v3 2
; expect v4 2
(real k 1 (>= 0))
(func last-r (sequence[circle] g) (let ((rs (map g (fn p p.r)))) rs[-1]))
(scene s (circle a (pos [1 2]) (r k)) (group g (circle _ (r 1)) (circle _ (r 3)) (circle _ (r 2))))
(button b (animation (k (transition (to 1) (duration 0)))))
(real v1 (let ((ds (sort (map g (fn p (* p.r k))) (fn d d)))) ds[-1]))
(real v2 (let ((ns (sort g (fn p (* p.r k))))) ns[-1].r))
(real v3 (or? (last-r g) 0))
(real v4 a.pos[-1])
