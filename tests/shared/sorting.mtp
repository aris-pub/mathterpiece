; Sorting lists and members by key, and reading through the sorted list as the scene changes.
; expect nearest-x 1
; expect third 1
; expect biggest 5
; write points[0].r 9
; expect biggest 10
(scene s (circle x (pos [0 0]))
  (group points (circle _ (pos [6 8]) (r 1)) (circle _ (pos [1 0]) (r 2)) (circle _ (pos [3 4]) (r 3))))
(real nearest-x (let ((ns (sort points (fn p (dist x.pos p.pos))))) ns[0].x))
(real third (let ((ds (reverse (sort (map points (fn p (dist x.pos p.pos))) (fn d d))))) ds[2]))
(real biggest (let ((ns (reverse (sort points (fn p p.r))))) (dist x.pos ns[0].pos)))
