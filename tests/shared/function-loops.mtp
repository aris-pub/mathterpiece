; Loops in function bodies: unrolled when the size is known, walked while drawing over a group
; parameter.
; expect a 6
; expect b 12
; expect c 2
; expect d 2
; expect e 3
; expect f 1
; expect g true
; expect h 3
; expect i 15
; expect j 7
; write two[0].r 10
; expect b 17
(real 'n' 0)
(func 'total' (params (g)) (sum g p p.r))
(func 'big' (params (g) (k 0.0)) (count g p (> p.r k)))
(func 'second' (params (g)) (let ((rs (map g p p.r))) rs[1]))
(func 'nearest-r' (params (g) (o)) (let ((ns (sort g p (dist o p)))) ns[0].r))
(func 'smallest-r' (params (g)) (let ((ns (reverse (sort-desc g p p.r)))) ns[0].r))
(func 'safe' (params (g) (d 0.0)) (any (map g p (or (> p.r 2) (> (/ 1 d) 0)))))
(func 'pairs' (params (g)) (sum g p (count g q (< q.r p.r))))
(func 'listy' (params (xs [1 2 3])) (sum xs v v))
(func 'second-r' (params (g)) g[1].r)
(scene 's' (circle 'x' (pos [0 0]))
  (group 'three' (circle _ (pos [3 4]) (r 1)) (circle _ (pos [6 8]) (r 2)) (circle _ (pos [1 0]) (r 3)))
  (group 'two' (circle _ (r 5)) (circle _ (r 7))))
(real 'a' (total three))
(real 'b' (total two))
(real 'c' (big three 1))
(real 'd' (second three))
(real 'e' (nearest-r three x))
(real 'f' (smallest-r three))
(bool 'g' (safe two n))
(real 'h' (pairs three))
(real 'i' (listy [4 5 6]))
(real 'j' (second-r two))
