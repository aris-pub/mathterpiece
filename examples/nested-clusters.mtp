; Eight points in nested clusters, from the Bourgain notes: pairs merge at depth b, pairs of
; pairs at b², and the two halves at b³. Each join is a bracket hanging from the two clusters it
; merges. Sizes follow the original figure: points 30 apart, levels 2, 4 and 8 times 14 below
; the points (so the depths are drawn to scale for b = 2), y pointing up.

(color 'fg' '#1f2328')
(color 'muted' '#6b7280')
(font 'note' (size 13))

(const 'top' -50)

; The x of point i, and the depth of level h (0 at the points).
(func 'point-x' (params (i 0)) (+ 70 (* 30 i)))
(func 'depth' (params (h 0)) (- top (* 14 (^ 2 h))))

; A join: down from two clusters at left and right, and across at the depth where they merge.
(motif 'bracket' (params (left 0.0) (right 0.0) (from 0.0) (to 0.0))
  (line _ (from [left from]) (to [left to]))
  (line _ (from [left to]) (to [right to]))
  (line _ (from [right to]) (to [right from])))

(scene 'clusters'
  (group 'tree'
    ; Level 1: point 2k with point 2k+1.
    (repeat 4 k
      (bracket _ (left (point-x (* 2 k))) (right (point-x (+ (* 2 k) 1))) (from top) (to (depth 1))
        (stroke fg) (stroke-width 1.5)))
    ; Level 2: the middles of pairs 2j and 2j+1, which are 60 apart.
    (repeat 2 j
      (bracket _ (left (+ 85 (* 120 j))) (right (+ 145 (* 120 j))) (from (depth 1)) (to (depth 2))
        (stroke fg) (stroke-width 1.5)))
    ; Level 3: the middles of the two halves.
    (bracket _ (left 115) (right 235) (from (depth 2)) (to (depth 3)) (stroke fg) (stroke-width 1.5))
    (repeat 8 i
      (circle _ (pos [(point-x i) top]) (r 5) (fill fg))))

  ; The depth axis on the left, and the level names on the right.
  (group 'axis'
    (line _ (from [40 top]) (to [40 (depth 3)]) (stroke muted) (stroke-width 1))
    (text _ '0' (pos [33 (- top 4)]) (halign 'end') (font note) (fill muted))
    (repeat 3 h
      (let ((y (depth (+ h 1))))
        (line _ (from [36 y]) (to [40 y]) (stroke muted) (stroke-width 1))
        (text _ (cond ((= h 0) 'b') ((= h 1) 'b²') (else 'b³')) (pos [33 (- y 4)])
          (halign 'end') (font note) (fill muted))
        (let ((level (+ h 1)))
          (text _ $'level {level}' (pos [(+ (point-x 7) 22) (- y 4)]) (font note)
            (fill muted)))))))

(canvas 'view' (view-x 0) (view-y -182) (view-width 350) (view-height 162) clusters)
