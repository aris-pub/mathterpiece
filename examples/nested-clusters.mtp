; Eight points in nested clusters, from the Bourgain notes: pairs merge at depth b, pairs of
; pairs at b², and the two halves at b³. Each join is a bracket hanging from the two clusters it
; merges. Sizes follow the original figure: points 30 apart, levels 2, 4 and 8 times 14 below
; the points (so the depths are drawn to scale for b = 2), y pointing up.

(color fg '#1f2328')
(color muted '#6b7280')
(font note (size 13))

(int top -50 (const))

; The x of point i, and the depth of level h (0 at the points).
(func point-x (int i) (+ 70 (* 30 i)))
(func depth (int h (>= 0) (<= 3)) (- top (* 14 (^ 2 h))))

; A join: down from two clusters at left and right, and across at the depth where they merge.
(motif bracket ((real left 0) (real right 0) (real from 0) (real to 0))
  (line_ (from [left from]) (to [left to]))
  (line_ (from [left to]) (to [right to]))
  (line_ (from [right to]) (to [right from])))

(scene clusters
  (group tree
    (group_ (defaults (stroke fg) (stroke-width 1.5))
      ; Level 1: point 2k with point 2k+1.
      (repeat 4 k
        (bracket_ (left (point-x (* 2 k))) (right (point-x (+ (* 2 k) 1)))
                  (from top) (to (depth 1))))
      ; Level 2: the middles of pairs 2j and 2j+1, which are 60 apart.
      (repeat 2 j
        (bracket_ (left (+ 85 (* 120 j))) (right (+ 145 (* 120 j)))
                  (from (depth 1)) (to (depth 2))))
      ; Level 3: the middles of the two halves.
      (bracket_ (left 115) (right 235) (from (depth 2)) (to (depth 3))))
    (group_ (defaults (fill fg))
      (repeat 8 i
        (circle_ (pos [(point-x i) top]) (r 5)))))

  ; The depth axis on the left, and the level names on the right.
  (group axis (defaults (stroke muted) (stroke-width 1) (fill muted))
    (line_ (from [40 top]) (to [40 (depth 3)]))
    (text_ '0' (pos [33 (- top 4)]) (halign 'end') (font note))
    (repeat 3 h
      (line_ (from [36 (depth (+ h 1))]) (to [40 (depth (+ h 1))]))
      (text_ (cond ((= h 0) 'b') ((= h 1) 'b²') (else 'b³')) (pos [33 (- (depth (+ h 1)) 4)])
        (halign 'end') (font note))
      (text_ $'level {(+ h 1)}' (pos [(+ (point-x 7) 22) (- (depth (+ h 1)) 4)]) (font note)))))

(canvas view (view-x 0) (view-y -182) (view-width 350) (view-height 162) clusters)
