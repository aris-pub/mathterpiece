; A quadratic, f(x) = ax² + bx + c, with a slider for each coefficient. The formula shows the
; values, and hovering one of its terms draws what that term adds to the graph, in its color:
; ax² alone, the line bx, or the height c where the graph crosses the y axis. Drag the point on
; the y axis to change c, or the vertex to change b: it slides along the path its position can
; take while a and c stay put.

(import house paper ink soft red green blue code)
(import marks)

(real a 0.5 (>= -2) (<= 2))
(real b -1 (>= -5) (<= 5))
(real c -2 (>= -5) (<= 5))

; Which term the pointer is on, if any: the formula writes it, the scene reads it.
(type part string (one-of 'a' 'b' 'c'))
(part|none focus none)

; The plot window.
(real left -6 (const))
(real right 6 (const))
(real bottom -6 (const))
(real top 6 (const))

(func[real] f ((real x)) (+ (* a x x) (* b x) c))
; A curve through 241 points of g from left to right.
(func[list[point]] trace ((func[real real] g)) (map (range left right (num 241)) (fn x [x (g x)])))

; A coefficient after a sign, as it reads after another term: '+ 2.0', '- 3.0'.
(func[string] signed ((real v)) (if (< v 0) $'- {(abs v):.1f}' $'+ {v:.1f}'))

(scene plot (background paper)
  (group grid
    (marks.grid_ (left left) (right right) (bottom bottom) (top top) (stroke soft)
                 (defaults (stroke-opacity 0.35)))
    (marks.axes_ (left left) (right right) (bottom bottom) (top top) (stroke soft)))

  (group window (clip (rect_ (pos [0 0]) (width (- right left)) (height (- top bottom))))
    ; What each term adds, drawn while the pointer is on it.
    (group parts (defaults (stroke-width 2.5) (dash [6 5]) (fill none))
      (polyline a-part (points (trace (fn x (* a x x)))) (stroke red))
      (polyline b-part (points (trace (fn x (* b x)))) (stroke green))
      (line c-part (from [left c]) (to [right c]) (stroke blue)))
    (polyline graph (points (trace f)) (stroke ink) (stroke-width 3) (line-join 'round')
        (fill none)))

  ; The vertex, where the graph turns, exists only while a is not 0.
  (group handles (defaults (stroke paper) (stroke-width 2))
    (circle|none vertex (pos (if (= a 0) none [(/ (- b) (* 2 a)) (- c (/ (* b b) (* 4 a)))]))
        (r 0.22) (fill ink))
    (circle crossing (pos [0 c]) (r 0.22) (fill blue))))

(canvas view (x left) (y bottom) (width (- right left)) (height (- top bottom)) (pan false)
    (zoom false) (toggle-duration 0.25)
  doc@'The graph of f, and what the term under the pointer adds.'
  grid
  (when (= focus 'a') a-part)
  (when (= focus 'b') b-part)
  (when (= focus 'c') c-part)
  graph
  handles)

(formula machine
  doc@'f(x) = ax² + bx + c, with the coefficients\' values.'
    (defaults (padding 3) (rounding 4))
  tex'f(x) = \term{a}{} x^2 \term{b}{} x \term{c}{}'
  (term a (tex $'{a:.1f}') (fill red))
  (term b (tex (signed b)) (fill green))
  (term c (tex (signed c)) (fill blue)))

(display machine-line machine doc@'The formula, whose terms show what they add to the graph.')

; Pointing at a term shows what it adds to the graph; each term's piece is named after it.
(foreach t ['a' 'b' 'c']
  (on-enter #'machine.{t}' (animation (move focus (to t) (duration 0)))
    doc@'Shows what the term adds to the graph.')
  (on-leave #'machine.{t}' (animation (move focus (to none) (duration 0)))
    doc@'Hides it again.'))

(slider a-knob (move a (from -2) (to 2)) (label 'a') doc@'Sets a.')
(slider b-knob (move b (from -5) (to 5)) (label 'b') doc@'Sets b.')
(slider c-knob (move c (from -5) (to 5)) (label 'c') doc@'Sets c.')

(on-drag crossing (move c (to pointer.y)) doc@'Moves the graph up and down.')
; The vertex sits at x = -b / 2a, so the pointer's x gives b.
(on-drag vertex (move b (to (* -2 a pointer.x))) doc@'Slides the vertex along its path, changing b.')

; Where the graph turns and where it crosses the x axis, in words.
(readout facts
    (or? (let ((d (- (* b b) (* 4 a c)))
               (vx (/ (- b) (* 2 a)))
               (vy (- c (/ (* b b) (* 4 a)))))
           (cond ((= a 0) 'With a = 0 the graph is a line, with no vertex.')
                 ((< d 0) $'Vertex at ({vx:.2f}, {vy:.2f}). It never crosses the x axis.')
                 ((= d 0) $'Vertex at ({vx:.2f}, 0): it touches the x axis there.')
                 (else $'Vertex at ({vx:.2f}, {vy:.2f}). It crosses the x axis at {(/ (- (- b) (sqrt d)) (* 2 a)):.2f} and {(/ (+ (- b) (sqrt d)) (* 2 a)):.2f}.')))
         '')
  doc@'The vertex and the roots.')
