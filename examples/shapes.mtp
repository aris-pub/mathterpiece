; Each kind of built-in shape: a circle with an inscribed equilateral triangle and a square
; around it, an ellipse turned around its center and a rect turned around its corner.
; Stroke widths and font sizes are in screen pixels, chosen for a canvas 640 pixels wide.

(color ink '#1f2a44')
(font small (size 22.4))

(scene world
  (background '#f7f3ea')

  ; Axes through the origin.
  (line _ (from [-9 0]) (to [9 0]) (stroke ink) (stroke-width 1.6))
  (line _ (from [0 -9]) (to [0 9]) (stroke ink) (stroke-width 1.6))

  (rect square (pos [0 0]) (width 12) (height 12) (fill none) (stroke ink) (stroke-width 2.56))
  (circle disk (r 6) (fill '#cfe3f2') (stroke ink) (stroke-width 2.56))
  (triangle tri (a (polar 6 90)) (b (polar 6 210)) (c (polar 6 330))
    (fill '#f2b8a0') (stroke ink) (stroke-width 2.56))

  ; A transform turns about the scene's origin, so each shape is turned first and then moved
  ; into place.
  (ellipse oval (rx 2.5) (ry 1) (transform (transform (rotate 30) (translate 6 -6)))
    (fill '#b9d8b0'))
  ; The rect's center is half its size from the corner it turns around.
  (rect card (pos [1.5 1]) (width 3) (height 2) (rx 0.3) (ry 0.3)
    (transform (transform (rotate 20) (translate -8 -8))) (fill '#e9c46a'))

  ; The triangle's corners are at its circumradius from its centroid.
  (text label $'tri.r = {(dist tri.pos tri.a):.2f}' (pos [-9 8.5]) (font small) (fill ink)))

(canvas cnv world)
