; Six balls race with six eases: each crosses the same distance in the same time, and only its
; ease differs. They run out together (at-once), come back one at a time (in-order), and do it
; again forever (loop). The last ease is a function the figure declares.

(color paper '#f6f1e7')
(color ink '#1f2a44')
(color soft '#8a93a6')
(color terracotta '#e76f51')
(color teal '#2a9d8f')
(color saffron '#e9c46a')
(color plum '#6d597a')
(font code (family 'ui-monospace, Menlo, monospace') (size 13))

; An ease that lands and bounces three times, each bounce smaller: the usual bounce ease, four
; parabolas joined end to end.
(func bounce (real t)
  (cond ((< t (/ 1 2.75)) (* 7.5625 t t))
        ((< t (/ 2 2.75)) (+ (* 7.5625 (- t (/ 1.5 2.75)) (- t (/ 1.5 2.75))) 0.75))
        ((< t (/ 2.5 2.75)) (+ (* 7.5625 (- t (/ 2.25 2.75)) (- t (/ 2.25 2.75))) 0.9375))
        (else (+ (* 7.5625 (- t (/ 2.625 2.75)) (- t (/ 2.625 2.75))) 0.984375))))

; Where the lanes start and finish, and how far apart they are: every position below follows.
(real start -2.6 (const))
(real finish 7 (const))
(real lane-gap 1.2 (const))
; Lane i's middle, from the top lane down.
(func lane ((int i)) (- 3 (* lane-gap i)))
(list[string] ease-names ['\'linear\'' '\'ease-in\'' '\'ease-out\'' '\'ease-in-out\'' '(step 5)' 'bounce'] (const))

(scene track
  (background paper)

  ; Lane edges, and the start and finish lines.
  (group lanes (defaults (stroke soft) (stroke-width 1))
    (foreach i 7
      (line_ (from [(- start 0.6) (+ (lane i) (/ lane-gap 2))])
        (to [(+ finish 0.6) (+ (lane i) (/ lane-gap 2))]) (stroke-opacity 0.5)))
    (line_ (from [start (+ (lane 0) (/ lane-gap 2))]) (to [start (- (lane 5) (/ lane-gap 2))]))
    (line_ (from [finish (+ (lane 0) (/ lane-gap 2))]) (to [finish (- (lane 5) (/ lane-gap 2))])))

  (group names (defaults (fill ink) (font code) (halign 'end') (valign 'middle'))
    (foreach i 6
      (text_ ease-names[i] (pos [(- start 0.8) (lane i)]))))

  (group balls (defaults (stroke none))
    (foreach i 6
      (circle (name $'ball-{i}') (x start) (y (lane i)) (r 0.34)
        (fill [terracotta teal saffron plum][(mod i 4)]))))

  (group captions (defaults (fill soft) (font code) (halign 'middle'))
    (text_ '(animation (loop) (at-once …) (in-order …))' (pos [2.2 -4.5]))
    (text_ '(func bounce (real t) …), an ease of the figure\'s own' (pos [2.2 -5.2]))))

(canvas view (view-x -6.7) (view-y -5.8) (view-width 15) (view-height 10.2) (pan false)
  (zoom false)
  track)

(play race (autoplay view) (label 'race')
  (animation (loop)
    (at-once (defaults (duration 1.6))
      (move ball-0.x (to finish) (ease 'linear'))
      (move ball-1.x (to finish) (ease 'ease-in'))
      (move ball-2.x (to finish) (ease 'ease-out'))
      (move ball-3.x (to finish) (ease 'ease-in-out'))
      (move ball-4.x (to finish) (ease (step 5)))
      (move ball-5.x (to finish) (ease bounce)))
    (move none (duration 0.8))
    (in-order (defaults (duration 0.8))
      (move ball-0.x (to start) (ease 'linear'))
      (move ball-1.x (to start) (ease 'ease-in'))
      (move ball-2.x (to start) (ease 'ease-out'))
      (move ball-3.x (to start) (ease 'ease-in-out'))
      (move ball-4.x (to start) (ease (step 5)))
      (move ball-5.x (to start) (ease bounce)))
    (move none (duration 0.8))))
