; A red point and a teal ring, drawn through a canvas transform: the canvas turns them by angle,
; stretches them 1.5 times along x and moves them down by 3. Change angle to turn the drawing.
(real angle 30)
(font label-font (size 32))
(scene world
  (group shapes
    (circle center (r 0.3) (fill 'red'))
    (circle ring (x 4) (r 2) (fill none) (stroke 'teal') (stroke-width 4.48))
    (text lbl 'ring' (x 4) (y 2.5) (font label-font))))

(canvas cnv (view-x -10) (view-y -10) (view-width 20) (view-height 20)
  (transform (transform (rotate angle) (scale 1.5 1) (translate 0 -3)))
  shapes)
