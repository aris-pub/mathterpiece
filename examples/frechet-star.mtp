; The Frechet embedding of a star with four leaves, from the Bourgain notes: each point's
; coordinates are its distances to every point. Center and leaf differ by 1 everywhere, two
; leaves by 2 in two places.
; Coordinates are the original SVG's, with y pointing up; each panel is a group with its own canvas.

; Colors and type as tokens, so the Bourgain page can map them onto its own variables
; (--mtp-fg: var(--fg) and so on) and follow its light and dark mode.
(color fg '#1f2328')
(color muted '#6b7280')
(color bg '#faf7f0')
(color rule '#d8d3c4')
(color teal '#1a6f66')
(color coral '#a65a3a')
(color accent '#4a6584')
(color warn '#a07a2c')
(font label (style 'italic') (size 14))
(font note (size 13))
(font value (size 14))

(scene star
  ; A star with center c and four leaves u1, u2, u3, u4.
  (group a-star
    (line _ (from [90 -110]) (to [90 -50]) (stroke fg) (stroke-width 1.5))
    (line _ (from [90 -110]) (to [150 -110]) (stroke fg) (stroke-width 1.5))
    (line _ (from [90 -110]) (to [90 -170]) (stroke fg) (stroke-width 1.5))
    (line _ (from [90 -110]) (to [30 -110]) (stroke fg) (stroke-width 1.5))
    (circle _ (pos [90 -110]) (r 5) (fill fg))
    (circle _ (pos [90 -50]) (r 5) (fill fg))
    (circle _ (pos [150 -110]) (r 5) (fill fg))
    (circle _ (pos [90 -170]) (r 5) (fill fg))
    (circle _ (pos [30 -110]) (r 5) (fill fg))
    (text _ 'c' (pos [100 -102]) (font label) (fill fg))
    (text _ 'u₁' (pos [98 -44]) (font label) (fill fg))
    (text _ 'u₂' (pos [158 -104]) (font label) (fill fg))
    (text _ 'u₃' (pos [98 -186]) (font label) (fill fg))
    (text _ 'u₄' (pos [8 -104]) (font label) (fill fg))
    (text _ '(a) the star, n = 5' (pos [90 -215]) (halign 'middle') (font note) (fill muted)))

  ; Coordinates indexed by c, u1, u2, u3, u4. F(c) = (0, 1, 1, 1, 1) and F(u1) = (1, 0, 2, 2, 2); all five entries differ by 1.
  (group center-and-leaf
    (text _ 'c' (pos [266 -60]) (halign 'middle') (font note) (fill muted))
    (text _ 'u₁' (pos [298 -60]) (halign 'middle') (font note) (fill muted))
    (text _ 'u₂' (pos [330 -60]) (halign 'middle') (font note) (fill muted))
    (text _ 'u₃' (pos [362 -60]) (halign 'middle') (font note) (fill muted))
    (text _ 'u₄' (pos [394 -60]) (halign 'middle') (font note) (fill muted))
    (text _ 'F(c)' (pos [242 -88]) (halign 'end') (font label) (fill fg))
    (rect _ (x 250) (y -96) (width 32) (height 26) (fill teal) (fill-opacity 0.18) (stroke teal) (stroke-width 1))
    (text _ '0' (pos [266 -88]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 282) (y -96) (width 32) (height 26) (fill teal) (fill-opacity 0.18) (stroke teal) (stroke-width 1))
    (text _ '1' (pos [298 -88]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 314) (y -96) (width 32) (height 26) (fill teal) (fill-opacity 0.18) (stroke teal) (stroke-width 1))
    (text _ '1' (pos [330 -88]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 346) (y -96) (width 32) (height 26) (fill teal) (fill-opacity 0.18) (stroke teal) (stroke-width 1))
    (text _ '1' (pos [362 -88]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 378) (y -96) (width 32) (height 26) (fill teal) (fill-opacity 0.18) (stroke teal) (stroke-width 1))
    (text _ '1' (pos [394 -88]) (halign 'middle') (font value) (fill fg))
    (text _ 'F(u₁)' (pos [242 -114]) (halign 'end') (font label) (fill fg))
    (rect _ (x 250) (y -122) (width 32) (height 26) (fill teal) (fill-opacity 0.18) (stroke teal) (stroke-width 1))
    (text _ '1' (pos [266 -114]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 282) (y -122) (width 32) (height 26) (fill teal) (fill-opacity 0.18) (stroke teal) (stroke-width 1))
    (text _ '0' (pos [298 -114]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 314) (y -122) (width 32) (height 26) (fill teal) (fill-opacity 0.18) (stroke teal) (stroke-width 1))
    (text _ '2' (pos [330 -114]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 346) (y -122) (width 32) (height 26) (fill teal) (fill-opacity 0.18) (stroke teal) (stroke-width 1))
    (text _ '2' (pos [362 -114]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 378) (y -122) (width 32) (height 26) (fill teal) (fill-opacity 0.18) (stroke teal) (stroke-width 1))
    (text _ '2' (pos [394 -114]) (halign 'middle') (font value) (fill fg))
    (text _ 'differ by 1 in all n coordinates:' (pos [302 -160]) (halign 'middle') (font note) (fill muted))
    (text _ '‖F(c) − F(u₁)‖ = √n' (pos [302 -178]) (halign 'middle') (font note) (fill muted))
    (text _ '(b) center and leaf, distance 1' (pos [302 -215]) (halign 'middle') (font note) (fill muted)))

  ; F(u1) = (1, 0, 2, 2, 2) and F(u2) = (1, 2, 0, 2, 2); they differ by 2 in the u1 and u2 entries and agree elsewhere.
  (group two-leaves
    (text _ 'c' (pos [516 -60]) (halign 'middle') (font note) (fill muted))
    (text _ 'u₁' (pos [548 -60]) (halign 'middle') (font note) (fill muted))
    (text _ 'u₂' (pos [580 -60]) (halign 'middle') (font note) (fill muted))
    (text _ 'u₃' (pos [612 -60]) (halign 'middle') (font note) (fill muted))
    (text _ 'u₄' (pos [644 -60]) (halign 'middle') (font note) (fill muted))
    (text _ 'F(u₁)' (pos [492 -88]) (halign 'end') (font label) (fill fg))
    (rect _ (x 500) (y -96) (width 32) (height 26) (fill none) (stroke rule) (stroke-width 1))
    (text _ '1' (pos [516 -88]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 532) (y -96) (width 32) (height 26) (fill coral) (fill-opacity 0.18) (stroke coral) (stroke-width 1))
    (text _ '0' (pos [548 -88]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 564) (y -96) (width 32) (height 26) (fill coral) (fill-opacity 0.18) (stroke coral) (stroke-width 1))
    (text _ '2' (pos [580 -88]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 596) (y -96) (width 32) (height 26) (fill none) (stroke rule) (stroke-width 1))
    (text _ '2' (pos [612 -88]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 628) (y -96) (width 32) (height 26) (fill none) (stroke rule) (stroke-width 1))
    (text _ '2' (pos [644 -88]) (halign 'middle') (font value) (fill fg))
    (text _ 'F(u₂)' (pos [492 -114]) (halign 'end') (font label) (fill fg))
    (rect _ (x 500) (y -122) (width 32) (height 26) (fill none) (stroke rule) (stroke-width 1))
    (text _ '1' (pos [516 -114]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 532) (y -122) (width 32) (height 26) (fill coral) (fill-opacity 0.18) (stroke coral) (stroke-width 1))
    (text _ '2' (pos [548 -114]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 564) (y -122) (width 32) (height 26) (fill coral) (fill-opacity 0.18) (stroke coral) (stroke-width 1))
    (text _ '0' (pos [580 -114]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 596) (y -122) (width 32) (height 26) (fill none) (stroke rule) (stroke-width 1))
    (text _ '2' (pos [612 -114]) (halign 'middle') (font value) (fill fg))
    (rect _ (x 628) (y -122) (width 32) (height 26) (fill none) (stroke rule) (stroke-width 1))
    (text _ '2' (pos [644 -114]) (halign 'middle') (font value) (fill fg))
    (text _ 'differ by 2 in two coordinates:' (pos [552 -160]) (halign 'middle') (font note) (fill muted))
    (text _ '‖F(u₁) − F(u₂)‖ = 2√2' (pos [552 -178]) (halign 'middle') (font note) (fill muted))
    (text _ '(c) two leaves, distance 2' (pos [552 -215]) (halign 'middle') (font note) (fill muted))))

(canvas a-star-view (view-x 0) (view-y -224)
  (view-width 182) (view-height 200) a-star)
(canvas center-and-leaf-view (view-x 184) (view-y -224)
  (view-width 232) (view-height 184) center-and-leaf)
(canvas two-leaves-view (view-x 444) (view-y -224)
  (view-width 222) (view-height 184) two-leaves)
