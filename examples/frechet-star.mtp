; The Fréchet embedding of a star with four leaves, from the Bourgain notes: each point's
; coordinates are its distances to every point. Center and leaf differ by 1 everywhere, two
; leaves by 2 in two places.
; Coordinates are the original SVG's, with y pointing up; each panel is a group with its own
; canvas.

; Colors and type as tokens, so the Bourgain page can map them onto its own variables
; (--mtp-fg: var(--fg) and so on) and follow its light and dark mode.
(color fg '#1f2328')
(color muted '#6b7280')
(color rule '#d8d3c4')
(color teal '#1a6f66')
(color coral '#a65a3a')
(font label (style 'italic') (size 14))
(font note (size 13))
(font value (size 14))

; The points, in the order of their coordinates: c, then the leaves u₁ to u₄.
(list[string] names ['c' 'u₁' 'u₂' 'u₃' 'u₄'] (const))

; The distance between points i and j in the star.
(func dist-in-star ((int i) (int j)) (cond ((= i j) 0) ((or (= i 0) (= j 0)) 1) (else 2)))

; The Fréchet coordinates of points a and b, one row each, with a column per point. A cell where
; the two rows differ is marked in the color mark.
(motif rows ((int a 0 (const)) (int b 1 (const)) (real left 250) (color mark '#1a6f66'))
  (repeat 5 q
    (text_ names[q] (pos [(+ left 16 (* 32 q)) -60]) (halign 'middle') (font note) (fill muted)))
  (repeat 2 row
    (text_ $'F({names[(if (= row 0) a b)]})' (pos [(- left 8) (- -88 (* 26 row))]) (halign 'end')
      (font label) (fill fg))
    (repeat 5 q
      (rect_ (pos [(+ left 16 (* 32 q)) (- -83 (* 26 row))]) (width 32) (height 26)
        (fill (if (= (dist-in-star a q) (dist-in-star b q)) none mark)) (fill-opacity 0.18)
        (stroke (if (= (dist-in-star a q) (dist-in-star b q)) rule mark)) (stroke-width 1))
      (text_ $'{(dist-in-star (if (= row 0) a b) q)}'
        (pos [(+ left 16 (* 32 q)) (- -88 (* 26 row))]) (halign 'middle') (font value)
        (fill fg)))))

(scene star
  ; A star with center c and four leaves u₁, u₂, u₃, u₄.
  (group a-star
    (group_ (defaults (stroke fg) (stroke-width 1.5))
      (line_ (from [90 -110]) (to [90 -50]))
      (line_ (from [90 -110]) (to [150 -110]))
      (line_ (from [90 -110]) (to [90 -170]))
      (line_ (from [90 -110]) (to [30 -110])))
    (group_ (defaults (fill fg))
      (circle_ (pos [90 -110]) (r 5))
      (circle_ (pos [90 -50]) (r 5))
      (circle_ (pos [150 -110]) (r 5))
      (circle_ (pos [90 -170]) (r 5))
      (circle_ (pos [30 -110]) (r 5))
      (text_ 'c' (pos [100 -102]) (font label))
      (text_ 'u₁' (pos [98 -44]) (font label))
      (text_ 'u₂' (pos [158 -104]) (font label))
      (text_ 'u₃' (pos [98 -186]) (font label))
      (text_ 'u₄' (pos [8 -104]) (font label)))
    (text_ '(a) the star, n = 5' (pos [90 -215]) (halign 'middle') (font note) (fill muted)))

  ; F(c) = (0, 1, 1, 1, 1) and F(u₁) = (1, 0, 2, 2, 2): all five entries differ, by 1.
  (group center-and-leaf (defaults (fill muted))
    (rows_ (a 0) (b 1) (left 250) (mark teal))
    (text_ 'differ by 1 in all n coordinates:' (pos [302 -160]) (halign 'middle') (font note))
    (text_ '‖F(c) − F(u₁)‖ = √n' (pos [302 -178]) (halign 'middle') (font note))
    (text_ '(b) center and leaf, distance 1' (pos [302 -215]) (halign 'middle') (font note)))

  ; F(u₁) = (1, 0, 2, 2, 2) and F(u₂) = (1, 2, 0, 2, 2): they differ, by 2, in the u₁ and u₂
  ; entries, and agree elsewhere.
  (group two-leaves (defaults (fill muted))
    (rows_ (a 1) (b 2) (left 500) (mark coral))
    (text_ 'differ by 2 in two coordinates:' (pos [552 -160]) (halign 'middle') (font note))
    (text_ '‖F(u₁) − F(u₂)‖ = 2√2' (pos [552 -178]) (halign 'middle') (font note))
    (text_ '(c) two leaves, distance 2' (pos [552 -215]) (halign 'middle') (font note))))

(canvas a-star-view (view-x 0) (view-y -224) (view-width 182) (view-height 200) a-star)
(canvas center-and-leaf-view (view-x 184) (view-y -224) (view-width 232) (view-height 184)
  center-and-leaf)
(canvas two-leaves-view (view-x 444) (view-y -224) (view-width 222) (view-height 184)
  two-leaves)
