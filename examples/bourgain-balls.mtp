; Balls around a pair x, y, from the Bourgain notes (Lemma 5.1). ρⱼ is the smallest radius at
; which the balls around x and around y both hold at least 2ʲ points, capped at δ/2, where δ is
; the distance from x to y. The bar below cuts [0, δ/2] at the ρⱼ; it fills up to the common
; radius r of the two balls. Click a point to make it x or y (the older of the two is replaced),
; move the slider to change r, or press play to grow the balls from 0 to δ/2.
; Coordinates are the original SVG's, with y pointing up. The 32 points are drawn at random
; each time the page loads, uniformly over a square.

(color fg '#1f2328')
(color muted '#6b7280')
(color bg '#faf7f0')
(color env '#f2ede2')
(color x-color '#1a6f66')
(color y-color '#a65a3a')
(color s1 '#4a6584')
(color s2 '#a07a2c')
(color s3 '#7e5a86')
(color s4 '#6f7f45')
(color s5 '#7f8da0')
(font label (style 'italic') (size 17))
(font tick-label (size 13))
(font segment (size 12))

; Which of x and y the next click replaces.
(bool replace-x true)

; Where x and y are: each slides from one point to another, x-t (or y-t) of the way along. The
; points are numbered 0 to 31.
(int x-from 0 (>= 0) (<= 31))
(int x-to 0 (>= 0) (<= 31))
(real x-t 1 (>= 0) (<= 1))
(int y-from 10 (>= 0) (<= 31))
(int y-to 10 (>= 0) (<= 31))
(real y-t 1 (>= 0) (<= 1))

; The common radius of the two balls, as a share of δ/2.
(real share 1 (>= 0) (<= 1))

; Whether p is in the ball of the given radius around center. Distances are computed, so a point
; at exactly the radius is let in by a hair more.
(func in-ball ((point center) (real radius) (point p))
  (<= (dist center p) (+ radius 1e-9)))

(scene balls
  ; Where the 32 points are. These are not drawn: the points in space sit on them, and x and y
  ; are read from them, so they come first.
  (group spots
    (foreach i 32
      (circle_ (pos [(rand 170 430) (rand -290 -30)]))))

  (point x-at (lerp spots[x-from].pos spots[x-to].pos x-t))
  (point y-at (lerp spots[y-from].pos spots[y-to].pos y-t))
  (real h (/ (dist x-at y-at) 2))
  (real r (* share h))

  ; The bar runs from 40 to 560 and stands for [0, δ/2].
  (real bar-left 40 (const))
  (real bar-width 520 (const))
  (real bar-y -338 (const))

  (circle x (pos x-at) (r 6.5) (fill x-color))
  (circle y (pos y-at) (r 6.5) (fill y-color))

  ; A point in x's ball takes x's color, else one in y's ball takes y's.
  (group space
    (foreach spot spots
      (let ((in-x (in-ball x.pos r spot.pos)) (in-y (in-ball y.pos r spot.pos)))
        (circle_ (pos spot.pos) (r 4.5)
          (fill (cond (in-x x-color) (in-y y-color) (else fg)))
          (opacity (if (or in-x in-y) 1 0.45))))))

  (list dx (sort (map space (fn p (dist x.pos p.pos))) (fn d d)))
  (list dy (sort (map space (fn p (dist y.pos p.pos))) (fn d d)))
  ; ρ₁ to ρ₅: the 2ʲ-th nearest distance (index 2ʲ - 1), for x or y, whichever is larger.
  (list rho [(min (max dx[1] dy[1]) h) (min (max dx[3] dy[3]) h) (min (max dx[7] dy[7]) h)
             (min (max dx[15] dy[15]) h) (min (max dx[31] dy[31]) h)])
  ; 0, then ρ₁ to ρ₅: segment j of the bar covers [edges[j], edges[j + 1]].
  (list edges [0 rho[0] rho[1] rho[2] rho[3] rho[4]])
  ; The first j with ρⱼ = δ/2.
  (int k (+ 1 (count rho (fn q (< q (- h 1e-9))))))
  ; Scene units per unit of distance along the bar. x and y are never the same point, so h is
  ; never 0, but the compiler cannot know that.
  (real at (or? (/ bar-width h) 0))

  ; Faint rings at ρ₁ to ρₖ around both points; the rest do not exist.
  (group rings (defaults (fill none) (stroke muted) (opacity 0.3))
    (foreach j 5
      (circle|none (name $'x-ring-{j}') (pos x.pos) (r rho[j]))
      (circle|none (name $'y-ring-{j}') (pos y.pos) (r rho[j]))
      (exists-when (name $'x-ring-{j}') (< j k))
      (exists-when (name $'y-ring-{j}') (< j k))))

  (group pair
    (line_ (from x.pos) (to y.pos) (stroke muted) (stroke-width 1) (opacity 0.6))
    ; The balls, which do not exist at radius 0.
    (circle|none x-ball (pos x.pos) (r r) (fill x-color) (fill-opacity 0.1) (stroke x-color)
      (stroke-width 1.5))
    (circle|none y-ball (pos y.pos) (r r) (fill y-color) (fill-opacity 0.1) (stroke y-color)
      (stroke-width 1.5))
    (exists-when x-ball (> r 0))
    (exists-when y-ball (> r 0))
    (group names (defaults (fill fg) (font label))
      (text_ 'x' (pos (top-right x 2.5)))
      (text_ 'y' (pos (top-right y 2.5)))))

  (list[color] segment-colors [s1 s2 s3 s4 s5])
  (list[string] tick-names ['0' 'ρ₁' 'ρ₂' 'ρ₃' 'ρ₄' 'ρ₅'] (const))

  ; Segment j covers [ρⱼ₋₁, ρⱼ], filled up to r. Past k the ρⱼ all equal δ/2, so those
  ; segments are empty. A rect's position is its center.
  (group bar
    (rect_ (pos [(+ bar-left (/ bar-width 2)) bar-y]) (width bar-width) (height 18) (rx 3)
      (fill env))
    (foreach j 5
      ; How far the segment is filled, and its width on the bar.
      (let ((filled (min rho[j] r)) (width (max 0 (* at (- filled edges[j])))))
        (rect_ (pos [(+ bar-left (* at edges[j]) (/ width 2)) bar-y]) (width width) (height 18)
          (fill segment-colors[j]))
        ; A segment's name, only once it is full and wide enough to hold it.
        (text|none (name $'segment-{j}') $'j = {(+ j 1)}'
          (pos [(+ bar-left (* at (/ (+ edges[j] filled) 2))) (- bar-y 4.5)])
          (halign 'middle') (font segment) (fill bg))
        (exists-when (name $'segment-{j}') (and (>= r (- rho[j] 1e-9)) (> width 26)))))
    ; Ticks at 0 and ρ₁ to ρₖ; the last is δ/2.
    (group ticks (defaults (stroke fg) (stroke-width 1.2) (fill fg))
      (foreach j 6
        (line|none (name $'tick-{j}') (from [(+ bar-left (* at edges[j])) (+ bar-y 14)])
          (to [(+ bar-left (* at edges[j])) (- bar-y 9)]))
        (text|none (name $'tick-name-{j}') (if (= j k) 'δ/2' tick-names[j])
          (pos [(+ bar-left (* at edges[j])) (+ bar-y 18)]) (halign 'middle') (font tick-label))
        (exists-when (name $'tick-{j}') (<= j k))
        (exists-when (name $'tick-name-{j}') (<= j k))))))

; Clicking a point makes it x or y, replacing the older of the two, which slides there, and
; grows r to the new δ/2. The point it slides from is where it was going: from-moves come before
; to-moves, so they read the old to.
(foreach i 32
  (on-click space[i]
    (animation (defaults (duration 0.4))
      (at-once
        ; Which point x and y sit on: an int jumps at the start, never passing the points between.
        (at-once (defaults (ease (step 1)))
          (move x-from (to (if replace-x x-to x-from)))
          (move y-from (to (if replace-x y-from y-to)))
          (move x-to (to (if replace-x i x-to)))
          (move y-to (to (if replace-x y-to i))))
        (move x-t (from (if replace-x 0 x-t)) (to 1))
        (move y-t (from (if replace-x y-t 0)) (to 1))
        (move share (to 1))
        (move replace-x (to (not replace-x)) (duration 0))))))

(slider radius (move share (from 0) (to 1)) (label 'r'))

(play grow (animation (move share (from 0) (to 1) (duration 3.6) (ease 'linear'))))

(readout note
    (let ((cx (count space (fn p (in-ball x.pos r p.pos))))
          (cy (count space (fn p (in-ball y.pos r p.pos)))))
      (cond ((<= r 1e-9) 'At radius 0 each ball holds only its center.')
            ((>= r (- h 1e-6))
             'At radius δ/2 the bar is full: the gaps ρⱼ − ρⱼ₋₁ add up to δ/2.')
            (else $'The balls hold {cx} and {cy} points.'))))

(canvas the-space (view-x 0) (view-y -318) (view-width 600) (view-height 318)
  rings pair space x y)
(canvas the-bar (view-x 0) (view-y -356) (view-width 600) (view-height 56) bar)
