; A graph with no cycle of length at most 4 (the Petersen graph), and a subgraph whose removed
; edge uv has endpoints joined only by a path of length 4, from the Bourgain notes. The removed
; edges are dashed in the original; mtp has no dashed strokes yet, so they are solid and faint.
; Coordinates are the original SVG's, with y pointing up; each panel is a group with its own canvas.

; Colors and type as tokens, so the Bourgain page can map them onto its own variables
; (--mtp-fg: var(--fg) and so on) and follow its light and dark mode.
(color fg '#1f2328')
(color muted '#6b7280')
(color bg '#faf7f0')
(color rule '#d8d3c4')
(color teal '#1a6f66')
(color coral '#a65a3a')
(color accent '#4a6584')
(color warn '#a07a2c')
(font label (style 'italic') (size 14))
(font note (size 13))
(font value (size 14))

(scene girth
  ; The Petersen graph: an outer pentagon, an inner five-pointed star, and five spokes joining them.
  (group petersen
    (line _ (from [110 -22]) (to [184.2 -75.9]) (stroke fg) (stroke-width 1.5))
    (line _ (from [184.2 -75.9]) (to [155.8 -163.1]) (stroke fg) (stroke-width 1.5))
    (line _ (from [155.8 -163.1]) (to [64.2 -163.1]) (stroke fg) (stroke-width 1.5))
    (line _ (from [64.2 -163.1]) (to [35.8 -75.9]) (stroke fg) (stroke-width 1.5))
    (line _ (from [35.8 -75.9]) (to [110 -22]) (stroke fg) (stroke-width 1.5))
    (line _ (from [110 -22]) (to [110 -64]) (stroke fg) (stroke-width 1.5))
    (line _ (from [184.2 -75.9]) (to [144.2 -88.9]) (stroke fg) (stroke-width 1.5))
    (line _ (from [155.8 -163.1]) (to [131.2 -129.1]) (stroke fg) (stroke-width 1.5))
    (line _ (from [64.2 -163.1]) (to [88.8 -129.1]) (stroke fg) (stroke-width 1.5))
    (line _ (from [35.8 -75.9]) (to [75.8 -88.9]) (stroke fg) (stroke-width 1.5))
    (line _ (from [110 -64]) (to [131.2 -129.1]) (stroke fg) (stroke-width 1.5))
    (line _ (from [144.2 -88.9]) (to [88.8 -129.1]) (stroke fg) (stroke-width 1.5))
    (line _ (from [131.2 -129.1]) (to [75.8 -88.9]) (stroke fg) (stroke-width 1.5))
    (line _ (from [88.8 -129.1]) (to [110 -64]) (stroke fg) (stroke-width 1.5))
    (line _ (from [75.8 -88.9]) (to [144.2 -88.9]) (stroke fg) (stroke-width 1.5))
    (circle _ (pos [110 -22]) (r 4.5) (fill fg))
    (circle _ (pos [184.2 -75.9]) (r 4.5) (fill fg))
    (circle _ (pos [155.8 -163.1]) (r 4.5) (fill fg))
    (circle _ (pos [64.2 -163.1]) (r 4.5) (fill fg))
    (circle _ (pos [35.8 -75.9]) (r 4.5) (fill fg))
    (circle _ (pos [110 -64]) (r 4.5) (fill fg))
    (circle _ (pos [144.2 -88.9]) (r 4.5) (fill fg))
    (circle _ (pos [131.2 -129.1]) (r 4.5) (fill fg))
    (circle _ (pos [88.8 -129.1]) (r 4.5) (fill fg))
    (circle _ (pos [75.8 -88.9]) (r 4.5) (fill fg))
    (text _ '(a) G: no cycle of length' (pos [110 -204]) (halign 'middle') (font note) (fill muted))
    (text _ 'at most ℓ = 4' (pos [110 -220]) (halign 'middle') (font note) (fill muted)))

  ; A subgraph H of the Petersen graph. Removed edges are dashed, among them the spoke from u to v; a path of length 4 from u to v that stays in H is highlighted.
  (group subgraph
    (line _ (from [110 -22]) (to [184.2 -75.9]) (stroke teal) (stroke-width 3))
    (line _ (from [184.2 -75.9]) (to [155.8 -163.1]) (stroke fg) (stroke-width 1.5))
    (line _ (from [155.8 -163.1]) (to [64.2 -163.1]) (stroke muted) (stroke-width 1.2) (opacity 0.6))  ; dashed in the original
    (line _ (from [64.2 -163.1]) (to [35.8 -75.9]) (stroke fg) (stroke-width 1.5))
    (line _ (from [35.8 -75.9]) (to [110 -22]) (stroke fg) (stroke-width 1.5))
    (line _ (from [110 -22]) (to [110 -64]) (stroke coral) (stroke-width 2))  ; dashed in the original
    (line _ (from [184.2 -75.9]) (to [144.2 -88.9]) (stroke teal) (stroke-width 3))
    (line _ (from [155.8 -163.1]) (to [131.2 -129.1]) (stroke fg) (stroke-width 1.5))
    (line _ (from [64.2 -163.1]) (to [88.8 -129.1]) (stroke fg) (stroke-width 1.5))
    (line _ (from [35.8 -75.9]) (to [75.8 -88.9]) (stroke muted) (stroke-width 1.2) (opacity 0.6))  ; dashed in the original
    (line _ (from [110 -64]) (to [131.2 -129.1]) (stroke fg) (stroke-width 1.5))
    (line _ (from [144.2 -88.9]) (to [88.8 -129.1]) (stroke teal) (stroke-width 3))
    (line _ (from [131.2 -129.1]) (to [75.8 -88.9]) (stroke muted) (stroke-width 1.2) (opacity 0.6))  ; dashed in the original
    (line _ (from [88.8 -129.1]) (to [110 -64]) (stroke teal) (stroke-width 3))
    (line _ (from [75.8 -88.9]) (to [144.2 -88.9]) (stroke fg) (stroke-width 1.5))
    (circle _ (pos [110 -22]) (r 4.5) (fill coral))
    (circle _ (pos [184.2 -75.9]) (r 4.5) (fill fg))
    (circle _ (pos [155.8 -163.1]) (r 4.5) (fill fg))
    (circle _ (pos [64.2 -163.1]) (r 4.5) (fill fg))
    (circle _ (pos [35.8 -75.9]) (r 4.5) (fill fg))
    (circle _ (pos [110 -64]) (r 4.5) (fill coral))
    (circle _ (pos [144.2 -88.9]) (r 4.5) (fill fg))
    (circle _ (pos [131.2 -129.1]) (r 4.5) (fill fg))
    (circle _ (pos [88.8 -129.1]) (r 4.5) (fill fg))
    (circle _ (pos [75.8 -88.9]) (r 4.5) (fill fg))
    (text _ 'u' (pos [118 -18]) (font label) (fill fg))
    (text _ 'v' (pos [117 -78]) (font label) (fill fg))
    (text _ '(b) a subgraph H; removed' (pos [110 -204]) (halign 'middle') (font note) (fill muted))
    (text _ 'edges dashed' (pos [110 -220]) (halign 'middle') (font note) (fill muted))))

(canvas petersen-view (view-x 0) (view-y -230)
  (view-width 220) (view-height 230) petersen)
(canvas subgraph-view (view-x 0) (view-y -230)
  (view-width 220) (view-height 230) subgraph)
