; Line styles: how a stroke ends, how it turns a corner, and how it is dashed. The buttons pick
; the ends (line-cap) and the corners (line-join), and the slider sets the stroke's width. The
; thin lines show where each shape ends: a 'round' or 'square' end reaches past it by half the
; width. The dashed line takes its dash and gap from the sliders, and with the 'round' end and
; no dash, each dash is a dot. Round the circle, the dashes march: the animation moves the
; outline's dash-offset.

(import ease linear)

(color paper '#f7f4ee')
(color ink '#23303f')
(color soft '#9aa3ad')
(color warm '#d1603d')
(color cool '#2f7f86')
(font small (size 13))
(font mono (family 'ui-monospace, monospace') (size 13))

; The four panels sit on a two by two grid: cell (col, row) is the center of one, row 0 on top.
(func[point] cell ((int col) (int row)) [(* 8 (- col 0.5)) (- 2.6 (* 4.6 row))])
; Half the length of the two lines, and where a caption sits from its panel's center.
(real half 2.5 (const))
(point under [0 -1.9] (const))

(type cap string (one-of 'butt' 'round' 'square'))
(type join string (one-of 'miter' 'round' 'bevel'))

(scene styles (background paper)
  (cap ends 'round')
  (join corners 'miter')
  (real width 18 (>= 2) (<= 32))
  (real dash-length 14 (>= 0) (<= 30))
  (real gap-length 10 (>= 2) (<= 30))

  ; How a stroke ends: a thick line, with thin ones where it ends and along its middle.
  (group ends-panel (translate (cell 0 0))
    (line thick (from [(- half) 0]) (to [half 0]) (stroke warm) (stroke-width width)
        (line-cap ends))
    (group guides (defaults (stroke ink) (stroke-width 1))
      (line_ (from (+ (left thick) [0 -0.8])) (to (+ (left thick) [0 0.8])))
      (line_ (from (+ (right thick) [0 -0.8])) (to (+ (right thick) [0 0.8])))
      (line_ (from (left thick)) (to (right thick)))))

  ; How it turns a corner: a sharp triangle's outline, with a thin one along its middle.
  (group corners-panel (translate (cell 1 0))
    (triangle outline (a [-2.6 -1]) (b [2.6 -1]) (c [-0.8 1]) (fill none) (stroke cool)
        (stroke-width width) (line-join corners))
    (triangle_ (a outline.a) (b outline.b) (c outline.c) (fill none) (stroke ink)
        (stroke-width 1)))

  ; A dash pattern from the sliders, with the ends the buttons pick.
  (line pattern (translate (cell 0 1)) (from [(- half) 0]) (to [half 0]) (stroke ink)
      (stroke-width (/ width 2)) (dash [dash-length gap-length]) (line-cap ends))

  ; Marching dashes: the animation moves the ring's dash-offset by two patterns.
  (group march-panel (translate (cell 1 1))
    (circle dot (r 0.5) (fill warm) (stroke none))
    (circle ring (r 1.4) (fill none) (stroke cool) (stroke-width 3) (dash [9 6])
        (line-cap 'round')))

  ; Each caption sits the same way under its panel's center, so the two in a row line up.
  (group captions (defaults (fill soft) (font mono) (halign 'middle') (valign 'top'))
    (text_ $'(line-cap \'{ends}\')' (pos (+ (cell 0 0) under)))
    (text_ $'(line-join \'{corners}\')' (pos (+ (cell 1 0) under)))
    (text_ $'(dash [{dash-length:.0f} {gap-length:.0f}])' (pos (+ (cell 0 1) under)))
    (text_ '(move ring.dash-offset …)' (pos (+ (cell 1 1) under)))))

(canvas view (x -8) (y -4.8) (width 16) (height 9) (pan false) (zoom false)
    (doc 'The ends, the corners, the dashes and the marching ring.')
  ends-panel corners-panel pattern march-panel captions)

(play march (autoplay view)
    (doc 'Marches the dashes round the circle.')
    (animation (loop) (move ring.dash-offset (from 0) (to -30) (duration 1.5) (ease linear))))

(button butt (animation (move ends (to 'butt') (duration 0))) (label 'butt')
    (doc 'Gives the lines butt ends.'))
(button round-ends (animation (move ends (to 'round') (duration 0))) (label 'round')
    (doc 'Gives the lines round ends.'))
(button square (animation (move ends (to 'square') (duration 0))) (label 'square')
    (doc 'Gives the lines square ends.'))
(button miter (animation (move corners (to 'miter') (duration 0))) (label 'miter')
    (doc 'Gives the corners a miter join.'))
(button round-corners (animation (move corners (to 'round') (duration 0))) (label 'round')
    (doc 'Gives the corners a round join.'))
(button bevel (animation (move corners (to 'bevel') (duration 0))) (label 'bevel')
    (doc 'Gives the corners a bevel join.'))
(slider thickness (move width (from 2) (to 32)) (label 'width'))
(slider dash-slider (move dash-length (from 0) (to 30)) (label 'dash'))
(slider gap-slider (move gap-length (from 2) (to 30)) (label 'gap'))
