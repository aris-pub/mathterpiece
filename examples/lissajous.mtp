; A Lissajous curve: the point (sin(a t + phase), sin(b t)) as t goes once around. The curve is
; one polyline through 721 points, and its points are a map over a range, so it is drawn again
; whenever a slider moves a, b or the phase. Try the frequencies 1 and 2, then 3 and 2, then
; press 'turn the phase'.

(import house paper ink soft teal variable code)
(import ease linear)
(import marks)

(scene board (background paper)
  ; Whole frequencies close the curve after one turn of t, so the ratio a:b is what it shows.
  (int a 3 (>= 1) (<= 7))
  (int b 2 (>= 1) (<= 7))
  (real phase 90 (>= 0) (<= 360))

  ; The curve fills the square from -1 to 1; the axes run a little past it, and the texts
  ; are placed against the axes, which stay put while the curve changes.
  (real reach 1.2 (const))
  (real gap 0.08 (const))
  (marks.axes axes (left (- reach)) (right reach) (bottom (- reach)) (top reach) (stroke soft)
              (defaults (stroke-opacity 0.6)))

  (polyline curve
      (points (map (range 0 360 (num 721))
                   (fn t [(sind (+ (* a t) phase)) (sind (* b t))])))
      (stroke teal) (stroke-width 3) (line-join 'round') (line-cap 'round'))

  (text ratio $'a : b = {a} : {b}' (pos (top axes gap)) (halign 'middle') (valign 'bottom')
      (font variable) (fill ink))

  (group forms (defaults (fill soft) (font code) (halign 'start') (valign 'top'))
    (let ((under (bottom-left axes gap)))
      (text_ '(polyline curve (points (map (range 0 360 (num 721))' (pos under))
      ; The second line is indented, as code that goes on would be.
      (text_ $'  (fn t [(sind (+ (* {a} t) {phase:.0f})) (sind (* {b} t))]))))'
          (pos (+ under [0 -0.14]))))))

(canvas view (x -1.78) (y -1.67) (width 3.56) (height 3.17) (pan false) (zoom false)
    (doc 'The curve, its axes and the ratio a:b.')
  axes curve ratio forms)

(slider freq-a (move a (from 1) (to 7)) (step 7) (label 'frequency a, across'))
(slider freq-b (move b (from 1) (to 7)) (step 7) (label 'frequency b, up'))
(slider turn (move phase (from 0) (to 360)) (label 'phase'))

; Slowly enough that each frame is still a curve the eye can follow.
(play spin (label 'turn the phase')
    (doc 'Turns the phase once every eight seconds, again and again.')
    (animation (loop) (move phase (from 0) (to 360) (duration 8) (ease linear))))

(readout ratio-now $'{a}:{b}' (font variable) (doc 'The ratio a:b.'))
