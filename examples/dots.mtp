; 150 random dots, each colored by the outlined circle it touches: teal, red, or gray when it
; touches neither. Reload the page to draw new dots.
(scene world
  (group circles
    (circle teal-c (r 3.5) (x -5.0) (y 4.0) (stroke 'teal') (stroke-width 3) (fill none))
    (circle red-c (r 1.2) (x 3.5) (y -2.0) (stroke 'red') (stroke-width 3) (fill none)))
  ; Each dot's radius and center are scene variables, because a shape cannot read its own
  ; attributes in its own declaration, and its color depends on both.
  (repeat 150 i
    (real (name $'size{i}') (rand 0 0.25) (>= 0) (<= 0.25))
    (point (name $'at{i}') [(rand -10 10) (rand -10 10)]))
  (group dots
    (repeat 150 i
      (circle (name $'dot{i}')
        (r (name $'size{i}')) (pos (name $'at{i}')) (opacity 0.25)
        (fill
          (let ((size (name $'size{i}')) (at (name $'at{i}')))
            (cond
              ((< (dist at teal-c.pos) (+ size teal-c.r)) teal-c.stroke)
              ((< (dist at red-c.pos) (+ size red-c.r)) red-c.stroke)
              (else 'gray'))))))))

(canvas cnv dots circles)
