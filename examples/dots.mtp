(scene 'world'
  (group 'circles'
    (circle 'teal_c' (r 3.5) (x -5.0) (y 4.0) (stroke 'teal') (stroke-width 1.5) (fill 'none'))
    (circle 'red_c' (r 1.2) (x 3.5) (y -2.0) (stroke 'red') (stroke-width 1.5) (fill 'none')))
  (group 'dots'
    (repeat i 150
      (circle $'dot{i}'
        (r (rand 0 0.25)) (x (rand -10 10)) (y (rand -10 10)) (opacity 0.25)
        (fill
          (cond
            ((< (dist self teal_c) (+ self.r teal_c.r)) teal_c.stroke)
            ((< (dist self red_c) (+ self.r red_c.r)) red_c.stroke)
            (else 'gray')))))))

(canvas 'cnv' dots circles)
