; The colors and fonts the examples share. Not a figure: each example imports what it uses.

(color paper '#f6f1e7')
(color ink '#1f2a44')
(color soft '#8a93a6')
(color terracotta '#e76f51')
(color teal '#2a9d8f')
(color saffron '#e9c46a')
(color plum '#6d597a')

; The fonts by what they are for, each from a family of the standard library: restyling the
; family (--mtp-fonts-serif-family) restyles every font built from it.
(import fonts serif mono)
(font variable (family serif.family) (style 'italic') (size 18))
(font number (family mono.family) (size 14))
(font code (family mono.family) (size 13))
