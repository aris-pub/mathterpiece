; Drag the points. The space: a center c at distance 1 from three leaves u, v, w, which are at
; distance 2 from each other. The distortion of a drawing is how much it stretches the most
; stretched pair, divided by how much it stretches the least stretched pair. No drawing in the
; plane does better than 2/sqrt(3), the three leaves at 120 degrees around c.
; Stroke widths and font sizes are in screen pixels.

(import ease cubic-in-out)

(color paper (light-dark '#f7f3ea' '#272522'))
(color ink (light-dark '#1f2a44' '#e8e4d8'))
(color accent (light-dark '#e76f51' '#f08a6c'))
; Point names are math variables, so they are italic.
(font variable (style 'italic') (size 19))
(font big (size 22))
(font small (size 16))

; How much a drawing stretches each pair, against its distance in the space: the most stretched
; pair divided by the least stretched. Two points drawn on top of each other give none.
(func distortion-of ((point c) (point u) (point v) (point w))
  (let ((cu (dist c u)) (cv (dist c v)) (cw (dist c w))
        (uv (/ (dist u v) 2)) (vw (/ (dist v w) 2)) (wu (/ (dist w u) 2))
        (most (max cu cv cw uv vw wu))
        (least (min cu cv cw uv vw wu)))
    (/ most least)))

(scene plane (background paper)
  (group points (defaults (fill ink))
    (circle c (pos [0 0]) (r 0.1) (fill accent))
    (circle u (pos (polar 1 90)) (r 0.1))
    (circle v (pos (polar 1 210)) (r 0.1))
    (circle w (pos (polar 1 330)) (r 0.1)))

  (group edges (defaults (stroke ink))
    (group spokes (defaults (stroke-width 2))
      (line_ (from c.pos) (to u.pos))
      (line_ (from c.pos) (to v.pos))
      (line_ (from c.pos) (to w.pos)))
    (group rim (defaults (stroke-width 1) (stroke-opacity 0.4))
      (line_ (from u.pos) (to v.pos))
      (line_ (from v.pos) (to w.pos))
      (line_ (from w.pos) (to u.pos))))

  (real|none measured (distortion-of c.pos u.pos v.pos w.pos))

  (group labels (defaults (fill ink))
    (foreach p points
      (text_ p.name (pos (top-right p 0.03)) (font variable)))
    (text_ (or? $'distortion {measured:.3f}' 'distortion inf') (pos [-3.15 1.93]) (font big))
    (text_ $'best possible {(/ 2 (sqrt 3)):.3f}' (pos [1.17 1.93]) (font small) (opacity 0.6))))

(readout distortion (or? $'{measured:.3f}' 'inf')
  doc@'The distortion of the drawing as it is now.')

; The edges are declared after the points they join, but drawn under them, so the reader can
; always grab a point.
(canvas view (x -3.3) (y -2.3) (width 6.6) (height 4.6)
  doc@'The center, the three leaves, their edges and the distortion.'
  edges points labels)

(foreach p points
  (on-drag p p.pos doc@'Moves the point.'))

(animation optimum
  (at-once (defaults (duration 0.8) (ease cubic-in-out))
    (move c.pos (to [0 0]))
    (move u.pos (to (polar 1 90)))
    (move v.pos (to (polar 1 210)))
    (move w.pos (to (polar 1 330)))))
(animation on-a-line
  (at-once (defaults (duration 0.8) (ease cubic-in-out))
    (move c.pos (to [0 0]))
    (move u.pos (to [-1 0]))
    (move v.pos (to [1 0]))
    (move w.pos (to [2 0]))))

(button best (animation optimum) (label 'show the optimum'))
(button line (animation on-a-line) (label 'collapse onto a line'))
