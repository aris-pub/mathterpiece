; Rows and columns: groups that place their members one after another. Change the gap and the
; size with the sliders, line the row up by its top, middle or bottom with the buttons, and take
; the circle out of the row with the toggle: the shapes after it close up. The tall rect is
; nudged right by its own translate, and the ellipse follows it. Under the row, a second row
; holds a column of rows, the grid, and a column of bars lined up on the left. The two rows are
; themselves a column lined up on the left, so the second sits under the first wherever that
; row's bottom is. Each caption sits under what it names.

(import house paper soft terracotta teal saffron plum)
(font small (size 13))

; How the row lines its members up: by their top edges, their middles or their bottom edges.
(type edge string (one-of 'top' 'middle' 'bottom'))

(scene board (background paper)
  (real gap 0.4 (>= 0) (<= 1))
  (real grow 1 (>= 0.4) (<= 1.6))
  (edge line-up 'middle')
  (bool with-circle true)

  ; The gap leaves room for the first row's caption.
  (column rows (translate [-5.6 2.4]) (gap 1.5) (align 'left')
    (row shelf (gap gap) (align line-up) (defaults (stroke none))
      (rect a (width 1) (height 1) (fill terracotta))
      (circle|none b (r (* 0.6 grow)) (fill teal))
      (exists-when b with-circle)
      (rect c (width 1.2) (height (* 1.8 grow)) (fill saffron) (translate [0.3 0]))
      (ellipse d (rx 0.9) (ry (* 0.5 grow)) (fill plum)))

    (row lower (gap 2.5) (align 'top')
      (column grid (gap (/ gap 2))
        (foreach r 3
          (row_ (gap (/ gap 2)) (defaults (stroke none))
            (foreach k 3
              (rect_ (width 0.6) (height 0.6)
                  (fill (cond ((= (mod (+ r k) 3) 0) terracotta) ((= (mod (+ r k) 3) 1) saffron)
                              (else plum))))))))
      (column bars (gap (/ gap 2)) (align 'left') (defaults (fill teal) (stroke none))
        (foreach i 4
          (rect_ (width (+ 0.6 (* 0.5 grow i))) (height 0.35))))))

  (group captions (defaults (fill soft) (font small) (halign 'middle') (valign 'top'))
    (let ((under 0.5))
      (text_ $'a row, lined up by its {line-up}' (pos (bottom shelf under)))
      (text_ 'a column, lined up on the left' (pos (bottom bars under)))
      (text_ 'a column of rows' (pos (bottom grid under))))))

(canvas view (x -7) (y -5.2) (width 14) (height 9.8) (pan false) (zoom false)
    (doc 'The rows and columns, and their captions.')
  rows captions)

(slider spacing (move gap (from 0) (to 1)) (label 'gap'))
(slider size (move grow (from 0.4) (to 1.6)) (label 'size'))

(foreach alignment ['top' 'middle' 'bottom']
  (button (name $'my-{alignment}') (animation (move line-up (to alignment) (duration 0.5)))
      (label alignment) (doc 'Lines the row up by its top, middle or bottom.')))

(toggle circle-in-row with-circle (label 'the circle')
    (doc 'Takes the circle out of the row, or puts it back.'))
