(const 'golden' (* 180 (- 3 (sqrt 5))))
(const 'gold' '#f6c453')
(const 'starlight' '#c9d6ff')

; Seed color by how far out the seed is, from 0 at the center to 1 at the edge.
(func 'seed-color' (params (t 0.0))
  (cond
    ((< t 0.15) '#9a4f16')
    ((< t 0.4) '#cf7424')
    ((< t 0.7) '#e89b2a')
    ((< t 0.9) gold)
    (else '#fff1b8')))

; Seeds on a golden-angle spiral: seed i sits at radius (sqrt i), turned i golden angles.
(motif 'sunflower' (params (n 400) (spread 0.3) (size 0.11))
  (repeat i n
    (let ((a (* i golden)) (d (* spread (sqrt i))) (t (/ i n)))
      (circle _
        (pos (polar d a))
        (r (* size (sqrt (+ 1 (/ i 80)))))
        (opacity (lerp 0.8 1 t))
        (fill (seed-color t))))))

; Stacked translucent disks read as a soft glow that fades outward.
(motif 'glow' (params (layers 14) (radius 8.0))
  (repeat k layers
    (circle _ (r (* radius (/ (+ k 1) layers))) (fill-opacity 0.035))))

(motif 'orbit' (params (count 12) (radius 5.0) (size 0.3))
  (repeat k count
    (let ((a (turn (/ k count))))
      (circle _
        (pos (polar radius a))
        (r (* size (lerp 0.55 1 (cosd (* 3 a)))))
        (opacity (lerp 0.4 1 (sind (/ a 2))))))))

; A flower with its glow and an optional ring of moons, all centered on the flower.
(motif 'bloom' (params (n 400) (spread 0.3) (size 0.11) (halo 8.5) (moons 0) (moon-radius 7.0))
  (glow 'aura' (radius halo))
  (sunflower 'seeds' (n n) (spread spread) (size size))
  (orbit 'ring' (count moons) (radius moon-radius) (size 0.16) (fill '#5fd3c6')))

(scene 'night'
  (circle 'sky' (r 15) (fill '#0b1026'))

  (bloom 'big' (x -2.8) (y 2.2) (fill gold) (moons 60))
  (bloom 'small' (x 6.3) (y -5.9) (fill '#ff8c42') (n 160) (spread 0.25) (size 0.08) (halo 4.4))

  ; Stars take the color of whichever flower they drift near.
  (group 'stars'
    (repeat i 320
      (circle _ (pos [(rand -10 10) (rand -10 10)]) (r (rand 0.015 0.07)) (opacity (rand 0.25 1))
        (fill
          (cond
            ((< (dist self big) big.moon-radius) big.fill)
            ((< (dist self small) small.halo) small.fill)
            (else starlight))))))

  (text 'title' 'the golden angle' (x 2.3) (y 9.3) (font-size 0.6) (fill gold))
  (text 'subtitle' $'{golden:.3f}°' (x 2.4) (y 8.5) (font-size 0.5) (fill starlight) (opacity 0.55)))

(canvas 'cnv' (transform (rotate -8)) night)
