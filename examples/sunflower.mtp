; Seeds on a golden-angle spiral: seed i sits at radius (sqrt i), turned i times 137.508 degrees.
(compound 'sunflower' (params (n 400) (spread 0.3) (size 0.11))
  (repeat i n
    (circle _
      (x (* spread (sqrt i) (cosd (* i 137.508))))
      (y (* spread (sqrt i) (sind (* i 137.508))))
      (r (* size (sqrt (+ 1 (/ i 80)))))
      (opacity (+ 0.8 (* 0.2 (/ i n))))
      (fill
        (cond
          ((< i (* 0.15 n)) '#9a4f16')
          ((< i (* 0.4 n)) '#cf7424')
          ((< i (* 0.7 n)) '#e89b2a')
          ((< i (* 0.9 n)) '#f6c453')
          (else '#fff1b8'))))))

; Stacked translucent disks read as a soft glow that fades outward.
(compound 'glow' (params (layers 14) (radius 8.0))
  (repeat k layers
    (circle _ (r (* radius (/ (+ k 1) layers))) (fill-opacity 0.035))))

(compound 'orbit' (params (count 12) (radius 5.0) (size 0.3))
  (repeat k count
    (circle _
      (x (* radius (cosd (/ (* 360 k) count))))
      (y (* radius (sind (/ (* 360 k) count))))
      (r (* size (+ 0.55 (* 0.45 (cosd (/ (* 1080 k) count))))))
      (opacity (+ 0.4 (* 0.6 (sind (/ (* 180 k) count))))))))

(circle 'sky' (r 15) (fill '#0b1026'))

(glow 'big-glow' (x -2.8) (y 2.2) (fill '#f6c453') (radius 8.5))
(sunflower 'big' (x -2.8) (y 2.2))
(orbit 'ring' (x -2.8) (y 2.2) (radius 7.0) (count 60) (size 0.16) (fill '#5fd3c6'))

(glow 'small-glow' (x 6.3) (y -5.9) (fill '#ff8c42') (radius 4.4) (layers 10))
(sunflower 'small' (x 6.3) (y -5.9) (n 160) (spread 0.25) (size 0.08))

; Stars take the color of whichever flower they drift near.
(group 'stars'
  (repeat i 320
    (circle _ (x (rand -10 10)) (y (rand -10 10)) (r (rand 0.015 0.07)) (opacity (rand 0.25 1))
      (fill
        (cond
          ((< (dist self big) 7.6) '#f6c453')
          ((< (dist self small) 3.8) '#ff8c42')
          (else '#c9d6ff'))))))

(text 'title' 'the golden angle' (x 1.5) (y 8.9) (fill '#f6c453'))
(text 'subtitle' '137.508°' (x 1.6) (y 8.1) (fill '#c9d6ff') (opacity 0.55))

(canvas 'cnv' (transform (rotate -8))
  sky big-glow small-glow stars ring big small title subtitle)
