; Placing shapes against others. Turn and resize the card with the sliders: a dot marks each of
; the eight points on its box, (top card), (top-right card) and so on, and each point's name
; sits just outside it. Drag the ball: its name rides at its top-right, a line runs from the
; card's right side to the ball's left, and the caption stays under both. Drag the flag: its
; label sits at its tip, a point the flag's motif marks with a transparent circle.

(import house paper ink soft terracotta teal)
(font small (size 13))
(font name (style 'italic') (size 16))

; Whatever is placed at the tip follows the flag wherever it is moved.
(motif flag ()
  doc@'A flag on a pole, with a transparent circle at its tip, the top of the pole.'
  (line pole (from [0 0]) (to [0 2]) (stroke ink) (stroke-width 2))
  (triangle banner (a [0 2]) (b [1.2 1.6]) (c [0 1.2]) (fill terracotta) (stroke none))
  (circle tip (pos [0 2]) (r 0) (fill none) (stroke none)))

(scene board (background paper)
  (real w 3 (>= 0.5) (<= 5))
  (real h 1.6 (>= 0.5) (<= 3))
  (real turn 0)

  (group both
    (rect card (width w) (height h) (transform (rotate turn)) (fill none) (stroke ink)
        (stroke-width 1.5))
    (circle ball (pos [4.5 -1.5]) (r 0.35) (fill teal) (stroke none)))

  ; A dot at each point of the card's box, and the point's name just outside it. A corner's name
  ; is pushed out on two sides, so it takes a smaller gap to look as far away as a side's.
  (group marks (defaults (fill terracotta) (stroke none))
    (foreach p [(top card) (bottom card) (left card) (right card)
                (top-left card) (top-right card) (bottom-left card) (bottom-right card)]
      (circle_ (pos p) (r 0.07))))
  (group names (defaults (fill soft) (font small))
    (let ((side 0.15) (corner 0.1))
      (text_ 'top' (pos (top card side)) (halign 'middle') (valign 'bottom'))
      (text_ 'bottom' (pos (bottom card side)) (halign 'middle') (valign 'top'))
      (text_ 'left' (pos (left card side)) (halign 'end') (valign 'middle'))
      (text_ 'right' (pos (right card side)) (halign 'start') (valign 'middle'))
      (text_ 'top-left' (pos (top-left card corner)) (halign 'end') (valign 'bottom'))
      (text_ 'top-right' (pos (top-right card corner)) (halign 'start') (valign 'bottom'))
      (text_ 'bottom-left' (pos (bottom-left card corner)) (halign 'end') (valign 'top'))
      (text_ 'bottom-right' (pos (bottom-right card corner)) (halign 'start') (valign 'top'))))

  ; The ball's name, a line from the card to the ball, and a caption under both.
  (text ball-name 'ball' (pos (top-right ball 0.05)) (valign 'bottom') (font name) (fill ink))
  (line tether (from (right card)) (to (left ball)) (stroke teal) (stroke-width 1))
  (text caption 'the card and the ball' (pos (bottom both 0.6)) (halign 'middle') (valign 'top')
      (font small) (fill ink))

  (flag pennant (pos [-5 -3.5]))
  (text pennant-name 'flag' (pos pennant.tip.pos) (halign 'middle') (valign 'bottom')
      (font name) (fill ink)))

(canvas view (x -7) (y -4.5) (width 14) (height 9) (pan false) (zoom false)
  doc@'The card and its eight points, the ball, and the flag.'
  both marks names ball-name tether caption pennant pennant-name)

(slider width (move w (from 0.5) (to 5)) (label 'width') doc@'Sets the card\'s width.')
(slider height (move h (from 0.5) (to 3)) (label 'height') doc@'Sets the card\'s height.')
(slider spin (move turn (from 0) (to 90)) (label 'turn') doc@'Turns the card.')
(on-drag ball ball.pos doc@'Moves the ball.')
(on-drag pennant pennant.pos doc@'Moves the flag.')
