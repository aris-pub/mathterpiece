; Drag the sliders: chords join point k to point m*k, and the curve they trace changes with m.
; Stroke widths and font sizes are in screen pixels, chosen for a canvas 640 pixels wide.

(color slate '#0e1726')
(color chalk '#e8e4d8')
(font small (size 19))

(func on-circle ((real radius) (real k) (int n (>= 1)))
  (polar radius (turn (/ k n))))

(motif times-table ((int n 200 (>= 1) (const)) (real m 2) (real radius 8 (>= 0)) (real turn 0))
  (group figure (transform (rotate turn))
    (circle rim (r radius) (fill none) (stroke-width 1.25) (stroke-opacity 0.6))
    (repeat n k
      (line_
        (from (on-circle radius k n))
        (to (on-circle radius (* m k) n))
        (stroke-width 1)
        (stroke-opacity (lerp 0.2 0.85 (/ k n)))))))

(scene board
  (background slate)
  (times-table table (m 2) (turn -90) (stroke '#ffb703'))
  (text caption $'times {table.m:g}' (pos [-9.4 -9.4]) (font small) (fill chalk)))

(canvas cnv board)
(slider multiplier (move table.m (from 2) (to 40)) (label 'times'))
(slider spin (move table.turn (from -180) (to 180)) (label 'rotate'))
; Going back to 2 means nothing when times is already 2.
(button reset
  (animation (move table.m (to 2) (duration 2) (ease 'ease-in-out')))
  (label 'back to 2')
  (when (!= table.m 2)))
