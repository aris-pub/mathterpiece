; One density versus all densities, from the Bourgain notes (Figure 7). The space has L levels,
; n = 2^L points. A random set of density p = 2^-t stretches a pair at level h in proportion to
; P_h(p) = 2r(1 - r), with r = (1 - p)^(2^(h - 1)). Top: the relative stretch at each level,
; sqrt(x / max). Bottom: the distortion, sqrt(max / min) over the levels, against the density,
; on a log scale; the flat line is the distortion when all densities 2^-1 to 2^-L are used
; together. Drag the handle under the top chart to change the number of levels, and the one under
; the bottom chart to change the density; "one" and "all" switch between one density and all of
; them. Press play for a tour in three steps.
; Coordinates are the original SVG's at a width of 480, with y pointing up.

(color fg (light-dark '#1f2328' '#e6e1d6'))
(color muted (light-dark '#6b7280' '#9aa1ad'))
(color bg (light-dark '#faf7f0' '#272522'))
(color rule (light-dark '#d8d3c4' '#4a463e'))
(color grid (light-dark '#e8e5dc' '#36332d'))
(color one (light-dark '#7f8da0' '#a9b5c6'))
(color every (light-dark '#1a6f66' '#4cb8aa'))
(font plain (size 13))
(font tick (size 12))
(font strong (size 13) (weight 600))
(font var (size 13) (style 'italic'))

(list[(int (>= 1) (<= 10))] levels (range 1 10 (num 10)) (const))

; The samples of the curve: the original steps the density's exponent by 0.05 over a span of L,
; which is 20 L + 1 points; 201 samples spread over the span give the same curve at L = 10.
(list[(int (>= 0) (<= 200))] samples (range 0 200 (num 201)) (const))

(func P ((int h (>= 1) (<= 10)) (real p (>= 0) (<= 1)))
  (let ((r (^ (- 1 p) (^ 2 (- h 1))))) (* 2 r (- 1 r))))

; P at each level for density 2^-t, and pad past level LL, so max and min can skip those levels.
(func single ((real LL) (real t (>= 0)) (real pad))
  (map levels (fn h (if (<= h LL) (P h (^ 2 (- t))) pad))))

; With all densities: level h gets the sum over j = 1 to LL of P_h(2^-j).
(func all-at ((real LL) (int h (>= 1) (<= 10)))
  (sum (map levels (fn j (if (<= j LL) (P h (^ 2 (- j))) 0)))))
(func every-level ((real LL) (real pad))
  (map levels (fn h (if (<= h LL) (all-at LL h) pad))))

; sqrt(max / min). A density far from every level leaves some level with P too close to 0 to
; divide by; the original shows that as a power of ten, and 10^150 is the largest number allowed.
(func spread-of ((real mx) (real mn))
  (if (> mn 1e-300) (or? (sqrt (/ mx mn)) 1e150) 1e150))
(func spread ((real LL) (real t (>= 0))) (spread-of (max (single LL t 0)) (min (single LL t 1))))
(func spread-all (real LL) (spread-of (max (every-level LL 0)) (min (every-level LL 1))))

; The relative stretch at each level, sqrt(x / max), mixed between one density (mx = 0) and all
; densities (mx = 1).
(func stretch ((real LL) (real t (>= 0)) (real mx) (real pad))
  (let ((s (single LL t 0)) (a (every-level LL 0)) (ms (max s)) (ma (max a)))
    (map levels
         (fn h (if (<= h LL)
                   (+ (* (- 1 mx) (or? (sqrt (/ (P h (^ 2 (- t))) ms)) 0))
                      (* mx (or? (sqrt (/ (all-at LL h) ma)) 0)))
                 pad)))))

; The best single density for LL levels: the original searches the exponent from 0.3 to LL + 1
; in steps of 0.005. Here a search in steps of 0.05, then one in steps of 0.005 around the best
; of those, splitting each range in halves so the recursion stays shallow. Each result is
; [distortion exponent].
(type pair list[real] (length 2))
(func lower ((pair l) (pair r)) (if (<= l[0] r[0]) l r))
(func best-in ((real LL) (real a (>= 0)) (real step (>= 0) (<= 1)) (int n))
  (if (<= n 1)
      (lower [(spread LL a) a] [(spread LL a) a])
    (let ((half (floor (/ n 2))))
      (lower (best-in LL a step half)
             (best-in LL (max 0 (+ a (* step half))) step (- n half))))))
(func best (real LL)
  (let ((coarse (best-in LL 0.3 0.05 (+ 15 (* 20 (round LL))))))
    (best-in LL (max 0 (- (or? coarse[1] 1) 0.05)) 0.005 21)))
; Only the tour shows the best density, and only at 4, 6, 8 and 10 levels.
(list bests [(best 4) (best 6) (best 8) (best 10)] (const))
(func best-of (real LL)
  (cond ((= LL 4) bests[0]) ((= LL 6) bests[1]) ((= LL 8) bests[2]) (else bests[3])))

; Numbers as the original shows them: from 1000 up as a power of ten.
(func sup-digit (int d)
  (cond ((= d 0) '⁰') ((= d 1) '¹') ((= d 2) '²') ((= d 3) '³') ((= d 4) '⁴')
        ((= d 5) '⁵') ((= d 6) '⁶') ((= d 7) '⁷') ((= d 8) '⁸') (else '⁹')))
(func sup (int k)
  (cond ((>= k 100) $'{(sup-digit (floor (/ k 100)))}{(sup-digit (mod (floor (/ k 10)) 10))}{(sup-digit (mod k 10))}')
        ((>= k 10) $'{(sup-digit (floor (/ k 10)))}{(sup-digit (mod k 10))}')
        (else (sup-digit k))))
(func fmt (real x)
  (cond ((>= x 1000) $'≈ 10{(sup (round (log (max 1 (min x 1e150)) 10)))}')
        ((>= x 10) $'{x:.1f}')
        (else $'{x:.2f}')))

; The vertical position, in the bottom chart, of a distortion v.
(list[real] ticks [1 2 5 10 100 1000] (const))
(list[string] tick-names ['1' '2' '5' '10' '100' '1000'] (const))
(func cy (real v) (+ -114 (* (max 0 (min 1 (/ (log (max v 1) 10) 3))) 106)))

; Its tip is where a guide line ends.
(motif handle ((color edge (light-dark '#7f8da0' '#a9b5c6')) (real weight 1.5 (>= 0)))
  doc@'A pill with three grip lines, with its tip at the middle of its top edge.'
  (rect body (width 22) (height 12) (rx 6) (ry 6) (fill bg) (stroke edge) (stroke-width weight))
  (circle tip (pos [0 6]) (r 0) (fill none) (stroke none))
  (group grip (defaults (stroke edge) (stroke-width 1))
    (line_ (from [-3 -3]) (to [-3 3]))
    (line_ (from [0 -3]) (to [0 3]))
    (line_ (from [3 -3]) (to [3 3]))))

(scene figure
  ; The state: L levels, density 2^-t, mix from one density (0) to all (1); while the number of
  ; levels changes from Lp to L, g goes from 0 to 1.
  (int L 10 (>= 2) (<= 10))
  (int Lp 10 (>= 2) (<= 10))
  (real g 1 (>= 0) (<= 1))
  (real t 1 (>= 0.5) (<= 10.5))
  (real mix 0 (>= 0) (<= 1))
  (bool floor false)
  ; The tour step now shown (0 to 2), and whether the reader has left the tour.
  (int chapter 0 (>= 0) (<= 2))
  (bool exploring false)

  ; The original lowers t to L + 1/2 whenever the reader lowers L; a drag writes only L, so the
  ; limit is applied where t is read.
  (real te (min t (+ L 0.5)))
  (real lv (max 2 (+ Lp (* (- L Lp) g))))
  (bool all (> mix 0.5))
  ; A control the current tour step does not move is drawn grey.
  (bool n-on (or exploring (>= chapter 1)))
  (bool t-on (or exploring (<= chapter 1)))

  (list now (stretch L te mix 0))
  (list before (stretch Lp te mix 0))
  ; Each bar's height, blended from the stretch with Lp levels to the one with L levels.
  (list shown (+ (* before (- 1 g)) (* now g)))
  (real worst (+ (* (min (stretch Lp te mix 2)) (- 1 g)) (* (min (stretch L te mix 2)) g)))

  (group bars-chart (defaults (halign 'middle') (font plain))
    (group gridlines (defaults (stroke grid) (stroke-width 1))
      (line_ (from [54 -134]) (to [466 -134]))
      (line_ (from [54 -71]) (to [466 -71]))
      (line_ (from [54 -8]) (to [466 -8])))
    (group values (defaults (fill muted) (halign 'end') (font plain))
      (text_ '0' (pos [48 -138]))
      (text_ '0.5' (pos [48 -75]))
      (text_ '1' (pos [48 -12])))
    (line worst-line (from [54 (+ -134 (* 126 worst))]) (to [466 (+ -134 (* 126 worst))])
        (stroke muted) (stroke-width 1) (stroke-opacity 0.8) (dash [4 3]))
    ; Level i + 1.
    ; The bars stand on the axis, 41.2 apart. A bar too short to see is transparent: in a row,
    ; one that did not exist would let the bars after it slide out of their levels.
    (row bars (defaults (fill (if all every one))) (translate [74.6 -134]) (gap 14.832)
        (align 'bottom')
      (foreach i 10
        (let ((height (max 0.5 (* 126 shown[i]))))
          (rect_ (pos [0 (/ height 2)]) (width 26.368) (height height) (rx 2) (ry 2)
              (opacity (if (< shown[i] 0.002) 0 1))))))
    (group level-names (defaults (fill muted))
      (foreach i 10
        (text_ $'{(+ i 1)}' (pos [(+ 54 (* i 41.2) 20.6) -149]) (halign 'middle') (font plain)
            (opacity
             (cond ((< shown[i] 0.002) 0)
                   ((< i (min L Lp)) 1)
                   ((< i L) g)
                   (else (- 1 g)))))))
    (line_ (from [54 -134]) (to [466 -134]) (stroke muted) (stroke-width 1))
    (line_ (from [54 -168]) (to [466 -168]) (stroke rule) (stroke-width 3) (line-cap 'round'))
    (text_ 'level' (pos [260 -194]) (fill fg))
    (text_ 'relative stretch' (fill fg)
        (transform (transform (rotate 90) (translate 13 -71)))))

  ; The end of the hierarchy, and its handle, with a dashed guide down to it.
  (handle n-handle (x (+ 54 (* lv 41.2))) (y -168)
          (edge (if n-on (if all every one) muted)) (weight (if n-on 1.5 1)))
  (line n-guide (from [(+ 54 (* lv 41.2)) -8]) (to n-handle.tip.pos)
      (stroke (if n-on (if all every one) muted)) (stroke-width 1)
      (stroke-opacity (if n-on 0.7 0.45)) (dash [4 3]))
  ; What the reader grabs: an area wider than the handle, as wide as a level.
  (rect n-grab (pos [(+ 54 (* L 41.2)) -168]) (width 41.2) (height 24) (fill bg)
      (opacity 0))

  (real d-all (+ (* (spread-all Lp) (- 1 g)) (* (spread-all L) g)))
  (real d-now (spread L te))
  (pair best-now (best-of L))
  ; The distortion of one density, over the densities 2^-0.5 to 2^-(L + 0.5).
  (list ds (map samples (fn k (spread L (+ 0.5 (* L (/ k 200)))))))

  (group curve-chart
    (group curve-grid (defaults (stroke grid) (stroke-width 1))
      (foreach k 6
        (line_ (from [54 (cy ticks[k])]) (to [466 (cy ticks[k])]))))
    (group curve-values (defaults (fill muted))
      (foreach k 6
        (text_ tick-names[k] (pos [48 (- (cy ticks[k]) 4)])
            (halign 'end') (font plain))))
    ; A label every density up to 2^-L, every other one past 6 levels.
    (group densities (defaults (fill muted))
      (foreach k 10
        (let ((x (+ 54 (* (/ (+ k 0.5) lv) 412))))
          (text|none #'density-{k}' $'1/{(^ 2 (+ k 1))}' (pos [x -147]) (halign 'middle')
              (font tick))
          (exists-when #'density-{k}'
            (and (<= (+ k 1) L) (or (<= L 6) (= (mod k 2) 0)) (<= x 467))))))
    (line_ (from [54 -8]) (to [54 -130]) (stroke muted) (stroke-width 1))
    (line_ (from [54 -130]) (to [466 -130]) (stroke muted) (stroke-width 1))
    ; One text in the original, with p in italics; mtp gives a text one font, so three texts
    ; placed by hand, since a text's width cannot be measured.
    (text_ 'density' (pos [(if all 266 238) -192]) (halign 'end') (font plain) (fill fg))
    (text_ 'p' (pos [(if all 270 242) -192]) (font var) (fill fg))
    (text|none equals-p $' = 1/{(round (^ 2 te))}' (pos [251 -192]) (font plain) (fill fg))
    (exists-when equals-p (not all))
    (text_ 'distortion' (halign 'middle') (font plain) (fill fg)
        (transform (transform (rotate 90) (translate 13 -69))))
    ; The curve fades with all densities, and is cut off at the chart's right edge, as in the
    ; original.
    (group curve (defaults (stroke one) (stroke-width 2.2) (opacity (- 1 (* 0.78 mix))))
        (clip (rect_ (pos [260.5 -69]) (width 413) (height 150)))
      ; Sample k across the chart, at its distortion's height.
      (polyline_ (points (map samples (fn k [(+ 54 (* (/ (* L (/ k 200)) lv) 412)) (cy ds[k])])))))
    (line all-line (from [54 (cy d-all)]) (to [466 (cy d-all)]) (stroke every)
        (stroke-width (if all 3.5 2.4)))
    ; The line's name, set bold with all densities.
    (text|none all-plain $'all densities: {(fmt d-all)}, for every p'
        (pos [466 (- (cy d-all) (if all 19 17))]) (halign 'end') (font plain) (fill every))
    (text|none all-strong $'all densities: {(fmt d-all)}, for every p'
        (pos [466 (- (cy d-all) (if all 19 17))]) (halign 'end') (font strong) (fill every))
    (exists-when all-plain (not all))
    (exists-when all-strong all)
    (text|none best-label $'best: {(fmt best-now[0])}'
        (pos [(+ 54 (* (/ (- best-now[1] 0.5) lv) 412)) (+ (cy best-now[0]) 12)])
        (halign 'middle') (font strong) (fill one))
    (exists-when best-label floor)
    (line_ (from [54 -166]) (to [466 -166]) (stroke rule) (stroke-width 3) (line-cap 'round')))

  ; The current density: a marker on the curve, a guide down to the track, and its value, which
  ; gives way to the best one's name near it. With all densities, only the handle is left, grey.
  (real mx (+ 54 (* (/ (- te 0.5) lv) 412)))
  (handle t-handle (x mx) (y -166)
          (edge (if (and t-on (not all)) one muted)) (weight (if (and t-on (not all)) 1.5 1)))
  (group|none marker
    (line_ (from [mx (- (cy d-now) 7)]) (to t-handle.tip.pos) (stroke (if t-on one muted))
        (stroke-width 1) (stroke-opacity 0.7))
    (circle_ (pos [mx (cy d-now)]) (r 7) (fill one))
    (text|none value-now (fmt d-now) (pos [(if (< mx 406) (+ mx 11) (- mx 11)) (+ (cy d-now) 9)])
        (halign (if (< mx 406) 'start' 'end')) (font strong) (fill one))
    (exists-when value-now (not (and floor (< (abs (- te best-now[1])) 0.2)))))
  (exists-when marker (not all)))

(func quad (real x) (if (< x 0.5) (* 2 x x) (- 1 (/ (* (- 2 (* 2 x)) (- 2 (* 2 x))) 2))))
; The first step sweeps t with 5.5 - 4.5 cos(2 pi k / 0.82): there and back, as two halves.
(func sweep (real x) (/ (- 1 (cos (* pi x))) 2))

(animation one-density
  (at-once
    (at-once (defaults (duration 0))
      (move chapter (to 0)) (move exploring (to false)) (move mix (to 0)) (move floor (to false))
      (move L (to 10)) (move Lp (to 10)) (move g (to 1)))
    (in-order
      (move t (from 1) (to 10) (duration 5.33) (ease sweep))
      (move t (to 1) (duration 5.33) (ease sweep))
      (at-once
        (move t (to bests[3][1]) (duration 2.34) (ease quad))
        (move floor (to true) (duration 2.34) (ease (step-ease 0.72)))))))

; Steps 2 and 3 change the number of levels four times; each change blends the bars from the
; old number to the new one, with the density gliding to the new level's best (step 2) or set
; to it at once (step 3).
(motif levels-glide ((int to-L 10 (>= 2) (<= 10)) (int from-L 10 (>= 2) (<= 10)) (real t-from 1)
                     (real t-to 1))
  doc@'Step 2 changes the levels: the bars blend to the new number while the density glides.'
  (animation
    (at-once (defaults (duration 0)) (move L (to to-L)) (move Lp (to from-L)) (move g (to 0)))
    (at-once (defaults (duration 0.9625) (ease quad))
      (move g (to 1)) (move t (from t-from) (to t-to)))
    (wait 1.7875)))
(motif levels-jump ((int to-L 10 (>= 2) (<= 10)) (int from-L 10 (>= 2) (<= 10)) (real t-to 1))
  doc@'Step 3 changes the levels: the density is set at once, and the bars blend.'
  (animation
    (at-once (defaults (duration 0)) (move L (to to-L)) (move Lp (to from-L)) (move g (to 0))
      (move t (to t-to)))
    (move g (to 1) (duration 0.735) (ease quad))
    (wait 1.365)))

(animation floor-rises
  (at-once (defaults (duration 0))
    (move chapter (to 1)) (move exploring (to false)) (move mix (to 0)) (move floor (to true)))
  (levels-glide_ (to-L 4) (from-L 10) (t-from 4.5) (t-to bests[0][1]))
  (levels-glide_ (to-L 6) (from-L 4) (t-from bests[0][1]) (t-to bests[1][1]))
  (levels-glide_ (to-L 8) (from-L 6) (t-from bests[1][1]) (t-to bests[2][1]))
  (levels-glide_ (to-L 10) (from-L 8) (t-from bests[2][1]) (t-to bests[3][1])))

(animation all-densities
  (at-once (defaults (duration 0))
    (move chapter (to 2)) (move exploring (to false)) (move floor (to false)) (move mix (to 0))
    (move L (to 10)) (move Lp (to 10)) (move g (to 1)) (move t (to bests[3][1])))
  (at-once
    (move mix (to 1) (duration 2.16) (ease quad))
    (in-order
      (wait 3.6)
      (levels-jump_ (to-L 4) (from-L 10) (t-to bests[0][1]))
      (levels-jump_ (to-L 6) (from-L 4) (t-to bests[1][1]))
      (levels-jump_ (to-L 8) (from-L 6) (t-to bests[2][1]))
      (levels-jump_ (to-L 10) (from-L 8) (t-to bests[3][1])))))

; Leaving the tour keeps the state, snapped to one density or all, and finishes any change of
; the number of levels.
(animation to-explore
  (at-once (defaults (duration 0))
    (move exploring (to true)) (move floor (to false)) (move mix (to (round mix)))
    (move g (to 1) (duration 0.42) (ease quad))))

; The original holds 8 seconds after steps 1 and 2 with a countdown on the play button, and
; enters Explore after step 3.
(play tour (buttons true)
  doc@'Plays the tour: one density, the floor rising with n, then all densities.'
    (animation
      (step 'One density' one-density (wait 8))
      (step 'The floor rises with n' floor-rises (wait 8))
      (step 'All densities' all-densities to-explore)))

(button explore (animation to-explore) (label 'Explore')
  doc@'Skips to Explore, the end of the tour.')
(button single-density
    (animation (at-once (defaults (duration 0)) (move mix (to 0)) (move exploring (to true))
                 (move floor (to false)) (move g (to 1))))
    (label 'one')
  doc@'Shows one density.')
(button all-of-them
    (animation (at-once (defaults (duration 0)) (move mix (to 1)) (move exploring (to true))
                 (move floor (to false)) (move g (to 1))))
    (label 'all')
  doc@'Shows all densities together.')

; The grab sits at x = 54 + 41.2 L, and the handle at x = 54 + 412 (t - 1/2) / lv.
(on-drag n-grab (move L (to (round (/ (- pointer.x 54) 41.2)))) doc@'Changes the number of levels.')
(on-drag t-handle (move t (to (+ 0.5 (/ (* (- pointer.x 54) lv) 412)))) (<= t (+ L 0.5))
  doc@'Changes the density.')

(readout heading $'n = {(round (^ 2 L))} points, {L} levels'
  doc@'The number of points and of levels.')
(readout caption
    (cond ((= chapter 0)
           'One density serves one scale. A random set of density p separates pairs well only at the levels where each half of their common cluster has about 1/p points. As the density sweeps from 1/2 to 2⁻¹⁰, the well-served levels travel down the hierarchy, and the distortion, set by the worst-served level, is enormous except near the bottom of the valley.')
          ((= chapter 1)
           'The floor rises with n. Even the best single density leaves the levels at both ends of the hierarchy poorly served. More points mean more levels to cover, and the lowest distortion a single density can reach climbs from about 1.3 at n = 16 to about 5.2 at n = 1024.')
          (else
           'All densities at once. Using every density 2⁻¹, …, 2⁻ᴸ together, each level is served by its own density and the bars even out. The distortion drops to between 1.1 and 1.3 and stays below 1.3 for every n shown.'))
  doc@'A paragraph on the step of the tour shown.')

(canvas stretch-chart (x 0) (y -200) (width 480) (height 200) (pan false) (zoom false)
  doc@'The top chart: the relative stretch at each level, and the handle for the levels.'
  bars-chart n-guide n-handle n-grab)
(canvas distortion-chart (x 0) (y -206) (width 480) (height 206) (pan false) (zoom false)
  doc@'The bottom chart: the distortion against the density, and the handle for the density.'
  curve-chart marker t-handle)
