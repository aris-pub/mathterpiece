; Colormaps at work. On the left, a heatmap of two bumps: pick the map it is drawn with, or show
; it in bands, four solid colors with no mixing. On the right, a coast: a map with a hard edge at
; sea level, where shallow water meets sand; move the sea and the coastline follows. Below, the
; Okabe and Ito colors by number, as a chart takes them one after another: after the eighth they
; start again.

(import house paper ink soft terracotta teal saffron plum code)
(import colors okabe-ito okabe-ito-named viridis magma cividis blue-white-red)

; Bands: each of four colors one solid step.
(colormap bands [plum teal saffron terracotta] (discrete true))

; Land and sea, by height above the sea: deep water up to 0, then sand at once, forest and snow.
(palette terrain
  (deep '#1d3557')
  (shallow '#8ecae6')
  (sand '#e9d8a6')
  (forest '#52796f')
  (snow '#f1faee'))
(colormap land [terrain.deep terrain.shallow terrain.sand terrain.forest terrain.snow]
    (positions [-1 0 0 0.5 1]))

; Two bumps over the unit square, from 0 to about 1.
(func bumps ((real u) (real w))
  (min 1
       (+ (* 0.95 (exp (- (/ (+ (^ (- u 0.32) 2) (^ (- w 0.64) 2)) 0.035))))
          (* 0.7 (exp (- (/ (+ (^ (- u 0.72) 2) (^ (- w 0.3) 2)) 0.05)))))))

; Hills and valleys over the unit square, from about -1 to 1.
(func height ((real u) (real w))
  (+ (* 0.6 (sin (+ (* 5 u) 1)) (cos (* 4 w))) (* 0.35 (cos (- (* 3 u) (* 2 w))))))

(scene board (background paper)
  (string scheme 'viridis' (one-of 'viridis' 'magma' 'cividis' 'blue-white-red'))
  (real sea 0 (>= -0.6) (<= 0.6))
  (bool banded false)
  (real cell 0.25 (const))

  ; The heatmap: 20 by 20 cells, each the color of its value under the map chosen.
  (group heat (translate [-4.6 1])
    (rect frame (width 5) (height 5) (fill none) (stroke soft) (stroke-width 1))
    (foreach i 20
      (foreach j 20
        (let ((v (bumps (/ (+ i 0.5) 20) (/ (+ j 0.5) 20))))
          ; A little wider than its share, so that no seam shows between two cells.
          (rect_ (pos [(+ -2.5 (* cell (+ i 0.5))) (+ -2.5 (* cell (+ j 0.5)))])
              (width (* 1.06 cell)) (height (* 1.06 cell)) (stroke none)
              (fill
               (cond (banded (bands v))
                     ((= scheme 'magma') (magma v))
                     ((= scheme 'cividis') (cividis v))
                     ((= scheme 'blue-white-red') (blue-white-red v))
                     (else (viridis v)))))))))

  ; The coast: 24 by 20 cells, each the color of its height above the sea.
  (group coast (translate [2.4 1])
    (rect shore (width 6) (height 5) (fill none) (stroke soft) (stroke-width 1))
    (foreach i 24
      (foreach j 20
        (let ((h (height (/ (+ i 0.5) 24) (/ (+ j 0.5) 20))))
          (rect_ (pos [(+ -3 (* cell (+ i 0.5))) (+ -2.5 (* cell (+ j 0.5)))])
              (width (* 1.06 cell)) (height (* 1.06 cell)) (stroke none)
              (fill (land (- h sea))))))))

  ; Okabe and Ito by number: twelve dots, so the last four repeat the first four. Under them,
  ; the first eight again, each read by its name.
  (group chart (translate [-3.2 -2.65])
    (foreach k 12
      (circle_ (pos [(* 0.62 (- k 5.5)) 0]) (r 0.22) (fill (okabe-ito k)) (stroke none))))
  (group named (translate [-3.2 -3.55])
    (foreach k 8
      (let ((names [okabe-ito-named.orange okabe-ito-named.sky-blue okabe-ito-named.bluish-green
                    okabe-ito-named.yellow okabe-ito-named.blue okabe-ito-named.vermillion
                    okabe-ito-named.reddish-purple okabe-ito-named.black]))
        (circle_ (pos [(* 0.62 (- k 5.5)) 0]) (r 0.22) (fill names[k]) (stroke none)))))

  (group forms (defaults (fill soft) (font code) (halign 'middle') (valign 'top'))
    (text_ (if banded '(bands v), four solid steps' $'({scheme} v)')
        (pos (bottom frame 0.25)))
    (text_ $'(land (- height {sea:.2f}))' (pos (bottom shore 0.25)))
    (text_ '(okabe-ito k), k from 0 to 11' (pos (right chart 0.4)) (halign 'start')
        (valign 'middle'))
    (text_ 'okabe-ito-named.orange, .sky-blue, …' (pos (right named 0.4)) (halign 'start')
        (valign 'middle'))))

(canvas view (x -8.4) (y -4.1) (width 16.8) (height 8.4) (pan false) (zoom false)
  heat coast chart named forms)

(button pick-viridis (animation (move scheme (to 'viridis') (duration 0))) (label 'viridis'))
(button pick-magma (animation (move scheme (to 'magma') (duration 0))) (label 'magma'))
(button pick-cividis (animation (move scheme (to 'cividis') (duration 0))) (label 'cividis'))
(button pick-diverging (animation (move scheme (to 'blue-white-red') (duration 0)))
    (label 'blue-white-red'))
(toggle in-bands banded (label 'in bands'))
(slider sea-level (move sea (from -0.6) (to 0.6)) (label 'sea level'))
