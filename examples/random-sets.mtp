; The distance to a set A, on the star with four leaves, from the Bourgain notes: three choices
; of A, and whether they separate the leaves u1 and u2.
; Coordinates are the original SVG's, with y pointing up; each panel is a group with its own canvas.

; Colors and type as tokens, so the Bourgain page can map them onto its own variables
; (--mtp-fg: var(--fg) and so on) and follow its light and dark mode.
(color fg '#1f2328')
(color muted '#6b7280')
(color bg '#faf7f0')
(color rule '#d8d3c4')
(color teal '#1a6f66')
(color coral '#a65a3a')
(color accent '#4a6584')
(color warn '#a07a2c')
(font label (style 'italic') (size 14))
(font note (size 13))
(font value (size 14))

(scene star
  ; A = {u1}. Distances to A: u1 0, c 1, u2 2, u3 2, u4 2. The leaves u1 and u2 differ by 2.
  (group one-leaf
    (line _ (from [110 -105]) (to [110 -45]) (stroke fg) (stroke-width 1.5))
    (line _ (from [110 -105]) (to [170 -105]) (stroke fg) (stroke-width 1.5))
    (line _ (from [110 -105]) (to [110 -165]) (stroke fg) (stroke-width 1.5))
    (line _ (from [110 -105]) (to [50 -105]) (stroke fg) (stroke-width 1.5))
    (circle _ (pos [110 -105]) (r 5) (fill fg))
    (text _ 'c' (pos [120 -96]) (font label) (fill fg))
    (rect _ (x 83) (y -132) (width 18) (height 18) (rx 4) (fill bg) (stroke rule) (stroke-width 1))
    (text _ '1' (pos [92 -128]) (halign 'middle') (font value) (fill fg))
    (circle _ (pos [110 -45]) (r 7) (fill accent) (stroke accent))
    (text _ 'u₁' (pos [120 -39]) (font label) (fill fg))
    (rect _ (x 83) (y -48) (width 18) (height 18) (rx 4) (fill coral) (fill-opacity 0.18) (stroke coral) (stroke-width 1))
    (text _ '0' (pos [92 -44]) (halign 'middle') (font value) (fill fg))
    (circle _ (pos [170 -105]) (r 5) (fill fg))
    (text _ 'u₂' (pos [176 -93]) (font label) (fill fg))
    (rect _ (x 181) (y -126) (width 18) (height 18) (rx 4) (fill coral) (fill-opacity 0.18) (stroke coral) (stroke-width 1))
    (text _ '2' (pos [190 -122]) (halign 'middle') (font value) (fill fg))
    (circle _ (pos [110 -165]) (r 5) (fill fg))
    (text _ 'u₃' (pos [120 -181]) (font label) (fill fg))
    (rect _ (x 83) (y -172) (width 18) (height 18) (rx 4) (fill bg) (stroke rule) (stroke-width 1))
    (text _ '2' (pos [92 -168]) (halign 'middle') (font value) (fill fg))
    (circle _ (pos [50 -105]) (r 5) (fill fg))
    (text _ 'u₄' (pos [24 -93]) (font label) (fill fg))
    (rect _ (x 21) (y -130) (width 18) (height 18) (rx 4) (fill bg) (stroke rule) (stroke-width 1))
    (text _ '2' (pos [30 -126]) (halign 'middle') (font value) (fill fg))
    (text _ '(a) A = {u₁}' (pos [110 -215]) (halign 'middle') (font note) (fill muted))
    (text _ 'u₁, u₂ separated by 2' (pos [110 -233]) (halign 'middle') (font note) (fill muted)))

  ; A = {c, u2, u3}. Distances to A: u1 1, c 0, u2 0, u3 0, u4 1. The leaves u1 and u2 differ by 1.
  (group center-and-two
    (line _ (from [340 -105]) (to [340 -45]) (stroke fg) (stroke-width 1.5))
    (line _ (from [340 -105]) (to [400 -105]) (stroke fg) (stroke-width 1.5))
    (line _ (from [340 -105]) (to [340 -165]) (stroke fg) (stroke-width 1.5))
    (line _ (from [340 -105]) (to [280 -105]) (stroke fg) (stroke-width 1.5))
    (circle _ (pos [340 -105]) (r 7) (fill accent) (stroke accent))
    (text _ 'c' (pos [350 -96]) (font label) (fill fg))
    (rect _ (x 313) (y -132) (width 18) (height 18) (rx 4) (fill bg) (stroke rule) (stroke-width 1))
    (text _ '0' (pos [322 -128]) (halign 'middle') (font value) (fill fg))
    (circle _ (pos [340 -45]) (r 5) (fill fg))
    (text _ 'u₁' (pos [350 -39]) (font label) (fill fg))
    (rect _ (x 313) (y -48) (width 18) (height 18) (rx 4) (fill coral) (fill-opacity 0.18) (stroke coral) (stroke-width 1))
    (text _ '1' (pos [322 -44]) (halign 'middle') (font value) (fill fg))
    (circle _ (pos [400 -105]) (r 7) (fill accent) (stroke accent))
    (text _ 'u₂' (pos [406 -93]) (font label) (fill fg))
    (rect _ (x 411) (y -126) (width 18) (height 18) (rx 4) (fill coral) (fill-opacity 0.18) (stroke coral) (stroke-width 1))
    (text _ '0' (pos [420 -122]) (halign 'middle') (font value) (fill fg))
    (circle _ (pos [340 -165]) (r 7) (fill accent) (stroke accent))
    (text _ 'u₃' (pos [350 -181]) (font label) (fill fg))
    (rect _ (x 313) (y -172) (width 18) (height 18) (rx 4) (fill bg) (stroke rule) (stroke-width 1))
    (text _ '0' (pos [322 -168]) (halign 'middle') (font value) (fill fg))
    (circle _ (pos [280 -105]) (r 5) (fill fg))
    (text _ 'u₄' (pos [254 -93]) (font label) (fill fg))
    (rect _ (x 251) (y -130) (width 18) (height 18) (rx 4) (fill bg) (stroke rule) (stroke-width 1))
    (text _ '1' (pos [260 -126]) (halign 'middle') (font value) (fill fg))
    (text _ '(b) A = {c, u₂, u₃}' (pos [340 -215]) (halign 'middle') (font note) (fill muted))
    (text _ 'u₁, u₂ separated by 1' (pos [340 -233]) (halign 'middle') (font note) (fill muted)))

  ; A = {u3, u4}. Distances to A: u1 2, c 1, u2 2, u3 0, u4 0. The leaves u1 and u2 are not separated.
  (group two-leaves
    (line _ (from [570 -105]) (to [570 -45]) (stroke fg) (stroke-width 1.5))
    (line _ (from [570 -105]) (to [630 -105]) (stroke fg) (stroke-width 1.5))
    (line _ (from [570 -105]) (to [570 -165]) (stroke fg) (stroke-width 1.5))
    (line _ (from [570 -105]) (to [510 -105]) (stroke fg) (stroke-width 1.5))
    (circle _ (pos [570 -105]) (r 5) (fill fg))
    (text _ 'c' (pos [580 -96]) (font label) (fill fg))
    (rect _ (x 543) (y -132) (width 18) (height 18) (rx 4) (fill bg) (stroke rule) (stroke-width 1))
    (text _ '1' (pos [552 -128]) (halign 'middle') (font value) (fill fg))
    (circle _ (pos [570 -45]) (r 5) (fill fg))
    (text _ 'u₁' (pos [580 -39]) (font label) (fill fg))
    (rect _ (x 543) (y -48) (width 18) (height 18) (rx 4) (fill muted) (fill-opacity 0.12) (stroke muted) (stroke-width 1))
    (text _ '2' (pos [552 -44]) (halign 'middle') (font value) (fill fg))
    (circle _ (pos [630 -105]) (r 5) (fill fg))
    (text _ 'u₂' (pos [636 -93]) (font label) (fill fg))
    (rect _ (x 641) (y -126) (width 18) (height 18) (rx 4) (fill muted) (fill-opacity 0.12) (stroke muted) (stroke-width 1))
    (text _ '2' (pos [650 -122]) (halign 'middle') (font value) (fill fg))
    (circle _ (pos [570 -165]) (r 7) (fill accent) (stroke accent))
    (text _ 'u₃' (pos [580 -181]) (font label) (fill fg))
    (rect _ (x 543) (y -172) (width 18) (height 18) (rx 4) (fill bg) (stroke rule) (stroke-width 1))
    (text _ '0' (pos [552 -168]) (halign 'middle') (font value) (fill fg))
    (circle _ (pos [510 -105]) (r 7) (fill accent) (stroke accent))
    (text _ 'u₄' (pos [484 -93]) (font label) (fill fg))
    (rect _ (x 481) (y -130) (width 18) (height 18) (rx 4) (fill bg) (stroke rule) (stroke-width 1))
    (text _ '0' (pos [490 -126]) (halign 'middle') (font value) (fill fg))
    (text _ '(c) A = {u₃, u₄}' (pos [570 -215]) (halign 'middle') (font note) (fill muted))
    (text _ 'u₁, u₂ not separated' (pos [570 -233]) (halign 'middle') (font note) (fill muted))))

(canvas one-leaf-view (view-x 0) (view-y -242)
  (view-width 226) (view-height 223) one-leaf)
(canvas center-and-two-view (view-x 228) (view-y -242)
  (view-width 226) (view-height 223) center-and-two)
(canvas two-leaves-view (view-x 456) (view-y -242)
  (view-width 224) (view-height 223) two-leaves)
