; The Ulam spiral: the whole numbers laid out on a square spiral from 1 in the middle, with a
; dot on every prime. Primes crowd onto diagonal lines: a prime with another prime diagonally
; next to it is teal, a prime on its own is grey. Drag to pan, scroll or pinch to zoom, and
; double-click to go back; turn on the path to see how the spiral runs through every number.

(import house paper soft terracotta teal number code)
(import ease cubic-in-out)

; Trial division by 5, 7, 11, 13, 17, 19, …: every prime above 3 is one more or one less than a
; multiple of 6, so only those divisors need trying, which keeps compiling fast.
(func has-divisor ((int n) (int d))
  (cond ((> (* d d) n) false)
        ((= (mod n d) 0) true)
        ((= (mod n (+ d 2)) 0) true)
        (else (has-divisor n (+ d 6)))))
(func prime? (int n)
  (cond ((< n 2) false)
        ((< n 4) true)
        ((= (mod n 2) 0) false)
        ((= (mod n 3) 0) false)
        (else (not (has-divisor n 5)))))

; Where n sits on the spiral. Ring k holds the numbers after (2k - 1)² up to (2k + 1)², which
; sits at its bottom-right corner; t is the length of a side, and the four branches are the
; ring's bottom, left, top and right sides, counted back from that corner.
(func[point] spiral (int n 1 (>= 1))
  (let ((k (ceil (/ (- (sqrt n) 1) 2))) (t (* 2 k)) (m (* (+ t 1) (+ t 1))))
    (cond ((>= n (- m t)) [(- k (- m n)) (- k)])
          ((>= n (- m (* 2 t))) [(- k) (+ (- k) (- (- m t) n))])
          ((>= n (- m (* 3 t))) [(+ (- k) (- (- m (* 2 t)) n)) k])
          (else [k (- k (- (- m (* 3 t)) n))]))))

; The number at a point of the spiral: spiral backwards. The point's ring k is the larger of
; its distances along each axis, and its side, read in the same order as in spiral, says how far
; back from the ring's last number m it is.
(func at ((int x) (int y))
  ; max gives a real, so the ring is rounded back to the int it is.
  (let ((k (round (max (abs x) (abs y)))) (t (* 2 k)) (m (* (+ t 1) (+ t 1))))
    (cond ((= k 0) 1)
          ((= y (- k)) (- m (- k x)))
          ((= x (- k)) (- m t (+ y k)))
          ((= y k) (- m (* 2 t) (+ x k)))
          (else (- m (* 3 t) (- k y))))))

; Whether a prime at n has a prime diagonally next to it, so it lies on one of the lines.
(func on-a-line (int n 1 (>= 1))
  (let ((p (spiral n)) (x (round p.x)) (y (round p.y)))
    (or (prime? (at (+ x 1) (+ y 1))) (prime? (at (- x 1) (- y 1)))
        (prime? (at (+ x 1) (- y 1))) (prime? (at (- x 1) (+ y 1))))))

; Only the primes within this distance of 1 are drawn, so the spiral is a disc.
(real reach 78 (const))

(scene numbers (background paper)
  (group dots (defaults (stroke none))
    (foreach p (where (range 2 25000 (gap 1)) (fn n (and (prime? n) (<= (dist [0 0] (spiral n)) reach))))
      (let ((lined (on-a-line p)))
        (circle_ (pos (spiral p)) (r (if lined 0.5 0.3)) (fill (if lined teal soft))))))
  (circle one (r 0.6) (fill terracotta) (stroke none))

  ; The path the spiral takes through every number, one shape, and the first 81 numbers, a 9 by
  ; 9 square. Their text keeps its size on screen, so they are only readable zoomed in; that
  ; many texts would be slow to draw, where one polyline is not.
  (polyline path (points (map (range 1 25000 (gap 1)) spiral)) (fill none) (stroke soft)
      (stroke-width 1) (stroke-opacity 0.4))
  (group labels (defaults (font number) (halign 'middle') (valign 'middle'))
    (foreach i 81
      (text_ $'{(+ i 1)}' (pos (spiral (+ i 1)))
          (fill (if (or (prime? (+ i 1)) (= i 0)) paper soft)))))

  (group captions (defaults (fill soft) (font code) (halign 'middle') (valign 'top'))
    (text_ 'the primes below 25000 within 78 of 1' (pos (bottom dots 3)))
    (text_ '(fill (if (on-a-line p) teal soft))' (pos (bottom dots 7.5)))))

(toggle show-labels none (label 'the path and the first numbers'))

; The view box shows the whole disc; panning and zooming are on by default.
(canvas view (x -86) (y -98) (width 172) (height 184) (toggle-duration 0.4)
    (toggle-ease cubic-in-out)
  (when show-labels.value path)
  dots one
  (when show-labels.value labels)
  captions)
