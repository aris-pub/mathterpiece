; The unit circle. A point at angle theta sits at (cos theta, sin theta): drag the point around
; the circle, or the slider, and watch the six trig functions change. Each function has a toggle
; that shows or hides it. The text uses three type tokens, one per role, and a page can restyle
; each of them with CSS, as it can restyle the color tokens.

(color paper '#fbf8f1')
(color ink '#1f2a44')
(color accent '#e76f51')
(color cool '#2a9d8f')
(color warm '#e9c46a')
(color deep '#6d597a')

; Font sizes and stroke widths are in screen pixels.
; Headings: the page's font, heavier.
(font heading (weight 600) (size 24))
; Math variables are italic, in a serif, as in typeset math.
(font variable (family 'Georgia, serif') (style 'italic') (size 21))
; Names of functions, upright as in typeset math.
(font small (family 'Georgia, serif') (size 16))
; Numbers that change, in a monospace font, so the digits do not jump around as they change.
(font number (family 'ui-monospace, Menlo, monospace') (size 16))

; One group per function: its line, its name, and its value, so a toggle shows or hides all three.
; The circle has radius 1, and the canvas's view box makes it large.
(scene plane
  (background paper)
  (real theta 40)

  (circle handle (pos (polar 1 theta)) (r 0.04) (fill ink))

  ; Which side of each axis the point is on: names along an axis go on the other side, away
  ; from the lines that reach the point.
  (real above (if (>= (sind theta) 0) 1 -1))
  (real right (if (>= (cosd theta) 0) 1 -1))

  ; Colors and strokes given in a group's defaults are its members' defaults. A text takes the
  ; fill but none of the stroke attributes.
  (group frame (defaults (stroke ink) (fill ink))
    (group axes (defaults (stroke-width 1) (stroke-opacity 0.5))
      (line_ (from [-1.35 0]) (to [1.35 0]))
      (line_ (from [0 -1.15]) (to [0 1.15])))
    (circle rim (r 1) (fill none) (stroke-width 1.6))
    (line radius (from [0 0]) (to handle.pos) (stroke-width 2))
    (text_ 'θ' (pos (polar 0.18 (/ theta 2))) (font variable))
    (text title 'the unit circle' (pos [-2.05 1.05]) (font heading))
    (text angle $'θ = {theta:5.1f}°' (pos [-2.05 0.9]) (font number)))

  ; The names sit beside their lines, centered on the spot given.
  (group cosine (defaults (stroke accent) (fill accent))
    (line across (from [0 0]) (to [handle.x 0]) (stroke-width 4))
    (text_ 'cos' (pos [(/ handle.x 2) (* -0.1 above)]) (halign 'middle') (valign 'middle')
      (font small))
    (text xs $'cos = {(cosd theta):+z.3f}' (pos [-2.05 0.78]) (font number)))

  ; sin's name goes inside the triangle under the radius, clear of the tangent line, unless the
  ; triangle is too thin for it.
  (group sine (defaults (stroke cool) (fill cool))
    (line up (from [handle.x 0]) (to handle.pos) (stroke-width 4))
    (text_ 'sin'
      (pos [(+ handle.x (* 0.12 right (if (< (abs handle.x) 0.45) 1 -1))) (/ handle.y 2)])
      (halign 'middle') (valign 'middle') (font small))
    (text ys $'sin = {(sind theta):+z.3f}' (pos [-2.05 0.67]) (font number)))

  ; Where the tangent line at the point meets the x axis: at sec theta. At 90 and 270 degrees it
  ; never does: there this is none, and the lines and names that need it are not drawn.
  (real|none sec-x (secd theta))

  ; The tangent segment, from the point to where the tangent line meets the x axis, is tan theta
  ; long, and along the x axis from the center, sec theta. The tangent is at right angles to the
  ; radius, so its name moves out along the radius to clear the line, and it stays near the
  ; point, since the segment's far end may be off the canvas.
  (group tangent (defaults (stroke deep) (fill deep))
    ; The tangent line itself, at right angles to the radius: it exists at every angle, even
    ; where the segment does not.
    (line along (from (+ handle.pos (* 3 (polar 1 (+ theta 90)))))
                (to (- handle.pos (* 3 (polar 1 (+ theta 90))))) (stroke-width 1.5))
    (line|none tan (from handle.pos) (to [sec-x 0]) (stroke-width 4))
    (text|none_ 'tan'
      (pos (+ (lerp handle.pos [sec-x 0] (min 0.5 (/ 0.3 (dist handle.pos [sec-x 0]))))
              (polar 0.1 theta)))
      (halign 'middle') (valign 'middle') (font small))
    (text tans (or? $'tan = {(tand theta):+z.3f}' 'tan = ±∞')
      (pos [-2.05 0.55]) (font number)))

  ; sec runs along the x axis past cos, so its name goes on the part of the line beyond cos,
  ; kept on the canvas.
  (group secant (defaults (stroke deep) (fill deep))
    (line|none sec (from [0 0]) (to [sec-x 0]) (stroke-width 2))
    (text|none_ 'sec' (pos [(max -1.9 (min 1.35 (/ (+ handle.x sec-x) 2))) (* -0.1 above)])
      (halign 'middle') (valign 'middle') (font small))
    (text secs (or? $'sec = {(secd theta):+z.3f}' 'sec = ±∞')
      (pos [-2.05 0.43]) (font number)))

  ; Where the tangent line meets the y axis: at csc theta, none at 0 and 180 degrees.
  (real|none csc-y (cscd theta))

  ; From the point to the y axis is cot theta long, and along the y axis, csc theta.
  (group cotangent (defaults (stroke warm) (fill warm))
    (line|none cot (from handle.pos) (to [0 csc-y]) (stroke-width 4))
    (text|none_ 'cot'
      (pos (+ (lerp handle.pos [0 csc-y] (min 0.5 (/ 0.3 (dist handle.pos [0 csc-y]))))
              (polar 0.1 theta)))
      (halign 'middle') (valign 'middle') (font small))
    (text cots (or? $'cot = {(cotd theta):+z.3f}' 'cot = ±∞')
      (pos [-2.05 0.32]) (font number)))

  (group cosecant (defaults (stroke warm) (fill warm))
    (line|none csc (from [0 0]) (to [0 csc-y]) (stroke-width 2))
    (text|none_ 'csc' (pos [(* -0.12 right) (max -1.1 (min 1.1 (/ csc-y 2)))])
      (halign 'middle') (valign 'middle') (font small))
    (text cscs (or? $'csc = {(cscd theta):+z.3f}' 'csc = ±∞')
      (pos [-2.05 0.2]) (font number))))

; Which functions are shown. These toggles hold their own value: whether a line is shown is about
; this view, not about the circle, so the scene does not need to know.
(toggle show-cos none (label 'cos') (value true))
(toggle show-sin none (label 'sin') (value true))
(toggle show-tan none (label 'tan') (value true))
(toggle show-sec none (label 'sec'))
(toggle show-cot none (label 'cot'))
(toggle show-csc none (label 'csc'))

; Drawn in this order: the point last, on top, so the pointer always reaches it. Switching a
; function on or off fades its line, name and value in or out.
(canvas view (view-x -2.1) (view-y -1.35) (view-width 3.6) (view-height 2.7)
  (move none (duration 0.4) (ease 'ease-in-out'))
  frame
  (when show-sec.value secant)
  (when show-csc.value cosecant)
  (when show-cos.value cosine)
  (when show-sin.value sine)
  (when show-tan.value tangent)
  (when show-cot.value cotangent)
  handle)

; Dragging the point changes theta, so the point slides along the circle under the pointer.
(on-drag handle theta)
(slider turn (move theta (from 0) (to 360)) (label 'θ'))

; For the prose around the figure: the same numbers, set in the number font.
(readout x-now $'{(cosd theta):+z.3f}' (font number))
(readout y-now $'{(sind theta):+z.3f}' (font number))
