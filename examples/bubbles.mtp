; Bubbles, each placed and sized at random, from the standard seed: the same on every refresh.
; They rise into place when the figure first comes into view. Click a bubble to pop it, or drag
; one and let go: it springs back to where it was. One button brings the popped ones back, and
; another rolls the dice for new bubbles.

(import house paper soft red green yellow blue code)
(import ease cubic-out)
(import rand)

; A damped spring: it starts from rest, goes past its end once and settles, as a ball on a
; spring does, and ends at exactly 1.
(func spring ((real t 0 (>= 0) (<= 1)))
  (- 1 (* (^ (- 1 t) 3) (+ (cos (* 8 t)) (* 0.375 (sin (* 8 t)))))))

; Once it has popped, its body and the rest of it do not exist.
(motif bubble ((real size 1 (>= 0)) (color tint) (bool popped false) (real burst 0 (>= 0) (<= 1)))
  doc@'A bubble that pops: as burst runs from 0 to 1, it swells and fades, and drops fly out.'
  ; The body has no position of its own given, so its position is free: a drag writes it, and so
  ; does the spring back.
  (circle|none body (r (* size (+ 1 (* 0.5 burst)))) (fill tint) (fill-opacity 0.3) (stroke tint)
      (stroke-width 2) (opacity (- 1 burst)))
  (exists-when body (not popped))
  (group|none bits (defaults (stroke none))
    (circle shine (pos (+ body.pos [(* -0.4 size) (* 0.4 size)])) (r (* 0.16 size))
        (fill (lighten tint 0.7)) (opacity (* 0.8 (- 1 burst))))
    (foreach k 8
      (circle_ (pos (+ body.pos (polar (* size (+ 1 (* 1.2 burst))) (* k 45))))
          (r (* 0.08 size)) (fill tint) (opacity (min 1 (* 4 burst (- 1 burst)))))))
  (exists-when bits (not popped)))

(scene pond (background paper)
  ; 1 while the bubbles wait below the figure, 0 once they have risen into place.
  (real rise 1 (>= 0) (<= 1))

  ; The bubbles' centers fall anywhere in water, which is not drawn. The caption sits under it,
  ; far enough down to clear the largest bubble.
  (real largest 1.25 (const))
  (rect water (pos [0 0.4]) (width 12.8) (height 6) (fill none) (stroke none))
  (let ((low (bottom-left water)) (high (top-right water)))
    (group bubbles
      (foreach i 8
        (bubble #'b{i}'
                (pos [(rand low[0] high[0]) (- (rand low[1] high[1]) (* rise (rand 9 13)))])
                (size (rand 0.55 largest))
                (tint [red green yellow blue][(mod i 4)])))))

  (int popped-count (count bubbles (fn b b.popped)))
  (group captions (defaults (fill soft) (font code) (halign 'middle') (valign 'middle'))
    (text_ $'(exists-when body (not popped)), popped: {popped-count} of 8'
        (pos (bottom water (+ largest 0.65))))))

(canvas view (x -8) (y -5) (width 16) (height 10) (pan false) (zoom false)
  doc@'The pond and its bubbles.'
  pond)

(on-view view (animation (move rise (to 0) (duration 0.8) (ease cubic-out)))
  doc@'Brings the bubbles up into place.')

; A click is a press and a release on the same bubble, so letting go of a drag over a bubble
; is a click too; a bubble pops only when it is at home, so a drag never pops it. The spring
; back runs on on-dragend, which only the end of a drag sets off; on-release would also run on a
; plain click, and when a press that began elsewhere is let go over the bubble.
(foreach b bubbles
  (on-click b.body (active (< (or? (dist b.body.pos b.pos) 1) 0.1))
    doc@'Pops the bubble, when it is at home.'
      (animation
        (move b.burst (to 1) (duration 0.3) (ease cubic-out))
        (move b.popped (to true) (duration 0))))
  (on-drag b.body b.body.pos doc@'Moves the bubble.')
  (on-dragend b.body (animation (move b.body.pos (to [0 0]) (duration 0.8) (ease spring)))
    doc@'Springs the bubble back home.'))

; A bubble brought back shrinks from its burst into place; one that never popped has a burst of
; 0 and does not change.
(button bring-back
    (animation
      (at-once (defaults (duration 0.5) (ease cubic-out))
        (foreach b bubbles
          (move b.popped (to false) (duration 0))
          (move b.burst (to 0)))))
    (label 'bring the bubbles back'))

(button new-bubbles (animation (roll-dice)) (label 'new bubbles')
  doc@'Places and sizes every bubble again.')
