(motif 'labeled-disk' (params (r 1.0) (label 'A'))
  (circle 'crc' (r r) (fill-opacity 0.3))
  (text 'txt' label (x -0.3) (y (+ crc.r 0.5))))

(motif 'pair' (params (gap 4.0))
  (labeled-disk 'left' (x (- gap)) (label 'L'))
  (labeled-disk 'right' (x gap) (r 2) (label 'R') (fill 'teal')))

(scene 'world'
  (pair 'p1' (y 4) (fill 'red'))
  (pair 'p2' (y -4) (gap 6) (fill 'purple') (opacity 0.5))
  (text 'info' $'right disk of p1 is at x = {p1.right.crc.x:.1f}' (x -9) (y -9)))

(canvas 'cnv' world)
