; Why sunflowers use the golden angle. Seed i sits at radius (sqrt i), turned i times an angle.
; Simple fractions of a turn line the seeds up in spokes and leave gaps; the golden angle,
; the most irrational turn there is, packs them evenly. Press play for the tour, pick a step,
; or drag the angle yourself.

(color 'night' '#0b1026')
(const 'gold' '#f6c453')
(color 'chalk' '#e8e4d8')
(font 'heading' (weight 600) (size 0.6))
(font 'small' (size 0.45))
(const 'golden-angle' (* 180 (- 3 (sqrt 5))))

(func 'seed-color' (params (t 0.0))
  (cond ((< t 0.3) '#9a4f16') ((< t 0.6) '#cf7424') ((< t 0.85) '#e89b2a') (else gold)))

(motif 'flower' (params (n 300) (angle 90.0) (spread 0.5) (size 0.17))
  (repeat i n
    (let ((d (* spread (sqrt i))) (t (/ i n)))
      (circle _
        (pos (polar d (* i angle)))
        (r (* size (sqrt (+ 1 (* 3 t)))))
        (fill (seed-color t))
        (stroke 'none')))))

(scene 'garden'
  (background night)
  (circle 'halo' (r 9.2) (fill 'none') (fill-opacity 0.12) (stroke 'none'))
  (flower 'sunflower')
  (text 'name' 'a quarter turn' (pos [-9.3 9]) (font heading) (fill chalk))
  (text 'degrees' $'{sunflower.angle:.1f}°' (pos [-9.3 8.2]) (font small) (fill chalk) (opacity 0.6)))

; Each stop of the tour: the angle, its name, and whether the halo glows.
(animation 'quarter'
  (at-once (default-duration 1.5) (default-ease 'ease-in-out')
    (sunflower.angle (transition (to 90)))
    (name.value (transition (to 'a quarter turn')))
    (halo.fill (transition (to 'none')))))
(animation 'third'
  (at-once (default-duration 2.5) (default-ease 'ease-in-out')
    (sunflower.angle (transition (to 120)))
    (name.value (transition (to 'a third of a turn')))
    (halo.fill (transition (to 'none')))))
(animation 'two-fifths'
  (at-once (default-duration 2.5) (default-ease 'ease-in-out')
    (sunflower.angle (transition (to 144)))
    (name.value (transition (to 'two fifths of a turn')))
    (halo.fill (transition (to 'none')))))
(animation 'golden'
  (at-once (default-duration 3) (default-ease 'ease-out')
    (sunflower.angle (transition (to golden-angle)))
    (name.value (transition (to 'the golden angle')))
    (halo.fill (transition (to gold)))))
(animation 'angles' (in-order quarter (wait 1.5) third (wait 1.5) two-fifths (wait 1.5) golden))

(canvas 'view' garden)
(play 'tour' angles (buttons true))
(slider 'angle' (animation (sunflower.angle (transition (from 80) (to 180)))) (label 'angle'))

; Clicking the flower takes it to the golden angle.
(on-click sunflower golden)
