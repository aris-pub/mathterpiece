; Why sunflowers use the golden angle. Seed i sits at radius (sqrt i), turned i times an angle.
; Simple fractions of a turn line the seeds up in spokes and leave gaps; the golden angle,
; the most irrational turn there is, packs them evenly. Press play for the tour, pick a stop,
; or drag the angle yourself.

(color night '#0b1026')
(color gold '#f6c453')
(color chalk '#e8e4d8')
(font heading (weight 600) (size 19))
(font small (size 14))
(real golden-angle (* 180 (- 3 (sqrt 5))) (const))

(type stop string (one-of 'a quarter turn' 'a third of a turn' 'two fifths of a turn'
                          'the golden angle'))

; Seeds darken towards the middle: t is how far out a seed is, from 0 to 1.
(func seed-color (real t)
  (cond ((< t 0.3) (as color '#9a4f16'))
        ((< t 0.6) (as color '#cf7424'))
        ((< t 0.85) (as color '#e89b2a'))
        (else gold)))

(motif flower ((int n 300 (const)) (real angle 90) (real spread 0.5) (real size 0.17 (>= 0)))
  (foreach i n
    (circle_
      (pos (polar (* spread (sqrt i)) (* i angle)))
      (r (* size (sqrt (+ 1 (* 3 (/ i n))))))
      (fill (seed-color (/ i n))))))

(scene garden
  (background night)
  ; The figure opens at the tour's last stop, so playing the tour moves from the first moment.
  (stop stop-name 'the golden angle')
  ; '#f6c453' is gold written out. gold is a token, which the page may restyle, so (fill gold)
  ; would be bound to it, and the tour could never move the fill.
  (circle halo (r 9.2) (fill '#f6c453') (fill-opacity 0.12))
  (flower sunflower (angle golden-angle))
  ; The stop's name in the halo's top-left corner, and the angle just under it.
  (group captions (defaults (fill chalk) (valign 'top'))
    (text title stop-name (pos (top-left halo 0.25)) (font heading))
    (text degrees $'{sunflower.angle:.1f}°' (pos (+ title.pos [0 -0.9])) (font small)
      (opacity 0.6))))

; Each stop of the tour: the angle, its name, and whether the halo glows.
; Each move turns the angle about 3 degrees a second on average (about 9 at its fastest, in the
; middle of the ease): a small change of angle turns the outer seeds a long way, so faster than
; that the flower blurs.
(animation quarter
  (at-once (defaults (duration 16) (ease 'ease-in-out'))
    (move sunflower.angle (to 90))
    (move stop-name (to 'a quarter turn'))
    (move halo.fill (to none))))
(animation third
  (at-once (defaults (duration 10) (ease 'ease-in-out'))
    (move sunflower.angle (to 120))
    (move stop-name (to 'a third of a turn'))
    (move halo.fill (to none))))
(animation two-fifths
  (at-once (defaults (duration 8) (ease 'ease-in-out'))
    (move sunflower.angle (to 144))
    (move stop-name (to 'two fifths of a turn'))
    (move halo.fill (to none))))
(animation golden
  (at-once (defaults (duration 6) (ease 'ease-out'))
    (move sunflower.angle (to golden-angle))
    (move stop-name (to 'the golden angle'))
    (move halo.fill (to gold))))

; Each stop but the last rests a moment before the next.
(play tour (buttons true)
  (animation
    (in-order quarter (wait 2.5))
    (in-order third (wait 2.5))
    (in-order two-fifths (wait 2.5))
    golden))

(canvas view garden)
(slider angle (move sunflower.angle (from 80) (to 180)) (label 'angle'))

; Clicking the flower takes it to the golden angle, as the last stop of the tour does.
(on-click sunflower (animation golden))
