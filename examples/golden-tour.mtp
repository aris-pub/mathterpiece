; Why sunflowers use the golden angle. Seed i sits at radius (sqrt i), turned i times an angle.
; Simple fractions of a turn line the seeds up in spokes and leave gaps; the golden angle,
; the most irrational turn there is, packs them evenly. Press play for the tour, pick a step,
; or drag the angle yourself.

(const 'night' '#0b1026')
(const 'gold' '#f6c453')
(const 'chalk' '#e8e4d8')

(func 'seed-color' (params (t 0.0))
  (cond ((< t 0.3) '#9a4f16') ((< t 0.6) '#cf7424') ((< t 0.85) '#e89b2a') (else gold)))

(motif 'flower' (params (n 300) (angle 90.0) (spread 0.5) (size 0.17))
  (repeat i n
    (let ((d (* spread (sqrt i))) (t (/ i n)))
      (circle _
        (pos (polar d (* i angle)))
        (r (* size (sqrt (+ 1 (* 3 t)))))
        (fill (seed-color t))
        (stroke 'none')))))

(scene 'garden'
  (rect 'sky' (center [0 0]) (size [20 20]) (fill night))
  (circle 'halo' (r 9.2) (fill 'none') (fill-opacity 0.12) (stroke 'none'))
  (flower 'sunflower')
  (text 'name' 'a quarter turn' (pos [-9.3 9]) (font-size 0.6) (fill chalk))
  (text 'degrees' $'{sunflower.angle}°' (pos [-9.3 8.2]) (font-size 0.45) (fill chalk) (opacity 0.6)))

(state 'quarter' (= sunflower.angle 90) (= name.value 'a quarter turn') (= halo.fill 'none'))
(state 'third' (= sunflower.angle 120) (= name.value 'a third of a turn') (= halo.fill 'none'))
(state 'two-fifths' (= sunflower.angle 144) (= name.value 'two fifths of a turn') (= halo.fill 'none'))
(state 'golden' (= sunflower.angle 137.508) (= name.value 'the golden angle') (= halo.fill gold))

(canvas 'view' garden)
(play 'tour'
  (from quarter)
  (wait 1.5)
  (to third (duration 2.5) (ease 'ease-in-out'))
  (wait 1.5)
  (to two-fifths (duration 2.5) (ease 'ease-in-out'))
  (wait 1.5)
  (to golden (duration 3) (ease 'ease-out')))
(steps 'jump' (states quarter third two-fifths golden) (duration 1.5) (ease 'ease-in-out'))
(slider 'angle' sunflower.angle (min 80) (max 180) (label 'angle'))
