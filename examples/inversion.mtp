; Inversion in a circle. Move the pointer over the canvas: p follows it, and its inverse q sits on
; the same ray from the center, at distance 1 / |p|, so a point inside the circle goes outside and
; one outside comes in. Rest the pointer on the circle, where p and q meet, and the disk fills in.

(import house paper ink soft red green number variable)
(import math norm)
(import ease cubic-out)

(point p [0.6 0.35])
; The center has no inverse, so there q is drawn at the center.
(point q (or? (* p (/ 1 (* (norm p) (norm p)))) [0 0]))
; Along the ray: p's name sits just inside p, and q's just outside q, so the two never meet.
(point along (or? (* p (/ 0.18 (norm p))) [0.18 0]))

(scene plane (background paper)
  ; The disk is only a tint, and lets the pointer through: only the rim catches it.
  (circle disk (r 1) (fill green) (fill-opacity 0) (pointer-events false))
  (circle unit (r 1) (fill none) (stroke ink) (stroke-width 2))
  ; Everything else lets the pointer through, so the dot under it never hides the circle.
  (group marks (pointer-events false)
    (line_ (from [0 0]) (to (if (> (norm q) (norm p)) q p)) (stroke soft) (stroke-width 1)
        (dash [4 4]))
    (circle_ (r 0.04) (fill ink))
    (group names (defaults (font variable) (fill ink) (halign 'middle') (valign 'middle'))
      (text_ 'p' (pos (- p along)))
      (text_ 'q' (pos (+ q along))))
    (group points (defaults (stroke paper) (stroke-width 2))
      (circle_ (pos p) (r 0.07) (fill red))
      (circle_ (pos q) (r 0.07) (fill green)))
    (text_ $'|p| = {(norm p):.2f}    |q| = {(norm q):.2f}    |p| · |q| = 1'
        (pos [0 -1.75]) (font number) (fill soft) (halign 'middle'))))

(canvas view (x -3) (y -2) (width 6) (height 4) (pan false) (zoom false)
  doc@'The circle, p, and its inverse q.'
  plane
  (on-pointermove p doc@'p follows the pointer.')
  (on-enter unit
      (animation
        (at-once (defaults (duration 0.25) (ease cubic-out))
          (move unit.stroke-width (to 5))
          (move disk.fill-opacity (to 0.16))))
    doc@'Thickens the rim and tints the disk while the pointer is on the rim.')
  (on-leave unit
      (animation
        (at-once (defaults (duration 0.5) (ease cubic-out))
          (move unit.stroke-width (to 2))
          (move disk.fill-opacity (to 0))))
    doc@'Brings the circle back.'))
