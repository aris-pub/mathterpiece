; A pair x, y at level 2 among eight points, drawn to scale: x's half in teal, y's in coral, and
; the points of a random set A ringed. Each button highlights the part of the tree one piece of
; the bounds explains; pressing it again clears it. In the paper, the reader picks these by
; clicking the pieces of the equation in the text.
; Each highlight is a group of its own, drawn over the tree while its piece is picked, so the
; canvas fades it in and out.
; Coordinates are the original SVG's, with y pointing down, negated.

(color fg '#2a2724')
(color muted '#8a8478')
(color teal '#1a6f66')
(color coral '#a65a3a')
(color accent '#4a6584')
(font tick (size 13))
(font name (style 'italic') (size 15))

; Which piece of the bounds is explained: none, the factor (1 − 1/b)², the term 1/b², or the
; second inequality (the first one explains the same as the factor).
(type piece string (one-of 'gap' 'b2' 'hi'))

; Point i's x, and the depths of the points, of each pair's root, of each half's and of the
; whole cluster's.
(func px ((int i)) (+ 70 (* 30 i)))
(real top -50 (const))
(real level1 -78 (const))
(real level2 -106 (const))
(real level3 -162 (const))
(real axis 40 (const))
; The middles of the four pairs, and of the two halves.
(list mid [85 145 205 265] (const))
(list half [115 235] (const))

(motif bracket ((real left 0) (real right 0) (real from 0) (real to 0))
  doc@'Down from two clusters at left and right, and across at the depth where they merge.'
  (line_ (from [left from]) (to [left to]))
  (line_ (from [left to]) (to [right to]))
  (line_ (from [right to]) (to [right from])))

(motif outside ()
  doc@'The tree outside x\'s and y\'s cluster, which fades while a piece is picked.'
  (group_ (defaults (stroke fg) (stroke-width 1.5))
    (bracket_ (left (px 4)) (right (px 5)) (from top) (to level1))
    (bracket_ (left (px 6)) (right (px 7)) (from top) (to level1))
    (bracket_ (left mid[2]) (right mid[3]) (from level1) (to level2))
    (bracket_ (left half[0]) (right half[1]) (from level2) (to level3)))
  (group_ (defaults (fill fg))
    (foreach i 4
      (circle_ (pos [(px (+ i 4)) top]) (r 5)))))

(scene tree
  (piece|none shown none)

  (group axes (defaults (stroke muted) (stroke-width 1) (fill muted) (halign 'end') (font tick))
    (line_ (from [axis top]) (to [axis level3]))
    (foreach depth [level1 level2 level3]
      (line_ (from [(- axis 4) depth]) (to [axis depth])))
    (text_ '0' (pos [(- axis 7) (- top 4)]))
    (text_ 'b' (pos [(- axis 7) (- level1 4)]))
    (text_ 'b²' (pos [(- axis 7) (- level2 4)]))
    (text_ 'b³' (pos [(- axis 7) (- level3 4)])))

  ; x's half in teal and y's in coral, joined where x meets y, at depth b².
  (group cluster (defaults (stroke-width 2.5))
    (bracket_ (left (px 0)) (right (px 1)) (from top) (to level1) (defaults (stroke teal)))
    (line_ (from [mid[0] level1]) (to [mid[0] level2]) (stroke teal))
    (bracket_ (left (px 2)) (right (px 3)) (from top) (to level1) (defaults (stroke coral)))
    (line_ (from [mid[1] level1]) (to [mid[1] level2]) (stroke coral))
    (line_ (from [mid[0] level2]) (to [mid[1] level2]) (stroke fg))
    (foreach i 4
      (circle_ (pos [(px i) top]) (r 5) (fill (if (< i 2) teal coral)))))

  (outside whole)
  (outside faint (defaults (opacity 0.2)))

  ; The points of A: x's first neighbour, and a point outside the cluster or, for the pieces where
  ; A meets both halves, one in y's half.
  (group rings (defaults (fill none) (stroke accent) (stroke-width 2))
    (circle_ (pos [(px 0) top]) (r 10)))
  (group ring-outside (defaults (fill none) (stroke accent) (stroke-width 2))
    (circle_ (pos [(px 6) top]) (r 10)))
  (group ring-in-y (defaults (fill none) (stroke accent) (stroke-width 2))
    (circle_ (pos [(px 2) top]) (r 10)))

  (group names (defaults (fill fg) (halign 'middle') (font name))
    (text_ 'x' (pos [(px 1) (+ top 14)]))
    (text_ 'y' (pos [(px 2) (+ top 14)])))

  ; The factor (1 − 1/b)²: from b, where each half merges, to b², where x meets y. A meets only
  ; x's half.
  (group gap-highlight
    (bracket_ (left (px 0)) (right (px 1)) (from top) (to level1)
              (defaults (stroke teal) (stroke-width 3.5)))
    (line_ (from [mid[0] level2]) (to [mid[1] level2]) (stroke teal) (stroke-width 3.5))
    (line_ (from [(+ axis 6) top]) (to [(+ axis 6) level1]) (stroke muted) (stroke-width 5))
    (line_ (from [(+ axis 6) level1]) (to [(+ axis 6) level2]) (stroke teal) (stroke-width 5))
    (line_ (from [axis level1]) (to [(px 0) level1]) (stroke accent) (stroke-width 1)))

  ; Where A meets both halves, both distances are at most the inner depth b: the term 1/b², and
  ; the second inequality, which also counts the gap across x and y's join.
  (group both-highlight
    (bracket_ (left (px 0)) (right (px 1)) (from top) (to level1)
              (defaults (stroke coral) (stroke-width 3.5)))
    (bracket_ (left (px 2)) (right (px 3)) (from top) (to level1)
              (defaults (stroke coral) (stroke-width 3.5)))
    (line_ (from [(+ axis 6) top]) (to [(+ axis 6) level1]) (stroke coral) (stroke-width 5))
    (line_ (from [(+ axis 13) top]) (to [(+ axis 13) level2]) (stroke fg) (stroke-width 5))
    (line_ (from [axis level1]) (to [(px 0) level1]) (stroke accent) (stroke-width 1)))
  (group join-highlight
    (line_ (from [mid[0] level2]) (to [mid[1] level2]) (stroke fg) (stroke-width 3.5))))

(canvas view (x 0) (y -182) (width 300) (height 162) (pan false) (zoom false) (toggle-duration 0.25)
  doc@'The tree, the points, and the highlight of the piece picked.'
  axes
  (when (none? shown) whole)
  (when (some? shown) faint)
  cluster
  (when (= shown 'gap') gap-highlight)
  (when (or (= shown 'b2') (= shown 'hi')) both-highlight)
  (when (= shown 'hi') join-highlight)
  rings
  (when (not (or (= shown 'b2') (= shown 'hi'))) ring-outside)
  (when (or (= shown 'b2') (= shown 'hi')) ring-in-y)
  names)

; One button per piece of the bounds.
(button gap (animation (move shown (to (if (= shown 'gap') none 'gap')) (duration 0.25)))
    (label 'the factor (1 − 1/b)²')
  doc@'Highlights what the factor (1 − 1/b)² explains, or clears it if it is shown.')
(button b2 (animation (move shown (to (if (= shown 'b2') none 'b2')) (duration 0.25)))
    (label 'the term 1/b²')
  doc@'Highlights what the term 1/b² explains, or clears it if it is shown.')
(button lower (animation (move shown (to (if (= shown 'gap') none 'gap')) (duration 0.25)))
    (label 'the first ≤')
  doc@'Highlights what the first ≤ explains, or clears it if it is shown.')
(button upper (animation (move shown (to (if (= shown 'hi') none 'hi')) (duration 0.25)))
    (label 'the second ≤')
  doc@'Highlights what the second ≤ explains, or clears it if it is shown.')
