; A pair x, y at level 2 among eight points, drawn to scale: x's half in green, y's in red, and
; the points of a random set A ringed. Click a term of the equation above the tree, the factor
; (1 − 1/b)², either ≤, or the term 1/b², to highlight the part of the tree it explains; click it
; again to clear it. A box shows behind the colored terms while the pointer is on them.
; Each highlight is a group of its own, drawn over the tree while its piece is picked, so the
; canvas fades it in and out.
; Coordinates are the original SVG's, with y pointing down, negated.

(import house ink soft red green blue)
; Behind a term under the pointer: BRAIID's gray-100.
(color wash (light-dark '#edf0f2' '#2a3740'))
(font tick (size 13))
(font name (style 'italic') (size 15))

; Which piece of the bounds is explained: none, the factor (1 − 1/b)², the term 1/b², or the
; second inequality (the first one explains the same as the factor).
(type piece string (one-of 'gap' 'b2' 'hi'))
; Which piece is shown: a global, since the scene and the formula both read it.
(piece|none shown none)

; Point i's x, and the depths of the points, of each pair's root, of each half's and of the
; whole cluster's.
(func px ((int i)) (+ 70 (* 30 i)))
(real top -50 (const))
(real level1 -78 (const))
(real level2 -106 (const))
(real level3 -162 (const))
(real axis 40 (const))
; The middles of the four pairs, and of the two halves.
(list mid [85 145 205 265] (const))
(list half [115 235] (const))

(motif bracket ((real left 0) (real right 0) (real from 0) (real to 0))
  doc@'Down from two clusters at left and right, and across at the depth where they merge.'
  (line_ (from [left from]) (to [left to]))
  (line_ (from [left to]) (to [right to]))
  (line_ (from [right to]) (to [right from])))

(motif outside ()
  doc@'The tree outside x\'s and y\'s cluster, which fades while a piece is picked.'
  (group_ (defaults (stroke ink) (stroke-width 1.5))
    (bracket_ (left (px 4)) (right (px 5)) (from top) (to level1))
    (bracket_ (left (px 6)) (right (px 7)) (from top) (to level1))
    (bracket_ (left mid[2]) (right mid[3]) (from level1) (to level2))
    (bracket_ (left half[0]) (right half[1]) (from level2) (to level3)))
  (group_ (defaults (fill ink))
    (foreach i 4
      (circle_ (pos [(px (+ i 4)) top]) (r 5)))))

(scene tree
  (group axes (defaults (stroke soft) (stroke-width 1) (fill soft) (halign 'end') (font tick))
    (line_ (from [axis top]) (to [axis level3]))
    (foreach depth [level1 level2 level3]
      (line_ (from [(- axis 4) depth]) (to [axis depth])))
    (text_ '0' (pos [(- axis 7) (- top 4)]))
    (text_ 'b' (pos [(- axis 7) (- level1 4)]))
    (text_ 'b²' (pos [(- axis 7) (- level2 4)]))
    (text_ 'b³' (pos [(- axis 7) (- level3 4)])))

  ; x's half in green and y's in red, joined where x meets y, at depth b².
  (group cluster (defaults (stroke-width 2.5))
    (bracket_ (left (px 0)) (right (px 1)) (from top) (to level1) (defaults (stroke green)))
    (line_ (from [mid[0] level1]) (to [mid[0] level2]) (stroke green))
    (bracket_ (left (px 2)) (right (px 3)) (from top) (to level1) (defaults (stroke red)))
    (line_ (from [mid[1] level1]) (to [mid[1] level2]) (stroke red))
    (line_ (from [mid[0] level2]) (to [mid[1] level2]) (stroke ink))
    (foreach i 4
      (circle_ (pos [(px i) top]) (r 5) (fill (if (< i 2) green red)))))

  (outside whole)
  (outside faint (defaults (opacity 0.2)))

  ; The points of A: x's first neighbour, and a point outside the cluster or, for the pieces where
  ; A meets both halves, one in y's half.
  (group rings (defaults (fill none) (stroke blue) (stroke-width 2))
    (circle_ (pos [(px 0) top]) (r 10)))
  (group ring-outside (defaults (fill none) (stroke blue) (stroke-width 2))
    (circle_ (pos [(px 6) top]) (r 10)))
  (group ring-in-y (defaults (fill none) (stroke blue) (stroke-width 2))
    (circle_ (pos [(px 2) top]) (r 10)))

  (group names (defaults (fill ink) (halign 'middle') (font name))
    (text_ 'x' (pos [(px 1) (+ top 14)]))
    (text_ 'y' (pos [(px 2) (+ top 14)])))

  ; The factor (1 − 1/b)²: from b, where each half merges, to b², where x meets y. A meets only
  ; x's half.
  (group gap-highlight
    (bracket_ (left (px 0)) (right (px 1)) (from top) (to level1)
              (defaults (stroke green) (stroke-width 3.5)))
    (line_ (from [mid[0] level2]) (to [mid[1] level2]) (stroke green) (stroke-width 3.5))
    (line_ (from [(+ axis 6) top]) (to [(+ axis 6) level1]) (stroke soft) (stroke-width 5))
    (line_ (from [(+ axis 6) level1]) (to [(+ axis 6) level2]) (stroke green) (stroke-width 5))
    (line_ (from [axis level1]) (to [(px 0) level1]) (stroke blue) (stroke-width 1)))

  ; Where A meets both halves, both distances are at most the inner depth b: the term 1/b², and
  ; the second inequality, which also counts the gap across x and y's join.
  (group both-highlight
    (bracket_ (left (px 0)) (right (px 1)) (from top) (to level1)
              (defaults (stroke red) (stroke-width 3.5)))
    (bracket_ (left (px 2)) (right (px 3)) (from top) (to level1)
              (defaults (stroke red) (stroke-width 3.5)))
    (line_ (from [(+ axis 6) top]) (to [(+ axis 6) level1]) (stroke red) (stroke-width 5))
    (line_ (from [(+ axis 13) top]) (to [(+ axis 13) level2]) (stroke ink) (stroke-width 5))
    (line_ (from [axis level1]) (to [(px 0) level1]) (stroke blue) (stroke-width 1)))
  (group join-highlight
    (line_ (from [mid[0] level2]) (to [mid[1] level2]) (stroke ink) (stroke-width 3.5))))

(canvas view (x 0) (y -182) (width 300) (height 162) (pan false) (zoom false) (toggle-duration 0.25)
  doc@'The tree, the points, and the highlight of the piece picked.'
  axes
  (when (none? shown) whole)
  (when (some? shown) faint)
  cluster
  (when (= shown 'gap') gap-highlight)
  (when (or (= shown 'b2') (= shown 'hi')) both-highlight)
  (when (= shown 'hi') join-highlight)
  rings
  (when (not (or (= shown 'b2') (= shown 'hi'))) ring-outside)
  (when (or (= shown 'b2') (= shown 'hi')) ring-in-y)
  names)

(func lit ((piece|none p) (piece mine))
  doc@'Full when nothing is picked or this piece is, dim otherwise.'
  (if (or (none? p) (= p mine)) 1 0.35))

(formula bounds
  doc@'Equation (4.1): the squared stretch of the pair, bounded below and above.'
    (defaults (padding 3) (rounding 4))
  tex'\term{gap}{\Big(1-\frac1b\Big)^2} P_h(p)
      \mathrel{\term{lo}{\le}} \frac{\mathbb E\,\big(d(x,A)-d(y,A)\big)^2}{d(x,y)^2}
      \mathrel{\term{hi}{\le}} P_h(p) + \term{b2}{\frac1{b^2}}'
  (term gap (fill green) (opacity (lit shown 'gap')))
  (term lo (opacity (lit shown 'gap')))
  (term hi (opacity (lit shown 'hi')))
  (term b2 (fill red) (opacity (lit shown 'b2'))))

(display eq bounds doc@'Equation (4.1), whose terms pick what the tree highlights.')

; Clicking a term shows what it explains, or clears it if it is shown. Each term but the first
; ≤ is named after the piece it shows; the first ≤ explains the same as the factor.
(foreach piece ['gap' 'hi' 'b2']
  (on-click #'bounds.{piece}'
      (animation (move shown (to (if (= shown piece) none piece)) (duration 0.25)))
    doc@'Highlights what the term explains.'))
(on-click bounds.lo (animation (move shown (to (if (= shown 'gap') none 'gap')) (duration 0.25)))
  doc@'Highlights what the first ≤ explains.')

; A box fades in behind each colored term while the pointer is on it.
(on-enter bounds.gap (animation (move bounds.gap.background (to wash) (duration 0.2))))
(on-leave bounds.gap (animation (move bounds.gap.background (to none) (duration 0.2))))
(on-enter bounds.b2 (animation (move bounds.b2.background (to wash) (duration 0.2))))
(on-leave bounds.b2 (animation (move bounds.b2.background (to none) (duration 0.2))))

(readout note
    (if (= shown 'gap') 'If A meets only x\'s half, the gap covers the highlighted stretch.'
      (if (= shown 'b2') 'If A meets both halves, both distances are at most b, the inner depth.'
        (if (= shown 'hi') 'One half, both halves, or neither: together at most P plus 1/b².'
          'Click a term of the equation.')))
  doc@'What the piece picked explains.')
