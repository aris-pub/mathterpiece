; A landscape drawn twice: in greys, and above that in color, inside a group clipped to a circle
; that follows the lens. Drag the lens to see the colors, each a mix, lighten or darken of the
; page's color tokens, and change its size with the slider.

(import house paper ink soft terracotta teal saffron plum code)

(motif landscape ((real grey 0 (>= 0) (<= 1)))
  doc@'The landscape and its color swatches, every color mixed grey of the way toward soft.'
  (group land (defaults (stroke none)) (clip (rect frame (pos [0 1.5]) (width 15) (height 6.4)))
    (rect sky (pos frame.pos) (width frame.width) (height frame.height)
        (fill (mix (mix saffron paper 0.7) soft grey)))
    (circle sun (pos [3.8 3.3]) (r 0.9) (fill (mix (lighten saffron 0.3) soft grey)))
    (ellipse far-left (pos [-3 0.6]) (rx 6) (ry 2.6) (fill (mix (mix plum paper 0.45) soft grey)))
    (ellipse far-right (pos [4.8 0.2]) (rx 5) (ry 2.3) (fill far-left.fill))
    (ellipse near (pos [2 -1.2]) (rx 7) (ry 2.3) (fill (mix (mix teal saffron 0.35) soft grey)))
    (rect house (pos [1.6 1.3]) (width 1) (height 0.7)
        (fill (mix (lighten terracotta 0.45) soft grey)))
    ; The roof overhangs the walls on both sides.
    (triangle roof (a (+ (top-left house) [-0.15 0])) (b (+ (top-right house) [0.15 0]))
        (c (+ (top house) [0 0.6])) (fill (mix (darken terracotta 0.15) soft grey)))
    (ellipse field (pos [-4.5 -2]) (rx 6) (ry 1.9) (fill (mix (darken teal 0.25) soft grey)))
    (foreach k 4
      (let ((x (+ -5.8 (* 0.9 k))))
        (triangle #'tree-{k}' (a [(- x 0.4) -0.4]) (b [(+ x 0.4) -0.4])
            (c [x (+ 0.7 (* 0.15 (mod k 2)))]) (fill (mix (darken teal 0.5) soft grey))))))

  ; Two columns of swatches under the picture, one under its left half and one under its right.
  ; Each swatch takes its color from the shape it shows.
  (real side 0.4 (const))
  (column left-swatches (translate (+ (bottom-left land) [0.5 -1.2])) (gap 0.2)
      (defaults (stroke none))
    (foreach c [sky.fill sun.fill far-left.fill near.fill]
      (rect_ (width side) (height side) (fill c))))
  (column right-swatches (translate (+ (bottom land) [0.6 -1.2])) (gap 0.2) (defaults (stroke none))
    (foreach c [field.fill tree-0.fill house.fill roof.fill]
      (rect_ (width side) (height side) (fill c)))))

; How each swatch's color is made, in the order the swatches are stacked.
(list[string] left-mixes
    ['(mix saffron paper 0.7)' '(lighten saffron 0.3)' '(mix plum paper 0.45)' '(mix teal saffron 0.35)']
    (const))
(list[string] right-mixes
    ['(darken teal 0.25)' '(darken teal 0.5)' '(lighten terracotta 0.45)' '(darken terracotta 0.15)']
    (const))

(scene view-scene (background paper)
  (real size 1.8 (>= 0.8) (<= 3))

  (landscape dull (grey 0.75))

  ; The glass is what the reader drags: it has a fill, though one that cannot be seen, so the
  ; pointer reaches it everywhere inside, not only on its rim.
  (circle glass (pos [2.2 2]) (r size) (fill paper) (fill-opacity 0) (stroke ink)
      (stroke-width 3))
  (group lens (clip (circle window (pos glass.pos) (r size)))
    (landscape bright))

  ; Each form sits just right of the swatch it makes, and the last line is centered under the
  ; picture, below the swatches.
  (group forms (defaults (fill soft) (font code) (valign 'middle'))
    (text_
        $'(group lens (clip (circle window (pos [{glass.x:.1f} {glass.y:.1f}]) (r {size:.1f}))) …)'
        (pos (bottom dull.land 0.45)) (halign 'middle'))
    (foreach k 4
      (text_ left-mixes[k] (pos (right dull.left-swatches[k] 0.2)))
      (text_ right-mixes[k] (pos (right dull.right-swatches[k] 0.2))))
    (text_ 'underneath, each color is mixed toward soft: (mix … soft 0.75)'
        (pos [(. (bottom dull.land) 0) (. (bottom dull.left-swatches 0.55) 1)]) (halign 'middle'))))

(canvas view (x -8) (y -5.9) (width 16) (height 10.9) (pan false) (zoom false)
  doc@'The landscape in greys, and in color under the lens.'
  dull lens glass forms)

(on-drag glass glass.pos doc@'Moves the lens.')
(slider lens-size (move size (from 0.8) (to 3)) (label 'lens size'))
