; Palettes of named colors, and colormaps: (import colors) and colors.okabe-ito.orange or
; (colors.viridis 0.3), or (import colors okabe-ito viridis). Each named color is a token, so a
; page restyles it through its CSS variable, --mtp-colors-okabe-ito-orange.

; Okabe and Ito's eight colors, which stay apart for readers with any common color blindness.
(namespace okabe-ito
  (color orange '#e69f00')
  (color sky-blue '#56b4e9')
  (color bluish-green '#009e73')
  (color yellow '#f0e442')
  (color blue '#0072b2')
  (color vermillion '#d55e00')
  (color reddish-purple '#cc79a7')
  (color black '#000000'))

; Matplotlib's default ten, the colors its plots take one after another.
(namespace tab10
  (color blue '#1f77b4')
  (color orange '#ff7f0e')
  (color green '#2ca02c')
  (color red '#d62728')
  (color purple '#9467bd')
  (color brown '#8c564b')
  (color pink '#e377c2')
  (color gray '#7f7f7f')
  (color olive '#bcbd22')
  (color cyan '#17becf'))

; Colormaps from 0 to 1, each 17 colors evenly spaced, sampled from matplotlib's own: so close to
; them that the difference does not show. A figure gives its values its own way, for example
; (viridis (/ depth 50)).
(colormap viridis
    ['#440154' '#48186a' '#472d7b' '#424086' '#3b528b' '#33638d' '#2c728e' '#26828e' '#21918c'
     '#1fa088' '#28ae80' '#3fbc73' '#5ec962' '#84d44b' '#addc30' '#d8e219' '#fde725'])
(colormap magma
    ['#000004' '#0a0822' '#1d1147' '#36106b' '#51127c' '#6a1c81' '#832681' '#9c2e7f' '#b73779'
     '#d0416f' '#e75263' '#f56b5c' '#fc8961' '#fea772' '#fec488' '#fde2a3' '#fcfdbf'])
; Readable with the common kinds of color blindness, as viridis and magma also are.
(colormap cividis
    ['#00224e' '#002e6a' '#1a386f' '#32436d' '#434e6c' '#535a6d' '#61656f' '#6f7073' '#7d7c78'
     '#8c8878' '#9b9476' '#aba072' '#bcae6c' '#cdbb63' '#dec958' '#f0d846' '#fee838'])
; Diverging, for values on either side of a middle: ColorBrewer's eleven, blue to red.
(colormap blue-white-red
    ['#053061' '#2166ac' '#4393c3' '#92c5de' '#d1e5f0' '#f7f7f7' '#fddbc7' '#f4a582' '#d6604d'
     '#b2182b' '#67001f'])
