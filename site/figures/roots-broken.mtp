(real k -1 (>= -2) (<= 2))
(real r (sqrt (- k)))
(scene parabola
  (line_ (from [-2 0]) (to [2 0]) (stroke 'gray'))
  (parametric p (for t -2 2) [t (+ (* t t) k)] (stroke 'teal'))
  (circle lo (r 0.1) (pos [(- r) 0]) (fill 'crimson'))
  (circle hi (r 0.1) (pos [r 0]) (fill 'crimson')))
(canvas c (x -2) (y -2.2) (width 4) (height 3.4) parabola)
(slider shift (move k (from -2) (to 2)) (label 'k'))
