; a² + b² = c²: point at a term or a square to light both
(point q [1.2 0.9])
(string lit '')
(palette hue (a 'crimson') (b 'royalblue') (c 'slateblue'))

; what the figure is
(scene squares
  (let ((x q.x) (y q.y) (n (as point [(- y) x])) (m (+ q n)))
    ; what the figure looks like
    (polygon sq-a (points [[0 0] [x 0] [x (- x)] [0 (- x)]])
             (fill hue.a) (fill-opacity (if (= lit 'a') 0.75 0.25)))
    (polygon sq-b (points [[x 0] [(+ x y) 0] [(+ x y) y] [x y]])
             (fill hue.b) (fill-opacity (if (= lit 'b') 0.75 0.25)))
    (polygon sq-c (points [[0 0] q m n])
             (fill hue.c) (fill-opacity (if (= lit 'c') 0.75 0.25))))
  (circle corner (r 0.07) (pos q) (fill hue.c)))
(formula eq tex'\term{a}{a^2} + \term{b}{b^2} = \term{c}{c^2} \quad \term{v}{}'
  (term a (fill hue.a) (background (if (= lit 'a') 'lavender' none)))
  (term b (fill hue.b) (background (if (= lit 'b') 'lavender' none)))
  (term c (fill hue.c) (background (if (= lit 'c') 'lavender' none)))
  (term v (tex $'{(^ q.x 2):.2f} + {(^ q.y 2):.2f}
                 = {(+ (^ q.x 2) (^ q.y 2)):.2f}')))

; what it does: drag the corner, point at a term or a square
(canvas v (x -1.4) (y -1.6) (width 3.8) (height 3.8) squares
  (on-drag corner (move q (to pointer)))
  (foreach s ['a' 'b' 'c']
    (on-enter #'sq-{s}' (set lit s)) (on-leave #'sq-{s}' (set lit ''))))
(display shown eq (foreach s ['a' 'b' 'c']  ; typechecked: each term exists
  (on-enter #'eq.{s}' (set lit s)) (on-leave #'eq.{s}' (set lit ''))))
