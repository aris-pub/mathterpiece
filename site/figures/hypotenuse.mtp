; a right triangle: drag its corner, and the formula follows
(point q [1.2 0.9])
(real c (sqrt (+ (^ q.x 2) (^ q.y 2))))  ; typechecked

; what the figure is
(scene triangle
  (polygon sides (points [[0 0] [q.x 0] q])
           ; what the figure looks like
           (fill 'cornflowerblue') (fill-opacity 0.12)
           (stroke 'cornflowerblue'))
  (circle corner (r 0.08) (pos q) (fill 'mediumslateblue')))
(formula pythagoras tex'c = \sqrt{a^2 + b^2} = \term{c}{}'
  (term c (tex $'{c:.2f}')))

; what it does: drag the corner, or tap it, then tap a spot
(canvas v (x -0.3) (y -0.3) (width 2.2) (height 1.6)
  triangle
  (on-drag corner (move q (to pointer))))
(display shown pythagoras)
