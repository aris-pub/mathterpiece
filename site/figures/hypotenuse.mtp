; a right triangle: drag its corner, and the formula follows
(point q [1.2 0.9])
(real a (abs q.x))
(real b (abs q.y))
(real c (sqrt (+ (* a a) (* b b))))  ; typechecked

; what the figure is
(scene triangle
  (polygon sides (points [[0 0] [q.x 0] q])
           ; what the figure looks like
           (fill '#0e9ae9') (fill-opacity 0.12)
           (stroke '#0e9ae9'))
  (circle corner (r 0.08) (pos q) (fill '#ad71f2')))
(formula pythagoras
  tex'c = \sqrt{a^2 + b^2} = \term{value}{}'
  (term value (tex $'{c:.2f}')))

; what it does: drag the corner, or tap it
; and then tap where it goes
(canvas v (x -0.3) (y -0.3) (width 2.2) (height 1.6) triangle
  (on-drag corner (move q (to pointer))))
(display shown pythagoras)
