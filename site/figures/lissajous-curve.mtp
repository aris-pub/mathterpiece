; a Lissajous curve: x = sin(a t + phase), y = sin(b t)
(import ease linear)
(type freq int (>= 1) (<= 7))  ; typechecked: whole, 1 to 7
(freq a 3)
(freq b 2)
(real phase 0 (wrap 0 360))

; what the figure is
(scene curve
  (polyline lissajous
    (points (map (range 0 360 (num 721))
      (fn t [(sind (+ (* a t) phase)) (sind (* b t))])))
    ; what the figure looks like
    (stroke 'lightseagreen') (stroke-width 3)))

; what it does
(animation spin (loop)
  (move phase (from 0) (to 360) (duration 12) (ease linear)))
(canvas v (x -1.1) (y -1.1) (width 2.2) (height 2.2) curve
  (on-ready (animation spin)))

; accessible and interactive: mouse, touch or keyboard
(slider across (move a (from 1) (to 7)) (label 'a'))
(slider up (move b (from 1) (to 7)) (label 'b'))
(readout ratio $'a : b = {a} : {b}')
