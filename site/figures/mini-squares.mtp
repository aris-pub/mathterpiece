(real a 8 (>= 0) (<= 30))
(scene s
  (foreach i 36
    (polygon_
      (points (map [0 1 2 3]
        (fn j (polar (or? (/ 1.41 (^ (+ (cosd a) (sind a)) i)) 0)
                     (+ 45 (* i a) (* 90 j))))))
      (fill none) (stroke-width 1.5)
      (stroke (mix 'royalblue' 'crimson' (/ i 36))))))
(canvas v (x -1.02) (y -1.02) (width 2.04) (height 2.04) s
  (on-ready
    (animation (loop) (move a (to 30) (duration 14))
                      (move a (to 2) (duration 14)))))
