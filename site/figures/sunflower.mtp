; a sunflower: seed i sits at radius √i,
; turned i times the angle
(int n 300 (const))
(real angle 137.5 (>= 130) (<= 145))  ; typechecked

; what the figure is
(scene sunflower
  (foreach i n
    (circle_ (pos (polar (* 0.055 (sqrt i)) (* i angle)))
             ; what the figure looks like
             (r 0.028)
             (fill (mix '#f5a524' '#ff6b6b' (/ i n))))))

; what it does
(animation drift (loop)
  (move angle (from 135) (to 140) (duration 20))
  (move angle (from 140) (to 135) (duration 20)))
(canvas v (x -1.05) (y -1.05) (width 2.1) (height 2.1)
  sunflower
  (on-ready (animation drift)))

; accessible and interactive: mouse, touch or keyboard
(slider turn (move angle (from 130) (to 145))
  (label 'angle in degrees'))
(button again (label 'play') (animation drift))
