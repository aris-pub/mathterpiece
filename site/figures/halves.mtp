; 1/2 + 1/4 + 1/8 + …: each term halves the gap to 1
(int n 3 (>= 1) (<= 10))  ; typechecked: 1 to 10 terms

; what the figure is: a bar of length 1, cut in halves
(scene bar
  (rect whole (pos [0.5 0]) (width 1) (height 0.12)
        (fill none) (stroke 'gray'))
  (foreach k 10
    (rect_ (pos [(- 1 (* 0.75 (^ 2 (- k)))) 0]) (height 0.12)
           (width (^ 2 (- (+ k 1))))
           ; what the figure looks like
           (fill (if (= (mod k 2) 0) 'royalblue' 'cornflowerblue'))
           (opacity (if (< k n) 1 0)))))

; what it does: the slider and the numbers sit in the sentence
(canvas v (x -0.05) (y -0.15) (width 1.1) (height 0.3) bar)
(slider terms (move n (from 1) (to 10)))
(readout sum $'{(- 1 (^ 2 (- n))):.4f}')
(readout gap $'{(^ 2 (- n)):.4f}')
(readout count $'{n}')
