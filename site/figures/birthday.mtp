; the birthday problem: among 23 people a shared birthday is likely
(int n 23 (>= 2) (<= 60))  ; typechecked: 2 to 60 people
(func pair ((int m)) (- 1 (reduce (range m) 1
  (fn ((real q) (int k)) (* q (/ (- 365 k) 365))))))
(func yours ((int m)) (- 1 (^ (/ 364 365) (- m 1))))

; what the figure is: both chances, for up to 60 people
(scene chance
  (line_ (from [0 15]) (to [60 15]) (stroke #'gray') (dash {4 4}))
  (line_ (from [n 0]) (to [n 30]) (stroke #'gray'))
  ; what the figure looks like
  (polyline_ (stroke #'slateblue') (stroke-width 3)
    (points (map (range 61) (fn ((int m)) [m (* 30 (pair m))]))))
  (polyline_ (stroke #'crimson') (stroke-width 3)
    (points (map (range 61) (fn ((int m)) [m (* 30 (yours m))]))))
  (circle_ (r 1) (pos [n (* 30 (pair n))]) (fill #'slateblue'))
  (circle_ (r 1) (pos [n (* 30 (yours n))]) (fill #'crimson')))

; what it does: the slider and the numbers sit in the sentence
(canvas v (x -2) (y -2) (width 64) (height 34) chance)
(slider people (animation (move n (from 2) (to 60) (duration 0))))
(readout count f'{n}')
(readout odds f'{(* 100 (pair n)):.1f}%')
(readout mine f'{(* 100 (yours n)):.1f}%')
