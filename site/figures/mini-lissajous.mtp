(import ease linear)
(real phase 0 (wrap 0 360))
(scene s
  (polyline curve
    (points (map (range 0 360 (num 361))
                 (fn t [(sind (+ (* 3 t) phase)) (sind (* 2 t))])))
    (stroke 'seagreen') (stroke-width 3)))
(canvas v (x -1.15) (y -1.15) (width 2.3) (height 2.3) s
  (on-ready
    (animation (loop) (move phase (to 360) (duration 12) (ease linear)))))
