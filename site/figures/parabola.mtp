; drag the vertex or set a: the formula rewrites itself,
; and gives the roots, or says that there are none
(import marks)
(point v [0.5 -1])
(real a 0.8 (>= 0.2) (<= 2))
(real|none r (sqrt (/ (- v.y) a)))  ; typechecked: none, with no roots
(string lit '')

; what the figure is
(scene graph
  (marks.axes_ (left -3) (right 3) (bottom -2) (top 3) (stroke 'gray'))
  (parametric curve (for t -3 3) [t (+ v.y (* a (^ (- t v.x) 2)))]
    ; what the figure looks like
    (stroke 'slateblue') (stroke-width 3))
  (circle vertex (r 0.12) (pos v) (fill 'slateblue'))
  (group roots (defaults (fill 'crimson'))
    (circle|none r1 (r (if (= lit 'r') 0.16 0.1)) (pos [(- v.x r) 0]))
    (circle|none r2 (r (if (= lit 'r') 0.16 0.1)) (pos [(+ v.x r) 0]))))
(formula eq tex'\begin{gathered}
    y = \term{a}{}(x \term{h}{})^2 \term{k}{} \\ \term{r}{}\end{gathered}'
  (term a (tex $'{a:.2f}')) (term h (tex $'{(- v.x):+.2f}'))
  (term k (tex $'{v.y:+.2f}'))
  (term r (tex (or? $'x = {v.x:.2f} \\pm {r:.2f}' '\\text{no real roots}'))
          (fill 'crimson') (background (if (= lit 'r') 'lavender' none))))

; what it does: drag the vertex, set a, point at the roots
(canvas plot (x -3.2) (y -2.2) (width 6.4) (height 5.4) graph
  (on-drag vertex (move v (to pointer))))
(slider spread (move a (from 0.2) (to 2)) (label 'a'))
(display shown eq
  (on-enter eq.r (set lit 'r')) (on-leave eq.r (set lit '')))
