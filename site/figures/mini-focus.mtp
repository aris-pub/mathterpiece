; the logo, twice its size, drawn by mtp: mtp in the middle and the brackets near its corners.
; In a loop, t and p fade out while the m moves to the center and the brackets close in on it
; with a full turn, ending as in the logo; then the same moves run back.
(import ease cubic-in-out)
; the top-left bracket of the exported logo, traced from its paths, in logo units, around the
; center of its outer corner; the bottom-right bracket is the same, turned half a turn
(list[point] bracket
  [[-6.2 0] [-6.08 1.21] [-5.73 2.37] [-5.16 3.44] [-4.38 4.38] [-3.44 5.16] [-2.37 5.73]
   [-1.21 6.08] [0 6.2] [18.6 6.2] [19.81 6.08] [20.97 5.73] [22.04 5.16] [22.98 4.38]
   [23.76 3.44] [24.33 2.37] [24.68 1.21] [24.8 0] [24.8 -6.14] [12.4 -6.14] [12.4 -6.09]
   [11.19 -6.2] [10.03 -6.56] [8.96 -7.13] [8.02 -7.9] [7.24 -8.84] [6.67 -9.91]
   [6.32 -11.08] [6.2 -12.29] [6.2 -36.86] [0 -36.86] [0 -36.91] [-1.21 -36.8]
   [-2.37 -36.44] [-3.44 -35.87] [-4.38 -35.1] [-5.16 -34.16] [-5.73 -33.09]
   [-6.08 -31.92] [-6.2 -30.71]]
  (const))
(real a -4.5)
(real tp 1 (>= 0) (<= 1))
(real cx 145)
(real cr 145)
(real cy 145)
(real phi 0)
(real o 0.35 (>= 0) (<= 1))
(font logo (family '"Crimson Pro", Georgia, serif') (weight 600) (size 168))
(color ink (light-dark #'#51636f' #'#ced6dc'))
(scene b
  ; m ends where tp starts, at a, so the two touch at any size: text is sized in pixels
  (text m 'm' (font logo) (pos [a -34]) (halign 'end') (fill ink))
  (text rest 'tp' (font logo) (pos [a -34]) (halign 'start') (fill ink) (opacity tp))
  (group brackets (transform (rotate phi))
                  (defaults (fill #'#ad71f2') (stroke none) (opacity o))
    (polygon_ (points (map bracket (fn p (+ [(- cx) cy] (* 2 p))))))
    (polygon_ (points (map bracket (fn p (- [cr (- cy)] (* 2 p))))))))
(animation cycle (loop)
  (wait 1.2)
  (at-once (defaults (duration 1.8) (ease cubic-in-out))
    (move tp (to 0)) (move a (to 61.8)) (move cx (to 115.4)) (move cr (to 110))
    (move cy (to 56.4))
    (move phi (to 360)) (move o (to 1)))
  (wait 1.6)
  (at-once (defaults (duration 1.8) (ease cubic-in-out))
    (move tp (to 1)) (move a (to -4.5)) (move cx (to 145)) (move cr (to 145))
    (move cy (to 145))
    (move phi (to 0)) (move o (to 0.35))))
(canvas v (x -210) (y -210) (width 420) (height 420) b
  (on-ready (animation cycle)))
