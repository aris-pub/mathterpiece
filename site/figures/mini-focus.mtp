; the logo's two brackets, as in the exported logo (arms 12.4 thick, vertical arm 30.7 and
; horizontal arm 18.6 between the centers of their round ends), three times as large,
; closing in and opening out
(import ease cubic-in-out)
(real s 1 (>= 0.3) (<= 1))
(scene b
  (group brackets (defaults (stroke '#ad71f2') (stroke-width 37) (fill none)
                            (line-cap 'round') (line-join 'round'))
    (let ((c (* s [-150 150])) (down (+ c [0 -92])) (right (+ c [56 0])))
      (polyline_ (points [down c right])))
    (let ((c (* s [150 -150])) (up (+ c [0 92])) (left (+ c [-56 0])))
      (polyline_ (points [up c left])))))
(canvas v (x -210) (y -210) (width 420) (height 420) b
  (on-ready
    (animation (loop) (wait 1.5) (move s (to 0.45) (duration 1.3) (ease cubic-in-out))
                      (wait 1.5) (move s (to 1) (duration 1.3) (ease cubic-in-out)))))
