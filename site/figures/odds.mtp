; 1 + 3 + 5 + … + (2n − 1) = n²: each odd number is an L
(int shown 1 (>= 1) (<= 6))  ; typechecked: 1 to 6 Ls

; what the figure is: a 6 × 6 square of unit squares
(scene grid
  (foreach i 6
    (foreach j 6
      (rect_ (pos [i j]) (width 0.9) (height 0.9) (rx 0.1)
             ; what the figure looks like
             (fill (mix 'gold' 'crimson' (/ (max i j) 5)))
             (opacity (if (< (max i j) shown) 1 0.08))))))

; what it does: each step of the proof adds the next L
(canvas v (x -0.6) (y -0.6) (width 6.2) (height 6.2) grid)
(play proof (buttons true)
  (labels '1 = 1²' '1 + 3 = 2²' '1 + 3 + 5 = 3²' '+ 7 = 4²'
          '+ 9 = 5²' '+ 11 = 6²')
  (animation (set shown 1) (move shown (to 2) (duration 0.6))
             (move shown (to 3) (duration 0.6))
             (move shown (to 4) (duration 0.6))
             (move shown (to 5) (duration 0.6))
             (move shown (to 6) (duration 0.6))))
