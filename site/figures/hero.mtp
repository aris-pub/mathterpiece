; chords in a circle: from each of n points k to the point m × k
(import ease linear)
(int n 160 (>= 12) (<= 240))
(real m 2 (>= 2) (<= 12))  ; typechecked: m stays in 2 to 12
(func spot ((real k)) (polar 1 (turn (/ k n))))

; what the figure is
(scene chords
  (circle rim (r 1) (fill none) (stroke #'gray'))
  (foreach k n
    (line_ (from (spot k)) (to (spot (* m k)))
           ; what the figure looks like
           (stroke (mix #'crimson' #'royalblue' (min 1 (/ k n))))
           (stroke-opacity 0.5))))

; what it does: the play moves m, and the reader moves n
(canvas v chords)
(play film (label 'play the times tables')
  (animation (set m 2)
    (move m (to 12) (duration 30) (ease linear))))

; accessible and interactive: mouse, touch or keyboard
(slider points (move n (from 12) (to 240))
  (label 'points'))
