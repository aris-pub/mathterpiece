; chords in a circle: from each point k to the point m × k
(int n 200 (const))
(real m 1 (>= 1) (<= 12))  ; typechecked: m stays in 1 to 12
(func spot ((real k)) (polar 1 (turn (/ k n))))

; what the figure is
(scene chords
  (circle rim (r 1) (fill none) (stroke 'gray'))
  (foreach k n
    (line_ (from (spot k)) (to (spot (* m k)))
           ; what the figure looks like
           (stroke (mix 'crimson' 'royalblue' (/ k n)))
           (stroke-opacity 0.5))))

; what it does
(animation sweep (loop)
  (move m (from 1) (to 12) (duration 40))
  (move m (from 12) (to 1) (duration 40)))
(canvas v (x -1.1) (y -1.1) (width 2.2) (height 2.2) chords
  (on-ready (animation sweep)))

; accessible and interactive: mouse, touch or keyboard
(slider times (move m (from 1) (to 12))
  (label 'multiplier m'))
(button again (label 'play') (animation sweep))
