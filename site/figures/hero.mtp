; a chord from point k to point m × k, for 200 points
(real m 2 (>= 1) (<= 12))
(func spot ((real k)) (polar 1 (turn (/ k 200))))
(scene s
  (circle rim (r 1) (fill none) (stroke 'gray'))
  (foreach k 200
    (line_ (from (spot k)) (to (spot (* m k)))
           (stroke (mix 'crimson' 'royalblue' (/ k 200)))
           (stroke-opacity 0.5))))
(canvas v (x -1.1) (y -1.1) (width 2.2) (height 2.2) s
  (on-ready
    (animation (loop) (move m (to 12) (duration 40))
                      (move m (to 1) (duration 40)))))
(slider times (move m (from 1) (to 12)) (label 'multiplier m'))
