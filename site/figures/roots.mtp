; the roots of x² + k
(real k -1 (>= -2) (<= 2))
(real|none r (sqrt (- k)))
(scene graph
  (line_ (from [-2 0]) (to [2 0]) (stroke 'gray'))
  (parametric curve (for t -2 2) [t (+ (* t t) k)]
    (stroke 'slateblue') (stroke-width 2))
  (circle|none lo (r 0.1) (pos [(- r) 0]) (fill 'crimson'))
  (circle|none hi (r 0.1) (pos [r 0]) (fill 'crimson')))
(canvas c (x -2) (y -2.2) (width 4) (height 3.4) graph)
(slider shift (move k (from -2) (to 2)) (label 'k'))
