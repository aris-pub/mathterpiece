(real k -1 (>= -1) (<= 1))
(real|none r (sqrt (- k)))
(scene parabola
  (line_ (from [-2 0]) (to [2 0]) (stroke #'gray'))
  (parametric p (for t -2 2) [t (+ (* t t) k)] (stroke #'teal'))
  (circle|none lo (r 0.1) (pos [(- r) 0]) (fill #'crimson'))
  (circle|none hi (r 0.1) (pos [r 0]) (fill #'crimson')))
(canvas c parabola)
(slider shift (animation (move k (from -1) (to 1))) (label 'k'))
(readout says (or? f'roots at ±{r:.2f}' 'no real roots'))
