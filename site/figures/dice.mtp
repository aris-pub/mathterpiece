; two dice, drawn from one motif, rolled at random
(import rand)

; what the figure is: a die, declared once and used twice
(motif die ((int face 1 (>= 1) (<= 6)))
  (rect body (width 2) (height 2) (rx 0.3)
        ; what the figure looks like
        (fill '#ad71f2') (fill-opacity 0.15)
        (stroke '#ad71f2'))
  (group pips (defaults (fill '#ad71f2'))
    (circle_ (r 0.18) (opacity (if (= (mod face 2) 1) 1 0)))
    (foreach p [[-0.55 0.55] [0.55 -0.55]]
      (circle_ (pos p) (r 0.18)
               (opacity (if (>= face 2) 1 0))))
    (foreach p [[0.55 0.55] [-0.55 -0.55]]
      (circle_ (pos p) (r 0.18)
               (opacity (if (>= face 4) 1 0))))
    (foreach p [[-0.55 0] [0.55 0]]
      (circle_ (pos p) (r 0.18)
               (opacity (if (= face 6) 1 0))))))

; typechecked: (rand-int 1 6) always fits a face
(scene table
  (die left (face (rand-int 1 6)) (translate [-1.3 0]))
  (die right (face (rand-int 1 6)) (translate [1.3 0])))

; what it does
(canvas v (x -2.6) (y -1.4) (width 5.2) (height 2.8) table)
(button roll (animation (roll-dice)) (label 'roll the dice'))
