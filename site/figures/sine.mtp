; one angle, two views: the point on the circle,
; and the sine wave that its height traces
(import ease linear)
(real theta 0 (wrap 0 360))
(point p (polar 1 theta))
(func x-of ((real t)) (+ 1.6 (/ t 90)))

; what the figure is
(scene waves
  ; what the figure looks like
  (circle rim (r 1) (fill none) (stroke 'gray'))
  (parametric wave (for t 0 360) [(x-of t) (sind t)] (stroke 'gray'))
  (line rise (from [p.x 0]) (to p) (stroke 'crimson') (stroke-width 3))
  (circle dot (r 0.08) (pos p) (fill 'crimson'))
  (circle trace (r 0.08) (pos [(x-of theta) p.y]) (fill 'crimson')))

; what it does: the angle turns, or drag either dot
(animation spin (loop)
  (move theta (from 0) (to 360) (duration 8) (ease linear)))
(canvas wheel (x -1.2) (y -1.2) (width 2.4) (height 2.4) waves
  (on-ready (animation spin))
  (on-drag dot (move theta (to (. (or? (to-polar pointer) [1 0]) 1)))))
(canvas graph (x 1.4) (y -1.2) (width 4.4) (height 2.4) waves
  (on-drag trace (move theta (to (* 90 (- pointer.x 1.6))))))
