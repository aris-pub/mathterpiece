(real entered 0)
(real left 0)
(real into-g 0)
(point p [0 0])
(scene s
  (circle a (pos [0 0]) (r 1))
  (group g (circle b (pos [5 0]) (r 1)))
  (circle c (pos [-5 0]) (r 1))
  (circle through (pos [0 5]) (r 1) (pointer-events false))
  (group outer (transform (transform (scale 2)))
    (group h (circle e (pos [0 -3]) (r 0.5)))))
(canvas v s)
(on-enter a (animation (move entered (to (+ entered 1)) (duration 0))))
(on-leave a (animation (move left (to (+ left 1)) (duration 0))))
(on-enter g (animation (move into-g (to (+ into-g 1)) (duration 0))))
(on-pointermove b p)
(on-pointermove v c.pos (<= c.x 2))
(on-pointermove v h.translate)
