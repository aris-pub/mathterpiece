; A stepper: the reader moves through the animation's steps one at a time (the author,
; 2026-11-10).
(real a 0 (>= 0) (<= 1))
(real b 0 (>= 0) (<= 1))
(real k 0 (>= 0) (<= 10))
(bool on true)
(stepper hints (label 'hints') (active on)
  (animation
    (at-once (move a (to 1) (duration 0)) (move b (to 1) (duration 0.4)))
    (move k (to 2) (duration 1))
    (move k (to 6) (duration 2))))
(play tour (animation (move k (to 9) (duration 1))))
(bool past (> hints.step 1))
; Moves that take no time at the edges of steps: the end of the first and the start of the second.
(stepper edges
  (animation
    (in-order (move k (to 2) (duration 1)) (move a (to 1) (duration 0)))
    (in-order (move b (to 1) (duration 0)) (move k (to 4) (duration 1)))))
