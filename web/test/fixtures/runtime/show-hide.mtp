; on-show and on-hide (mtp-7i3j): a canvas draws a stand-in while each plays.
(choreo fade-in ((shape who) (real seconds 1))
  (at-once (move who.drawn (to 1) (duration 0)) (move who.opacity (to 1) (duration seconds))))
(choreo fade-out ((shape who) (real seconds 1))
  (in-order (move who.opacity (to 0) (duration seconds)) (move who.drawn (to 0) (duration 0))))
(choreo draw-on ((shape who) (real seconds 1))
  (at-once (move who.opacity (to 1) (duration 0)) (move who.drawn (to 1) (duration seconds))))
(choreo draw-off ((shape who) (real seconds 1))
  (in-order (move who.drawn (to 0) (duration seconds)) (move who.opacity (to 0) (duration 0))))
(bool show false)
(bool there true)
(real k 0)
(real j 0)
(bool lit false)
(bool later false)
(scene s
  (circle c (r 2) (stroke '#000000') (fill none))
  (text label 'hi' (fill '#ff0000'))
  (circle|none gone (r 1) (x 3) (fill '#00ff00') (stroke '#000000'))
  (exists-when gone there)
  (circle slid (r 1) (x k) (stroke '#000000'))
  (circle plain (r 1) (y 3))
  (group pair (circle left (x -1)) (circle right (x 1)))
  (circle glow (r 1) (y -3))
  (circle dot (r 1) (y 5)))
(canvas v (toggle-duration 1)
  (when show c) label (when show plain)
  (on-show c (draw-on c))
  (on-hide c (draw-off c))
  (on-show label (fade-in label)))
(canvas w label (on-show label (fade-in label 2)))
(canvas vanish gone
  (on-hide gone (animation (in-order (move gone.opacity (to 0) (duration 1)) (move gone.drawn (to 0) (duration 0))))))
(canvas slide (when show slid)
  (on-show slid (animation (at-once (fade-in slid) (move slid.x (from -4) (duration 1))))))
(canvas pairs (when show pair)
  (on-show pair (fade-in pair))
  (on-show right (fade-in right 2)))
(canvas tint (when show c)
  (on-show c (animation (at-once (draw-on c 0) (move c.stroke (from '#ff0000') (duration 1))))))
(slider ks (move k (from 0) (to 10)))
(canvas opening label (when lit glow)
  (on-show label (fade-in label 2))
  (on-show glow (fade-in glow 2))
  (on-view (animation (in-order (move j (to 1) (duration 1)) (move lit (to true) (duration 0))))))
(canvas later-on (when later dot)
  (on-show dot (fade-in dot 1))
  (on-ready (animation (move later (to true) (duration 0)))))
