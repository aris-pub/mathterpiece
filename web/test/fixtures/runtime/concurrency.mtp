; Writers moving the same targets at the same time (reference.md, "Concurrency").
(real k 0)
(real j 0)
(scene s
  (circle d (pos [0 0]) (r 1))
  (circle e (pos [5 5]) (r 1))
  (group g (circle c1 (r 1)) (circle c2 (r 1)))
  ; Shapes whose position is worked out from other attributes, so writing x, y or pos writes
  ; those (mtp-gzs9).
  (polyline pl (points [[0 0] [0 2]]))
  (polygon pg (points [[0 0] [2 0] [2 2]]))
  (curve cv (from [0 0]) (to [2 0]) (controls [[1 1]]))
  (line ln (from [0 0]) (to [2 0]))
  (triangle tr (a [0 0]) (b [3 0]) (c [3 3])))
(button go (animation (move k (to 10) (duration 1))))
(button back (animation (move k (to 0) (duration 1))))
(button lock (animation (move k (to 10) (duration 1))) (priority 900))
(button both (animation (at-once (move k (to 0) (duration 1)) (move j (to 5) (duration 1)))))
(button other (animation (move j (to 5) (duration 1))))
(button grow (animation (move g.r (to 3) (duration 1))))
(button grow-one (animation (move c1.r (to 2) (duration 1))))
(button hold-one (animation (move c1.r (to 2) (duration 1))) (priority 900))
(play tour (animation (move k (to 10) (duration 2))))
(slider sl (move k (from 0) (to 10)))
; Its on-view is not the reader's doing.
(canvas v s
  (on-view (animation (move k (to 4) (duration 1)))))
(canvas z s)
; Another on-view on k, for one writer the reader did not set off meeting another.
(canvas late s
  (on-view (animation (move k (to 3) (duration 1)))))
(canvas w s
  (on-drag d d.pos)
  (on-enter e (animation (move d.x (to 3) (duration 1)))))
(canvas held s
  (on-drag d d.pos (priority 900))
  (on-enter e (animation (move d.x (to 3) (duration 1)))))
; An on-view on what w drags, in a canvas of its own: until a canvas is ready the listeners in it
; hear nothing (docs/canvas-lifecycle.md).
(canvas viewed s
  (on-view (animation (move d.x (to 8) (duration 1)))))
; Writers of a high priority whose writes take no time.
(point p [0 0])
(slider locked (move k (from 0) (to 10)) (priority 900))
(button jump (animation (move p (to [1 1]) (duration 1))))
(canvas pm s
  (on-pointermove p))
(button pl-x (animation (move pl.x (to 5) (duration 1))) (priority 900))
(button pl-points (animation (move pl.points (to [[0 0] [2 0]]) (duration 1))) (priority 900))
(button pl-y (animation (move pl.y (to 5) (duration 1))) (priority 900))
; A play moving what the canvas w drags, for a grab that changes nothing (the author, 2026-11-12).
(play roll (animation (move d.x (to 8) (duration 2))))
