(real inner 0)
(real outer 0)
(real top 0)
(real r-in 0)
(real r-out 0)
(point p [0 0])
(point q [0 0])
(scene s
  (group g
    (circle c (pos [0 0]) (r 1))
    (circle d (pos [5 0]) (r 1))))
(canvas v s
  (on-click c (animation (move inner (to (+ inner 1)) (duration 0))))
  (on-click g (animation (move outer (to (+ outer 1)) (duration 0))))
  (on-click d (stop-propagation true) (animation (move top (to (+ top 1)) (duration 0))))
  (on-release c (animation (move r-in (to (+ r-in 1)) (duration 0))))
  (on-release g (animation (move r-out (to (+ r-out 1)) (duration 0))))
  (on-pointermove d p (stop-propagation true))
  (on-pointermove q))
