(real k 1)
(int n 5)
(func twice ((real x)) (* 2 x))
(func scaled ((real x)) (* k x))
(func fact ((int n)) (if (<= n 1) 1 (* n (fact (- n 1)))))
(func uses-scaled ((real x)) (+ 1 (scaled x)))
(func[real] first-x ((list[point] ps)) (or? ps[0].x 0))
(real a (twice k))
(real b (scaled 3))
(int e (fact n))
(real g (uses-scaled 2))
(real h (first-x [[k 1]]))
