; mtp-5opl: on-dragstart plays when a drag of the shape starts, before the drag's first write.
; Dragging p first resets the offset o, then writes y, which reads o.
(real o 3)
(real y 0)
(real up 0)
(real stopped 0)
(real off 0)
(scene s
  (group g
    (circle p (pos [0 0]) (r 1))
    (circle q (pos [5 0]) (r 1)))
  (circle r (pos [-5 0]) (r 1)))
(canvas v s)
(on-drag p (move y (to (+ pointer.y o))))
(on-dragstart p (animation (move o (to 0) (duration 0))))
(on-dragstart g (animation (move up (to 1) (duration 0))))
(on-drag q q.pos)
(on-dragstart q (stop-propagation true) (animation (move stopped (to 1) (duration 0))))
(on-drag r r.pos)
(on-dragstart r (active false) (animation (move off (to 1) (duration 0))))
