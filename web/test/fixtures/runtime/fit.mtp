; Canvases that give no view box show the box of their shapes as first drawn, with a margin of
; 5% of the box's larger side on each side, and keep that box (the author, 2026-11-16).
(real k 0)
(bool on false)
(bool here true)
(scene s
  ; From [0 0] to [4 4], and from [6 0] to [10 2]: the box from [0 0] to [10 4].
  (circle c (pos [2 2]) (r 2))
  (rect r (pos [8 1]) (width 4) (height 2))
  (line flat (from [0 0]) (to [10 0]))
  (circle dot (pos [3 4]) (r 0))
  (circle moving (pos [k 0]) (r 5))
  (circle far (pos [100 100]) (r 1))
  (circle|none gone (pos [-100 0]) (r 1))
  (exists-when gone (not here))
  (text label 'hi' (pos [10 2]))
  (group handle (translate [10 4]) (fixed-size true) (circle_ (r 40)))
  (group window (clip (rect_ (pos [5 2]) (width 10) (height 4)))
    (circle big (pos [5 2]) (r 50))))
(canvas two c r)
(canvas line flat)
(canvas point dot)
(canvas empty (when on far))
(canvas fixed moving)
(canvas later c (when on far))
(canvas absent c gone)
(canvas text c label)
(canvas handled c handle)
(canvas clipped window)
(canvas turned (transform (rotate 90)) c r)
(canvas zooms c r (on-drag c c.pos))
