; Each vertex is drawn as high as its part is large, read through its own group: a vertex moves
; when another vertex leaves or joins its part, one declared after it too (mtp-mnvd).

(motif vertex ((int part 0)) (circle_ (r 10)))

(scene s
  (group verts
    (foreach i 3
      (vertex #'v-{i}' (part free@0)
        (pos [0 (count (range 3) (fn j (= (or? verts[j].part 0) (or? verts[i].part 0))))])))))

(canvas view (x -50) (y -50) (width 100) (height 100) s)
