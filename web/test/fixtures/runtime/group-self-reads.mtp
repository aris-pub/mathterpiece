; Each vertex of verts is drawn as high as its part is large. The parts are in a list variable,
; each vertex bound to its own item, since a vertex never reads its group whole (mtp-gvrf.16): a
; vertex moves when another vertex leaves or joins its part, one declared after it too (mtp-mnvd).
; Each vertex of others is drawn as high as the part of the vertex before it, read through the
; group by a position known when compiling: a vertex moves when that part changes.

(motif vertex ((int part 0)) (circle_ (r 10)))

(list[int] parts [0 0 0] (length 3))

(scene s
  (group verts
    (foreach i 3
      (vertex #'v-{i}' (part parts[i]) (pos [0 (count parts (fn q (= q parts[i])))]))))
  (group others
    (foreach i 3
      (vertex #'w-{i}' (part free@0) (pos [20 (if (> i 0) others[(- i 1)].part 0)])))))

(canvas view (x -50) (y -50) (width 100) (height 100) s)
