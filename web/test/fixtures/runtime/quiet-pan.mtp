; Quiet mode and pan and zoom (mtp-16z): roam pans and zooms, but only while it is live, and
; plain, with no on-live, pans and zooms always.
(real k 0)
(scene s (circle c (r 1)))
(canvas roam (x -10) (y -10) (width 20) (height 20) s
  (on-live (animation (move k (to 1) (duration 0)))))
(canvas plain (x -10) (y -10) (width 20) (height 20) s)
