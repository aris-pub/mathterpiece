(real d 0.5 (>= 0) (<= 1))
(scene s
  (line l (to [4 0]) (stroke 'black') (drawn d) (head-end 'dart') (head-start 'bar'))
  (circle c (r 2) (fill 'red') (stroke 'black') (drawn d))
  (circle dashed (r 2) (fill none) (stroke 'black') (dash [4 2] 1) (drawn d))
  (circle faded (r 2) (stroke 'black') (opacity 0.5) (drawn d))
  (circle bare (r 2) (drawn d))
  (ellipse e (rx 2) (ry 1) (stroke 'black') (drawn d))
  (rect r (width 4) (height 2) (stroke 'black') (drawn d))
  (rect rounded (width 4) (height 2) (rx 1) (ry 1) (stroke 'black') (drawn d))
  (triangle t (a [0 0]) (b [3 0]) (c [3 4]) (stroke 'black') (drawn d))
  (polyline p (points [[0 0] [1 0] [1 3]]) (stroke 'black') (drawn d) (head-end 'dart'))
  (polygon g (points [[0 0] [2 0] [2 2] [0 2]]) (stroke 'black') (drawn d))
  (curve q (from [0 0]) (to [2 0]) (controls [[1 1]]) (stroke 'black') (drawn d))
  (arc a (r 2) (from 90) (to 270) (stroke 'black') (drawn d) (head-end 'dart'))
  (ring annulus (r 2) (width 1) (stroke 'black') (drawn d))
  (ring sector (r 2) (width 1) (to 90) (stroke 'black') (drawn d))
  (text tx 'hi' (stroke 'black') (drawn d))
  (line moved (to [4 0]) (stroke 'black') (drawn 0)))
(animation on (move moved.drawn (to 1) (duration 1)))
(canvas v (x -5) (y -5) (width 10) (height 10) s)
