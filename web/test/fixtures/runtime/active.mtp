(real k 0 (>= 0) (<= 10))
(bool on false)
(button go (animation (move k (to 5) (duration 1))) (active (< k 3)))
(slider sl (move k (from 0) (to 10)) (active (< k 3)))
(play run (animation (move k (to 2) (duration 1)) (move k (to 4) (duration 1))) (buttons true) (active (< k 3)))
(toggle t on (active (< k 3)))
