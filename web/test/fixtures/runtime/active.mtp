(real k 0 (>= 0) (<= 10))
(bool on false)
(button go (animation (transit _ k (to 5) (duration 1))) (when (< k 3)))
(slider sl (transit _ k (from 0) (to 10)) (when (< k 3)))
(play run (animation (transit _ k (to 2) (duration 1)) (transit _ k (to 4) (duration 1))) (buttons true) (when (< k 3)))
(toggle t (target on) (when (< k 3)))
