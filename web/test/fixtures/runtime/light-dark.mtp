(color ink (light-dark '#1f2a44' '#e8e4d8'))
(color paper '#ffffff')
(real t 0.5 (>= 0) (<= 1))
(bool b true)
(color live (mix (light-dark '#000000' '#ffffff') '#ff0000' t))
(real channel (let ((c (mix (light-dark '#000000' '#ffffff') '#ff0000' t))) c.g))
(bool matches (= (mix (light-dark '#000000' '#ffffff') '#ff0000' t) (light-dark '#800000' '#ff8080')))
(scene s
  (circle plain (fill (light-dark '#999999' '#5a5f6b')))
  (circle tok (fill ink))
  (circle mixed (fill (mix ink paper t)))
  (circle picked (fill (light-dark (if b 'red' 'blue') ink)))
  (circle moved (fill '#000000'))
  (text label (let ((c (lighten (light-dark '#000000' '#808080') t))) $'{c}')))
(animation fade (move moved.fill (to (light-dark '#ffffff' '#000000')) (duration 1)))
(canvas v s)
