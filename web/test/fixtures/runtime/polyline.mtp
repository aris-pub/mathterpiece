(real k 1)
(scene s
  (polyline p (points [[0 0] [4 0] [4 2]]) (stroke 'black'))
  (polygon q (points [[0 0] [4 0] [4 2]]) (fill 'red'))
  (polyline bendy (points [[0 0] [k 1]]))
  (polyline empty)
  (circle c (pos (top-right q)) (r 0.1))
