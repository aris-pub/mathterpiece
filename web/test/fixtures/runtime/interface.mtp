(interface palette (color ink) (color paper) (real gap (>= 0)))
(namespace day (color ink '#1f2a44') (color paper '#f6f1e7') (real gap 0.4 (>= 0)))
(namespace night (color ink '#e8e4d8') (color paper '#14161c') (real gap 1 (>= 0)))
(bool dark false)
(palette look (if dark night day))
(scene s
  (circle c (r look.gap) (fill look.ink)))
(canvas v s)
(toggle t dark)
