; How shapes are drawn as SVG: a circle with a fill, a stroke and a stroke width, a rect inside
; a translated group with a token color, a centered text, and a circle|none with r = 1/k. With
; k at 0 that radius is none, so the last circle is absent and not drawn.

(real k 0)
(color ink 'navy')
(scene s (background 'white')
  (circle c (x 1) (y 2) (r 3) (fill 'red') (stroke 'blue') (stroke-width 2))
  (group g (translate [5 0]) (rect b (width 2) (height 4) (fill ink)))
  (text t 'hi' (halign 'middle'))
  (circle|none gone (r (/ 1 k))))
(canvas v s (view-x -3) (view-y -3) (view-width 6) (view-height 6))
