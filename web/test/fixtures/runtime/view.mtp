(scene s (text label 'hi' (pos [0 3])) (circle c (r 1)) (circle dot (pos [5 5]) (r 1)))
(canvas v (x -10) (y -10) (width 20) (height 20) s
  (on-drag dot dot.pos))
(canvas fixed (x -10) (y -10) (width 20) (height 20) (pan false) (zoom false) s
  (on-drag dot dot.pos))
(canvas bounded (x -10) (y -10) (width 20) (height 20) (zoom 1 4) s
  (on-drag dot dot.pos))
; Zooms out to twice the view box, and in to 4 times closer.
(canvas wide (x -10) (y -10) (width 20) (height 20) (zoom 0.5 4) s
  (on-drag dot dot.pos))
