(import ease cubic-in)

(real k 0 (>= 0) (<= 10))
(real j 0)
(bool on false)
(motif pair ((real u 0)) (group inner (circle p (fill 'black')) (circle q (fill 'black'))))
(scene s (circle dot (fill 'black')) (pair duo))
(animation a
  (move k (to 10) (duration 2))
  (move none (duration 1))
  (move j (from 1) (to 3) (duration 1) (ease cubic-in)))
(animation flip (move on (to true) (duration 1)))
(animation late (move on (to true) (duration 1) (ease (step-ease 1))))
(animation jumps (move k (to 4) (duration 1) (ease (step 4))))
(animation fade (move dot.fill (to 'white') (duration 1)))
(animation both (at-once (move k (to 10) (duration 2)) (move j (to 5) (duration 1))))
(animation slide (move dot.pos (to [3 1]) (duration 1)))
(animation thrice (loop 3) (move k (from 0) (to 10) (duration 1)))
(animation forever (loop) (move j (to (+ j 1)) (duration 1)))
(animation rounds (loop) (move k (from 0) (to 2) (duration 1)) (move k (to 4) (duration 1)))
(animation recolor (move duo.fill (to 'white') (duration 1)))
(animation outback (loop) (at-once (move k (to 10) (duration 1))) (in-order (move k (to 0) (duration 1))))
(animation stops (in-order (move k (to 2) (duration 2.5)) (wait 1.2)) (in-order (move k (to 3) (duration 2)) (wait 1.2)) (in-order (move k (to 5) (duration 2.5)) (wait 1.2)) (move k (to 9) (duration 3)))
; Each move reads its ends at the instant it starts (mtp-lm24): moves that start together read
; the same values, so these swap.
(real left 1)
(real right 2)
(animation swap (at-once (move left (to right) (duration 0)) (move right (to left) (duration 0))))
(animation swaps (loop 3) (at-once (move left (to right) (duration 0.5)) (move right (to left) (duration 0.5))))
(animation chain (move left (to 5) (duration 1)) (move right (to left) (duration 1)))
(animation instant-chain (in-order (move left (to 5) (duration 0)) (move right (to left) (duration 0))))
