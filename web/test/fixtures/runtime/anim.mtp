(real k 0 (>= 0) (<= 10))
(real j 0)
(bool on false)
(scene s (circle dot (fill 'black')))
(animation a
  (k (to 10) (duration 2))
  (wait 1)
  (j (from 1) (to 3) (duration 1) (ease 'ease-in')))
(animation flip (on (to true) (duration 1)))
(animation late (on (to true) (duration 1) (ease (step-ease 1))))
(animation jumps (k (to 4) (duration 1) (ease (step 4))))
(animation fade (dot.fill (to 'white') (duration 1)))
(animation both (at-once (k (to 10) (duration 2)) (j (to 5) (duration 1))))
(animation slide (dot.pos (to [3 1]) (duration 1)))
