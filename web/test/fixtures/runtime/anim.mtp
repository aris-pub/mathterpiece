(real k 0 (>= 0) (<= 10))
(real j 0)
(bool on false)
(scene s (circle dot (fill 'black')))
(animation a
  (move k (to 10) (duration 2))
  (move none (duration 1))
  (move j (from 1) (to 3) (duration 1) (ease 'ease-in')))
(animation flip (move on (to true) (duration 1)))
(animation late (move on (to true) (duration 1) (ease (step-ease 1))))
(animation jumps (move k (to 4) (duration 1) (ease (step 4))))
(animation fade (move dot.fill (to 'white') (duration 1)))
(animation both (at-once (move k (to 10) (duration 2)) (move j (to 5) (duration 1))))
(animation slide (move dot.pos (to [3 1]) (duration 1)))
