(real k 0 (>= 0) (<= 10))
(real j 0)
(bool on false)
(scene s (circle dot (fill 'black')))
(animation a
  (transit _ k (to 10) (duration 2))
  (transit _ none (duration 1))
  (transit _ j (from 1) (to 3) (duration 1) (ease 'ease-in')))
(animation flip (transit _ on (to true) (duration 1)))
(animation late (transit _ on (to true) (duration 1) (ease (step-ease 1))))
(animation jumps (transit _ k (to 4) (duration 1) (ease (step 4))))
(animation fade (transit _ dot.fill (to 'white') (duration 1)))
(animation both (at-once (transit _ k (to 10) (duration 2)) (transit _ j (to 5) (duration 1))))
(animation slide (transit _ dot.pos (to [3 1]) (duration 1)))
