(real k 0 (>= 0) (<= 10))
(point start [1 0])
(point corner [1 0])
(int steps 0 (>= 0) (<= 5))
(real top 10 (>= 0) (<= 10))
(bool on false)
(motif lamp (bool lit false) (circle c (r 1)))
(scene s
  (circle dot (pos [1 1]) (r 1))
  (circle orbit (pos (polar 2 k)))
  (group lamps (lamp_) (lamp_ (lit true)))
  (group pair (circle p1 (pos [0 0])) (circle p2 (pos [1 0])))
  (circle limited (pos [0 0]))
  (circle boxed (pos [0 0]))
  (circle stepper (pos [steps 0]))
  (circle edge (pos [top 5]))
  ; A handle drawn turned a quarter, its position a global point: the pointer reaches the move in
  ; the turned frame, so (to pointer) puts the handle under it.
  (group turned (transform (rotate 90))
    (circle handle (pos start))
    (group grip (fixed-size true) (translate corner) (circle_ (r 6)))))
(slider sl (move k (from 0) (to 10)) (label 'k'))
(slider told (move k (from 0) (to 10)) (label $'k = {k:.0f}'))
(button set (label $'set {k:.0f}') (animation (move k (to 5) (duration 0))))
(toggle said on (label $'on with k = {k:.0f}'))
(button go (animation (move k (to 5) (duration 1))))
(play run (animation (move k (to 2) (duration 1)) (move k (to 4) (duration 1))) (buttons true))
; One of a row choosing a value, which says whether it is the current one.
(button five (animation (move k (to 5) (duration 0))) (selected (= k 5)))
(toggle own none)
(toggle t on)
(toggle all lamps.lit)
(readout r $'k = {k:.1f}')
(canvas v s)
(on-drag dot dot.pos)
(on-drag orbit (move k (to (let ((q (or? (to-polar pointer) [2 0]))) q[1]))))
(on-drag pair pair.pos)
(on-drag limited limited.x (<= limited.x 2))
(on-drag boxed boxed.pos (<= boxed.x 2) (>= boxed.pos[1] -1) (<= boxed.pos.y 3))
(on-drag stepper (move steps (to (round pointer.x))))
(on-drag edge (move top (to pointer.x)))
(on-drag handle (move start (to pointer)))
(on-drag grip (move corner (to pointer)))
(on-click orbit (animation (move on (to true) (duration 0))))
