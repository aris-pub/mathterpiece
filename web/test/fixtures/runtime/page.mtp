; The page the element tests use: one of each control on one variable, k from 0 to 10. Try:
; move the slider; press the button (k moves to 5); press play (k moves to 2, then to 4), or
; press 1 or 2 to run that top-level step alone; tick the toggles (the last one shows a mixed
; state, because one lamp is lit); drag the points, the orbit (it writes k) and the limited
; circle (its x stops at 2); click the orbit.

(real k 0 (>= 0) (<= 10))
(bool on false)
(motif lamp (bool lit false) (circle c (r 1)))
(scene s
  (circle dot (pos [1 1]) (r 1))
  (circle orbit (pos (polar 2 k)))
  (group lamps (lamp _) (lamp _ (lit true)))
  (group pair (circle p1 (pos [0 0])) (circle p2 (pos [1 0])))
  (circle limited (pos [0 0])))
(slider sl (animation (k (transition (from 0) (to 10) (duration 1)))) (label 'k'))
(button go (animation (k (transition (to 5) (duration 1)))))
(play run (animation (k (transition (to 2) (duration 1))) (k (transition (to 4) (duration 1)))) (buttons true))
(toggle own)
(toggle t (target on))
(toggle all (target lamps.lit))
(readout r $'k = {k:.1f}')
(canvas v s)
(on-drag dot (target dot.pos))
(on-drag orbit (target k))
(on-drag pair (target pair.pos))
(on-drag limited (target limited.x) (<= limited.x 2))
(on-click orbit (animation (on (transition (to true) (duration 0)))))
