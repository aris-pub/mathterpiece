(real k 0)
(real r 0)
(real e 0)
(real g 0)
(real c 0)
(scene s (circle a (pos [0 0]) (r 1)) (circle b (pos [5 0]) (r 1)) (circle d (pos [-5 0]) (r 1))
  (group pair (circle p1 (pos [0 5]) (r 1)) (circle p2 (pos [3 5]) (r 1))))
(canvas v s
  (on-click a (animation (move k (to 1) (duration 0))))
  (on-release b (animation (move r (to 1) (duration 0))))
  (on-drag d d.pos)
  (on-dragend d (animation (move e (to 1) (duration 0))))
  (on-click pair (animation (move g (to 1) (duration 0))))
  (on-click d (animation (move c (to 1) (duration 0)))))
