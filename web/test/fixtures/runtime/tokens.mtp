(color ink 'navy')
(color paper 'white')
(bool on true)
(int pick 0 (>= 0) (<= 2))
(real t 0.25 (>= 0) (<= 1))
(motif tag ((color mark 'red')) (circle dot (fill mark)))
(scene s
  (circle mixed (fill (mix ink paper 0.25)))
  (circle lighter (fill (lighten ink t)))
  (circle darker (fill (darken ink 0.5)))
  (circle chosen (fill (if on ink paper)))
  (circle picked (fill (cond ((= pick 0) ink) ((= pick 1) 'red') (else paper))))
  (circle plain (fill (if on 'red' 'blue')))
  (tag tagged (mark ink))
  (circle direct (fill ink)))
(canvas v s)
