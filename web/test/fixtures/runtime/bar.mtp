; A play's bar: one bar per step, as wide as its duration, and the step now playing under it.
(real k 0 (>= 0) (<= 10))
(play tour (buttons true) (label 'play the tour')
  (animation
    (step 'Grow' (move k (to 2) (duration 1)))
    (step (move k (to 4) (duration 3)))))
(play whole (animation (move k (to 2) (duration 1)) (move k (to 4) (duration 1))))
(button go (animation (move k (to 9) (duration 1))))
