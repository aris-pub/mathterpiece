; Touch (docs/reference.md, "Touch screens"): a band that hears the pointer, as in the replicas,
; a second shape to tap away to, a shape dragged along a clamped variable, one dragged by its own
; position, and one with both a click and a drag. The view box is 20 units each way about 0.
(bool over false)
(int enters 0)
(int leaves 0)
(bool on-other false)
(point p [0 0])
(real k 0 (>= -8) (<= 8))
(int clicked 0)
(int ended 0)
(int started 0)
(scene s
  (rect band (pos [0 -6]) (width 16) (height 2) (fill '#ffffff') (fill-opacity 0) (stroke none))
  (rect other (pos [6 0]) (width 2) (height 2))
  (circle knob (pos [k 4]) (r 0.5))
  (circle dot (pos [-6 0]) (r 0.5))
  (circle both (pos [0 8]) (r 0.5)))
(canvas v (x -10) (y -10) (width 20) (height 20) (pan false) (zoom false) s
  (on-pointermove band p)
  (on-enter band (animation (move over (to true) (duration 0)) (move enters (to (+ enters 1)) (duration 0))))
  (on-leave band (animation (move over (to false) (duration 0)) (move leaves (to (+ leaves 1)) (duration 0))))
  (on-enter other (animation (move on-other (to true) (duration 0))))
  (on-leave other (animation (move on-other (to false) (duration 0))))
  (on-drag knob (move k (to pointer.x)))
  (on-drag dot dot.pos (<= dot.x -3))
  (on-dragend dot (animation (move ended (to (+ ended 1)) (duration 0))))
  (on-dragstart dot (animation (move started (to (+ started 1)) (duration 0))))
  (on-drag both both.pos)
  (on-click both (animation (move clicked (to (+ clicked 1)) (duration 0)))))
