(real t 90)
(scene s
  (arc quarter (r 2) (to 90) (stroke 'black'))
  (arc back (r 2) (from 90) (to 0) (stroke 'black'))
  (arc whole (r 2) (stroke 'black'))
  (arc over (r 2) (to 400) (stroke 'black'))
  (arc none-at-all (r 2) (from 30) (to 30) (stroke 'black'))
  (arc moving (pos [1 1]) (r 2) (to t) (stroke 'black'))
  (arc slanted (r 2) (from 45) (to 135) (stroke 'black'))
  (ring band (r 2) (width 1) (to 90) (fill 'red'))
  (ring pie (r 2) (width 2) (to 90))
  (ring too-wide (r 2) (width 5) (to 90))
  (ring annulus (r 2) (width 1))
  (ring thin (r 2) (width 1) (from 30) (to 60))
  (group g (clip (ring_ (r 3) (width 1))) (circle c (r 3))))
(canvas v (x -5) (y -5) (width 10) (height 10) s)
