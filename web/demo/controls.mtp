; A tour of what the runtime does.
; Try: move the angle slider; drag the red point around the circle (it changes the angle);
; drag the blue square anywhere; press "grow the square"; press play, and its numbered buttons;
; untick "show the angle" (the label fades out); click the gold sun (the square shrinks).

(import ease cubic-in-out)

(real angle 30 (>= 0) (<= 360))
(real size 1 (>= 0.2) (<= 3))
(bool show-angle true)
(color paper (light-dark '#fbf8f1' '#14161c'))
(color red 'crimson')
(font label-font (size 16))
(scene s (background paper)
  (circle track (r 4) (fill none) (stroke '#999999'))
  (circle point (pos (polar track.r angle)) (r 0.4) (fill red))
  (line radius (from [0 0]) (to point.pos) (stroke red) (stroke-width 2))
  (rect box (pos [-5 5]) (width size) (height size) (fill 'royalblue'))
  (circle sun (pos [5 5]) (r 0.7) (fill 'gold'))
  (text label $'{angle:.0f}°' (pos [0 -1]) (halign 'middle') (font label-font)))
(slider turn (move angle (from 0) (to 360)) (label 'angle'))
(button grow
  (animation (move size (to 3) (duration 1) (ease cubic-in-out))
    (move size (to 1) (duration 1)))
  (label 'grow the square'))
(play spin (animation (defaults (duration 2)) (move angle (to 360)) (move angle (to 0)))
  (buttons true))
(toggle show show-angle (label 'show the angle'))
(readout r $'angle = {angle:.1f}°')
(canvas view (x -7) (y -7) (width 14) (height 14) (toggle-duration 0.5)
  track radius point box sun (when show-angle label)
  ; The pointer's angle around the center, from 0 to 360.
  (on-drag point (move angle (to (let ((q (or? (to-polar pointer) [0 angle]))) (mod q[1] 360)))))
  (on-drag box box.pos)
  (on-click sun (animation (move size (to 0.2) (duration 0.5)))))
